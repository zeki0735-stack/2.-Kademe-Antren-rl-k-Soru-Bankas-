color":"#887398","tint":"#ede7f1","icon":"brain","description":"Spor tarihi, sosyoloji, psikoloji, fair play, çocuk koruma ve meslek etiği.","isbn":"978-975-06-3871-8","edition":"Eylül 2020","publisher":"Anadolu Üniversitesi","fileName":"SPORDA PSİKOSOSYAL ALANLAR II - Kitap.pdf","sha256":"6c92657b807ac1932a2bcc16ae25749a1e622dfafc4d848403bb02e8806435a4","pageMap":{"2":10,"3":11,"4":12,"5":13,"6":14,"7":15,"8":16,"9":17,"10":18,"11":19,"12":20,"13":21,"14":22,"15":23,"16":24,"17":25,"18":26,"19":27,"20":28,"21":29,"22":30,"23":31,"24":32,"25":33,"26":34,"27":35,"28":36,"29":37,"30":38,"31":39,"32":40,"33":41,"34":42,"35":43,"36":44,"37":45,"38":46,"39":47,"40":48,"41":49,"42":50,"43":51,"44":52,"45":53,"46":54,"47":55,"48":56,"49":57,"50":58,"51":59,"52":60,"53":61,"54":62,"55":63,"56":64,"57":65,"58":66,"59":67,"60":68,"61":69,"62":70,"63":71,"64":72,"65":73,"66":74,"67":75,"68":76,"69":77,"70":78,"71":79,"72":80,"73":81,"74":82,"75":83,"76":84,"77":85,"78":86,"79":87,"80":88,"81":89,"82":90,"83":91,"84":92,"85":93,"86":94,"87":95,"88":96,"89":97,"90":98,"92":100,"93":101,"94":102,"95":103,"96":104,"97":105,"98":106,"99":107,"100":108,"101":109,"102":110,"103":111,"104":112,"105":113,"106":114,"107":115,"108":116,"109":117,"110":118,"111":119,"112":120,"113":121,"114":122,"115":123,"116":124,"117":125,"118":126,"119":127,"120":128,"121":129,"122":130,"123":131,"124":132,"125":133,"126":134,"127":135,"128":136,"129":137,"130":138,"131":139,"132":140,"133":141,"134":142,"135":143,"136":144,"137":145,"138":146,"139":147,"140":148,"141":149,"142":150,"143":151,"144":152,"145":153,"146":154,"147":155,"148":156,"149":157,"150":158,"151":159,"152":160,"153":161,"154":162,"155":163,"156":164,"158":166,"159":167,"160":168,"161":169,"162":170,"163":171,"164":172,"165":173,"166":174,"167":175,"168":176,"169":177,"170":178,"171":179,"172":180,"173":181,"174":182,"175":183,"176":184,"177":185}}],"questions":[{"id":"saglik-1-1","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":1,"stem":"Kolun adduktor kaslarından en kuvvetlisi aşağıdakilerden hangisidir?","options":["M. İnfraspinatus","M. Subscapularis","M. Latissimus dorsi","M. Teres major","M. Teres minör"],"answer":2,"explanation":"M. latissimus dorsi, kitapta kolun en kuvvetli adduktor kası olarak tanımlanır. Fleksiyondaki kola ekstansiyon ve iç rotasyon da yaptırır.","source":{"questionPage":35,"answerPage":36,"pages":[11],"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Kolun en kuvvetli adduktor kasıdır."},"kind":"book"},{"id":"saglik-1-2","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":2,"stem":"Aşağıdakilerden kaslardan hangisi m. quadriceps femoris kas grubunun antagonist kaslarından biri değildir?","options":["M. Semitendinosus","M. Vastus intermedius","M. Biceps femoris","M. Semimembranosus","M. Gracilis"],"answer":1,"explanation":"M. vastus intermedius, quadriceps femoris grubunun dört kasından biridir. Bu grubun bir parçası olduğu için soruda aranan antagonist kaslar arasında değildir.","source":{"questionPage":35,"answerPage":36,"pages":[22],"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bu dört kas şunlardır: m. rectus femoris, m. vastus lateralis, m. vastus medialis ve m. vastus intermedius."},"kind":"book"},{"id":"saglik-1-4","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":4,"stem":"M. Triceps brachii kasının antagonisti aşağıdakilerden hangisidir?","options":["M. Biceps brachii","M. Subscapularis","M. Pectoralis minor","M. Trapezius","M. Deltoideus (arka parça)"],"answer":0,"explanation":"Biceps brachii dirsekte fleksiyon, triceps brachii ise ekstansiyon yaptırır. Aynı eklemde karşıt hareket oluşturdukları için antagonisttirler.","source":{"questionPage":35,"answerPage":36,"pages":[14,15],"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"M. biceps brachii ve brachialis kasları seri fleksörler olarak sınıflandırılabilir"},"kind":"book"},{"id":"saglik-1-8","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":8,"stem":"Pelvis kuşağını oluşturan kemikler aşağıdakilerin hangisinde birlikte ve doğru olarak verilmiştir?","options":["Os Sacrum, Os Coxae, Os Coccyx","Os Femur, Os Sacrum, Os Tibia","Os Sacrum, Os Coxae, Os Femur","Os Coxae, Os Coccyx, Os Tibia","Os Sacrum, Os Os Coxa, Os Patella"],"answer":0,"explanation":"Pelvis kavşağını iki os coxae ile os sacrum ve os coccygis oluşturur. Femur ve tibia, bu kavşağı oluşturan kemikler listesinde yer almaz.","source":{"questionPage":35,"answerPage":36,"pages":[16],"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bu bölge, bir çift os coxae (koksa: leğen kemiği), ortada os sacrum (sakrum: kuyruk sokumu) ve os coccygis (koksiks: kuyruk) kemiklerinden meydana gelmiştir."},"kind":"book"},{"id":"saglik-1-9","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":9,"stem":"Aşağıdakilerden hangisi solunum sırasında inspirasyonun en önemli kasıdır?","options":["M. İntercostales interni","M. Subcostales","M. Obliquus externus abdominis","M. Transversus abdominis","Diyafragma"],"answer":4,"explanation":"Diyafragma, göğüs ve karın boşluklarını ayıran temel solunum kasıdır. Kitap, en önemli görevini inspirasyon olarak belirtir.","source":{"questionPage":35,"answerPage":36,"pages":[6,7],"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"İnspirasyon en önemli görevidir."},"kind":"book"},{"id":"saglik-1-10","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":10,"stem":"Aşağıdaki kaslardan hangisi talocrural ekleme (ayak bileğine) plantar fleksiyon yaptırmaz?","options":["M. Gastrocnemius","M. Soleus","M. Tibialis anterior","M. Tibialis posterior","M. Peroneus longus"],"answer":2,"explanation":"Tibialis anterior ayak bileğinde dorsifleksiyon yaptırır; bu yüzden plantar fleksiyon yaptıran kaslar arasında sayılmaz. Sorudaki olumsuz ifadeye dikkat edilmelidir.","source":{"questionPage":35,"answerPage":36,"pages":[24],"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Ayağın en kuvvetli dorsi fleksörüdür."},"kind":"book"},{"id":"saglik-2-1","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":1,"stem":"Aşağıdakilerden hangisi iskelet kasının görevlerinden biri değildir?","options":["Postürün korunması","Isı üretimi","Venöz dönüşe yardımcı olmak","Kırmızı kan hücresi üretimi","İç organların korunması"],"answer":3,"explanation":"Kitap, iskelet kasının görevleri arasında hareket, postür, organların korunması, ısı üretimi ve venöz dönüşe yardımı sayar. Kırmızı kan hücresi üretimi bu görevlerden değildir.","source":{"questionPage":55,"answerPage":56,"pages":[39],"section":"Spor Fizyolojisi II","evidence":"kas sistemi, postürün sağlanması, iç organların korunması, ısı üretimi, kanın kalbe venöz dönüşüne yardımcı olmak gibi görevleri de vardır."},"kind":"book"},{"id":"saglik-2-2","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":2,"stem":"Kalın filamentler temel olarak kasılabilir protein ………….. den, ince filamentler ise ………… den oluşmuştur.\n\nYukarıdaki cümlede boş bırakılan yerleri sırasıyla aşağıdaki terimlerden hangisi tamamlar?","options":["Aktin- miyozin","Miyozin-troponin","Aktin-troponin","Troponin-tropomiyozin","Miyozin- aktin"],"answer":4,"explanation":"Kalın filamentin temel proteini miyozin, ince filamentinki aktindir. Troponin ve tropomiyozin ise ince filamentte bulunan düzenleyici proteinlerdir.","source":{"questionPage":55,"answerPage":56,"pages":[40],"section":"Spor Fizyolojisi II","evidence":"Kalın filamentler temel olarak kasılabilir protein miyozinden, ince flamentler ise aktinden oluşmuştur."},"kind":"book"},{"id":"saglik-2-3","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":3,"stem":"Kayan filamentler teorisi ile ilgili olarak aşağıdaki ifadelerden hangisi yanlıştır?","options":["Miyofilamentler kendi boylarında bir değişiklik olmaksızın birbirleri üzerinde hareket ederek kas liflerinin boyunda kısalma veya uzamaya neden olur.","Ca++ iyonlarının sarkoplazma içerisine bırakılması için bir sinir hücresi tarafından bir uyarının gelmesi gerekir.","Kas lifi kasıldığında H bölgesi kapanır ve iki Z çizgisi birbirine doğru yaklaşır, böylelikle de sarkomerin boyu kısalır.","Miyofilamentlerin kendi boyları kısalır ve böylelikle kas liflerinin boyunda kısalma veya uzamaya neden olur.","Kas fibrilini uyaran motor nöronda bir aksiyon potansiyeli yani bir uyarı oluşturulmalıdır."],"answer":3,"explanation":"Kayan filamentler teorisinde aktin ve miyozinin kendi boyları değişmez; birbirleri üzerinde kayarlar. Bu nedenle miyofilamentlerin kısaldığını ileri süren D seçeneği yanlıştır.","source":{"questionPage":55,"answerPage":56,"pages":[40],"section":"Spor Fizyolojisi II","evidence":"Miyofilamentlerin (aktin ve miyozin) kendi boylarında bir değişiklik olmaksızın birbirlerinin üzerinden kayması kas liflerinin boyunda kısalma veya uzamaya neden olur"},"kind":"book"},{"id":"saglik-2-4","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":4,"stem":"Aşağıdakilerden hangisi Tip I (Slow –Twitch ST) kas liflerin özelliklerinden biri değildir?","options":["Yavaş kasılır.","Çabuk yorulur.","Düşük PC deposuna sahiptir.","Yüksek mitokondri yoğunluğuna sahiptir.","Düşük kuvvet üretir."],"answer":1,"explanation":"Tip I (ST) lifleri yavaş kasılır ve geç yorulur; uzun süreli aerobik dayanıklılık etkinliklerine uygundur. Dolayısıyla 'çabuk yorulur' ifadesi bu liflerin özelliği değildir.","source":{"questionPage":55,"answerPage":56,"pages":[42],"section":"Spor Fizyolojisi II","evidence":"ST lifler yavaş kasılma hızına sahiptir, geç yorulur ve ürettikleri kuvvet düşüktür."},"kind":"book"},{"id":"saglik-2-5","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":5,"stem":"Aşağıdaki seçeneklerin hangisinde Tip II (fast –Twitch FT) kas liflerin özellikleri doğru verilmiştir?","options":["Aerobik metabolizmaya dayanan aktiviteler için uygundur.","Yüksek düzeyde ATPaz enzim aktivitesine sahiptir.","Hızlı kasılır, geç yorulur.","Fibril çapları küçüktür.","Yüksek miyoglobin içeriğine sahiptir."],"answer":1,"explanation":"Kitap, hızlı kasılan Tip II lifleri yüksek ATPaz enzim aktivitesiyle ilişkilendirir. Hızlı ve yüksek kuvvetli kasılmalar için çabuk enerji üretebilmeleri bu özellikleriyle açıklanır.","source":{"questionPage":55,"answerPage":56,"pages":[42],"section":"Spor Fizyolojisi II","evidence":"Bu kas lifleri yüksek düzeyde ATPaz enzim aktivitesine sahiptir."},"kind":"book"},{"id":"saglik-2-10","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":10,"stem":"Miyoglobin ile ilgili aşağıdaki ifadelerden hangisi yanlıştır ?","options":["İskelet kasının yapısında bulunan bir proteindir.","Oksijenin kas hücresinde depolanmasını sağlar.","Yavaş kasılan kas liflerinde daha fazla bulunur.","Oksijenin kandan mitokondrilere difüzyonunu sağlar.","Karbonhidrat ve proteinleri hücreye taşır."],"answer":4,"explanation":"Miyoglobin, kas içinde oksijen depolar ve oksijenin kandan mitokondrilere taşınmasına yardımcı olur. Karbonhidrat ve proteinleri hücreye taşıma görevi tanımlanmamıştır.","source":{"questionPage":55,"answerPage":56,"pages":[51],"section":"Spor Fizyolojisi II","evidence":"Oksijenin kas hücresinde depolanmasını sağlayan, protein yapısında olan bir maddedir"},"kind":"book"},{"id":"saglik-3-1","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":1,"stem":"Aşağıdakilerden hangisi antrenman yapılan gün enerji hesaplamasında kullanılmaz?","options":["Bazal metabolizma enerjisi hesaplama","Bazal metabolizma enerjisi ve aktivite düzeyi sayısını hesaplama","Günlük enerji ihtiyacını hesaplama","Antrenman yaparak harcanan enerjiyi hesaplama","Karbonhidrat maksimum alımının hesaplanması"],"answer":4,"explanation":"Kitaptaki günlük enerji hesabı bazal metabolizma, günlük aktiviteler ve antrenmanda harcanan enerjiye dayanır. Karbonhidratın maksimum alımını hesaplamak bu toplamın bir bileşeni değildir.","source":{"questionPage":78,"answerPage":80,"pages":[61],"section":"Sporda Beslenme II","evidence":"Sporcunun günlük enerjisi; bazal metabolizma enerjisi, günlük işler için gerekli enerji ve antrenman yaparak harcanan enerjinin toplamıdır."},"kind":"book"},{"id":"saglik-3-2","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":2,"stem":"Karbonhidrat, protein ve yağ makro besinlerinden sporcunun gelişimi için alınması gereken yüzde olarak alt ve üst sınır aşağıdakilerden hangisidir?","options":["Karbonhidratlar %30-70, proteinler %15-30, yağlar %10-40","Karbonhidratlar %50-70, proteinler %15-22, yağlar %10-30","Karbonhidratlar %50-80, proteinler %10-20, yağlar %10-15","Karbonhidratlar %40-50, proteinler %20-30, yağlar %10-40","Karbonhidratlar %40-55, proteinler %5-30, yağlar %10-15"],"answer":1,"explanation":"Kitabın bu bölümünde makro besin aralıkları karbonhidrat için %50–70, protein için %15–22 ve yağ için %10–30 olarak verilir. B seçeneği bu üç aralığı birlikte doğru aktarır; burada sorulan kitap bilgisidir.","source":{"questionPage":78,"answerPage":80,"pages":[63],"section":"Sporda Beslenme II","evidence":"Karbonhidrat: %50-70 (en az %50, en fazla %70) oranında alınmalıdır."},"kind":"book"},{"id":"saglik-3-3","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":3,"stem":"Günlük alınması gereken %50-70 karbonhidratın ....... basit karbonhidratlardan (çay şekeri, meyve şekeri vb.), ……bileşik karbonhidratlardan (pirinç, makarna, ekmek) alınmalıdır.\n\nYukarıdaki cümlede boş bırakılan yerleri aşağıdakilerden hangisi doğru şekilde tamamlar?","options":["%50-%50","%40-%60","%5- %95","%15-%85","%60-%40"],"answer":3,"explanation":"Kitaba göre toplam karbonhidratın %15'i basit, %85'i bileşik karbonhidratlardan karşılanır. Bu oranlar toplam günlük enerjinin değil, alınan karbonhidratın kendi içindeki dağılımıdır.","source":{"questionPage":78,"answerPage":80,"pages":[64],"section":"Sporda Beslenme II","evidence":"Basit karbonhidratlar; günlük alınması gereken karbonhidrat miktarının en fazla %15’i oranında alınmalıdır."},"kind":"book"},{"id":"saglik-3-4","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":4,"stem":"En yüksek emilimi olan …………………... vücudumuz tarafından %93-95 oranında emilir.\n\nYukarıdaki cümlede boş bırakılan yeri aşağıdakilerden hangisi doğru şekilde tamamlar?","options":["süt proteini","kırmızı et proteini","bitkisel kaynaklı protein","yumurta proteini","balık eti proteini"],"answer":3,"explanation":"Soruda verilen %93–95 oranı kitapta yumurta proteini için kullanılır. Kitap, proteinlerin sindirilme ve vücutta kullanılma oranlarını kaynaklarına göre ayrı ayrı verir.","source":{"questionPage":78,"answerPage":80,"pages":[67],"section":"Sporda Beslenme II","evidence":"Yumurta proteini; %93-95 oranında vücut tarafından kullanılır."},"kind":"book"},{"id":"saglik-3-7","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":7,"stem":"Antrenman ve müsabakada tüketilecek sıvı karbonhidratın yoğunluğu ve ısısı nasıl olmalıdır?","options":["Sıvı formundaki karbonhidrat %4-8 oranında ve 5-10 °C serinlikte","Sıvı formundaki karbonhidrat %24-28 oranında ve 5-10 °C serinlikte","Sıvı formundaki karbonhidrat %8-20 oranında ve 5-10 °C serinlikte","Sıvı formundaki karbonhidrat %1-2 oranında ve 5-10 °C serinlikte","Sıvı formundaki karbonhidrat %34-38 oranında ve 5-10 °C serinlikte"],"answer":0,"explanation":"Sorunun dayandığı kitap paragrafında sıvıdaki karbonhidrat oranı %4–8, sıcaklık ise 5–10 °C olarak belirtilir. Bu iki değeri birlikte veren seçenek A'dır.","source":{"questionPage":78,"answerPage":80,"pages":[68],"section":"Sporda Beslenme II","evidence":"antrenman ve müsabaka öncesinde ya da sırasında alınacak sıvıdaki karbonhidratın %4-8 oranında olması önerilmektedir ve 5-10 °C serinlikte olması emilimi artırır."},"kind":"book"},{"id":"saglik-3-10","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":10,"stem":"Vücut ağırlığını 1 kg azaltmak için kaç kkal harcamak gerekir?","options":["10.000 kkal","5.000 kkal","2.000 kkal","1.000 kkal","7.000 kkal"],"answer":4,"explanation":"Kitap, kilo kontrolü örneğinde 1 kg için 7.000 kkal eşleştirmesini kullanır. Bu sorunun cevabı kitaptaki örnek modele dayanır; kişiye özel kilo kaybı hesabı değildir.","source":{"questionPage":79,"answerPage":80,"pages":[74],"section":"Sporda Beslenme II","evidence":"7.000 kkal= 1 kg’dır."},"kind":"book"},{"id":"saglik-4-1","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":1,"stem":"Aşağıda spor yaralanmaları ile ilgili olarak verilen bilgilerden hangisi yanlıştır?","options":["Yüklenme-toparlanma sürecinin etkin şekilde ayarlanamadığı durumlarda, herhangi bir iş yükü artışı olmamasına, mevcut yükün sporcunun daha önce telafi edebildiği bir düzeyde olmasına rağmen de akut yaralanmalar yaşanabilir.","Kemik dokuda yaralanma olarak en sık görülen iki kırık türü, akut kırıklar ve stres kırıklarıdır.","Doku tipine göre spor yaralanmaları, yumuşak doku yaralanmaları ve iskelet yaralanmaları olarak iki başlık altında incelenebilir.","Kas dokuda görülen gecikmiş kas ağrısı en ciddi yumuşak doku yaralanmasıdır.","Ani ve aşırı yüklenmeler ligamentlerin eklem ile birlikte fazla gerilmesine, bu da ligamentte yırtıklara ve bazen de kopmalara neden olabilmektedir."],"answer":3,"explanation":"Kitap gecikmiş kas ağrısını, özellikle alışılmadık ve eksentrik yüklenmelerden sonra görülen bir durum olarak anlatır. Ayrıca ciddi hasar ve işlev kaybı oluşturan kas yırtılmalarını sınıflandırır; DOMS'u en ciddi yumuşak doku yaralanması olarak nitelemek yanlıştır.","source":{"questionPage":111,"answerPage":113,"pages":[84,86],"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Gecikmiş kas ağrısı genellikle normal antrenman periyodunda düzenli olarak çalıştırılmayan kas veya kas gruplarına tükeninceye kadar yapılan egzersizler sonucunda görülmektedir."},"kind":"book"},{"id":"saglik-4-2","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":2,"stem":"Çocuklarda sıklıkla görülen yaş ağaç kırığı, aşağıdakilerden hangisinde doğru şekilde ifade edilmiştir?","options":["Bu tür kırıklar tendonların kemik ile birleştikleri yerde görülen kopma kırıklarıdır.","Yaş ağaç kırıklarında kemik dokuda tam bir ayrılma görülür.","Yaş ağaç kırıklarının görülme oranı kız çocuklarında fazladır.","Bu tür kırıklar yalnızca epifiz plağında meydana gelir.","Yaş ağaç kırığında kemik esner ve kırık oluşur ancak kemik doku tamamen ayrılmamıştır."],"answer":4,"explanation":"Yaş ağaç kırığında kemik esneyip bükülerek kırılır; tam ayrılma oluşmaz. E seçeneği kemiğin bu kısmi kırılma biçimini doğru anlatır.","source":{"questionPage":111,"answerPage":113,"pages":[87],"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Böyle kırıklarda kemiğin bir tarafında kırık vardır ama kemik doku kopmamıştır."},"kind":"book"},{"id":"saglik-4-3","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":3,"stem":"Aşağıda beyin travması ile ilgili olarak verilen bilgilerden hangisi yanlıştır?","options":["Glasgow Koma Skalası beyin travmasının patofizyolojik mekanizması hakkında bilgi verir.","Beyin travmaları bilgisayarlı tomografi, manyetik rezonans görüntüleme vb. yöntemlerle detaylı şekilde incelenebilir.","Beyin travması spora bağlı olarak görülen en önemli morbidite ve mortalite sebeplerinden biridir.","Beyin travması 15-24 yaşları arasındaki erkeklerde daha çok karşılaşılan bir durumdur.","Glasgow Koma Skalası beyin hasarının kısa sürede ölçümünü ve yaralanma şiddetinin sınıflandırılmasını sağlar."],"answer":0,"explanation":"Glasgow Koma Skalası, yaralanma şiddetinin değerlendirilmesine yardım eder. Kitap, patofizyolojik mekanizma hakkında bilgi vermediğini açıkça söylediği için A seçeneği yanlıştır.","source":{"questionPage":111,"answerPage":113,"pages":[91],"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Bu skala beyin travmasının pato-fizyolojik mekanizması hakkında bilgi vermemekle birlikte beyin hasarının kısa sürede ölçümünü ve yaralanmanın şiddetini sınıflamayı sağlamaktadır."},"kind":"book"},{"id":"saglik-4-4","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":4,"stem":"Aşağıdakilerden hangisi yaralanma sonrası spora dönüşte antrenörün sorumluluklarından biri değildir?","options":["Antrenör yaralanma sonrasında profesyonel ekiple sürekli ve tam bir iş birliği içerisinde olmalıdır.","Antrenör her sporcusunu iyi tanımalı, bireysel farklılıkları ölçebilmeli ve bunları daima göz önünde bulundurmalıdır.","Antrenör kendi spor branşı ile ilgili olarak teşhis ve tedavi sürecini gerçekleştirebilir.","Antrenör pre-rehabilitasyon ve koruyucu antrenman geliştirebilmelidir.","Antrenörün temel ilk yardım, fizyoloji, anatomi vb. konularda bilgi sahibi olması gerekir."],"answer":2,"explanation":"Kitapta antrenörün görevi sporcuyu tanımak, ilk yardım bilgisine sahip olmak ve sağlık ekibiyle iş birliği kurmaktır. Teşhis ve tedaviyi kendi başına üstlenmek bu rolün içinde değildir.","source":{"questionPage":111,"answerPage":113,"pages":[99,100],"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"spor yaralanmaları bazı durumlarda kalıcı tedavi süreciyle devam eden ve profesyonel sağlık ekibi tarafından yapılan uygulamalara ihtiyaç duyar."},"kind":"book"},{"id":"saglik-4-6","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":6,"stem":"Çocuklarda spor yaralanmalarından korunma ile ilgili olarak aşağıda verilen bilgilerden hangisi yanlıştır?","options":["Çocukların fazla ısıyı vücuttan uzaklaştırma becerileri gelişmiştir. Bu nedenle çok sıcak ve nemli havalarda antrenman ve müsabaka yapılabilir.","Çocuk spora başlamadan önce tam ve detaylı bir sağlık taramasından geçirilmelidir.","Kullanılan cihaz ve yöntemler çocuğun hem yapı hem de bireysel farklılıkları göz önünde bulundurularak tercih edilmelidir.","Spor yaralanmalarından korunmada bilişsel ve psikolojik gelişim düzeylerine de dikkat edilmelidir.","Çocuklarda sinir-kas ve kardiyorespiratuar sistemlerini yüksek şiddetli aktiviteler ile zorlamamak gerekir."],"answer":0,"explanation":"Kitap, çocukların ısı kaybı ve vücut sıcaklığını düzenleme becerisinin yetişkinlerle aynı olmadığını belirtir. Bu yüzden A seçeneğindeki 'becerileri gelişmiştir' gerekçesi ve buna bağlanan sonuç yanlıştır.","source":{"questionPage":111,"answerPage":113,"pages":[89],"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"evaporasyon ile ısı kaybı sağlamada yetişkinler kadar başarılı değildirler ve vücut ısısını ayarlamakta güçlük çekerler."},"kind":"book"},{"id":"saglik-4-9","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":9,"stem":"Aşağıdakilerden hangisi aşırı kullanım yaralanmaları ile ilgili doğru bilgi değildir?","options":["Aşırı kullanım yaralanmaları enerjinin tekrarlayan dışa vurumu ile ilişkilidir.","Akut yaralanmalar ile karşılaştırıldığında aşırı kullanım yaralanmalarının saptanması daha kolaydır.","Akut bir yaralanma da aşırı kullanım yaralanmasını başlatabilir.","Genellikle aerobik sporlarda ve belirli bir tekniğin sıklıkla tekrarlandığı spor dallarında görülmektedir.","Sinir-kas-iskelet sistemindeki kemik, tendon, eklem ve kaslarda görülen mikro travmalar bu tür bir yaralanmaya sebep olurlar."],"answer":1,"explanation":"Aşırı kullanım yaralanmaları tekrarlayan yüklerle ve mikrotravmalarla ilişkilidir. Başlangıçları belirgin olmayabildiği için kitap bunların akut yaralanmalardan daha zor saptandığını belirtir.","source":{"questionPage":112,"answerPage":113,"pages":[83],"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Akut yaralanmalar ile karşılaştırıldığında aşırı kullanım yaralanmalar, saptanması daha zor yaralanmalardır."},"kind":"book"},{"id":"saglik-5-1","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":1,"stem":"WADA aşağıdakilerden hangisinin kısaltmasıdır?","options":["Dünya Dopingle Mücadele Yönetimi","Dünya Uyuşturucuyla Mücadele Derneği","Dünya Dopingle Mücadele Ajansı","Dünya Uyuşturucuyla Mücadele Hareketi","Dünya Dopingle Mücadele Ajandası"],"answer":2,"explanation":"WADA'nın Türkçe karşılığı Dünya Dopingle Mücadele Ajansıdır. Bu adın karşılığı C seçeneğinde eksiksiz verilmiştir.","source":{"questionPage":132,"answerPage":134,"pages":[118],"section":"Dopingle Mücadele II","evidence":"Dünya Dopingle Mücadele Ajansı (WADA)"},"kind":"book"},{"id":"saglik-5-2","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":2,"stem":"Aşağıdakilerden hangisi Dünya Dopingle Mücadele Kuralları’nın doping tanımına dâhildir?","options":["Herhangi bir reçeteli ilacı kullanmak","Doping kontrol örneği vermeyi reddetmek","Herhangi bir reçetesiz ilacı kullanmak","Spor dalının disiplin kurallarına uymamak","Spor dalının ekipmanlarla ilgili kurallarına uymamak"],"answer":1,"explanation":"Kitabın tanımı yalnızca yasaklı madde kullanımıyla sınırlı değildir. Doping kontrolünü reddetmek veya örnek vermekten kaçınmak da dopingle mücadele kural ihlali olarak belirtilir.","source":{"questionPage":132,"answerPage":134,"pages":[129],"section":"Dopingle Mücadele II","evidence":"Bir sporcunun doping kontrolünü reddetmesi veya örnek vermekten kaçınması bir dopingle mücadele kural ihlalidir."},"kind":"book"},{"id":"saglik-5-3","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":3,"stem":"Sporcu doping kontrol formunun bir kopyasını ne zaman alır?","options":["Doping kontrolünü takiben bir hafta içinde","Doping kontrolünü takiben bir ay içinde","Doping kontrolünden bir ay sonra","Hiçbir zaman","Doping kontrol örnek alma işlemleri bittikten hemen sonra"],"answer":4,"explanation":"Formdaki bilgilerin doğruluğu kontrol edilip gerekli imzalar atıldıktan sonra, örnek alım sürecinin sonunda bir kopya sporcuya verilir. Haftalar ya da aylar sonra verilmesi beklenmez.","source":{"questionPage":132,"answerPage":134,"pages":[125],"section":"Dopingle Mücadele II","evidence":"Örnek alım işlemi bittikten sonra, doping kontrol formunun bir kopyası sporcuya teslim edilir."},"kind":"book"},{"id":"saglik-5-4","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":4,"stem":"Yasaklılar Listesi hangi sıklıkla güncellenir?","options":["Her yıl","Her dört yılda bir","Olimpiyatlardan önce","Her iki yılda bir","Her yıl iki kere"],"answer":0,"explanation":"Kitapta Yasaklılar Listesi'nin yılda en az bir kez güncellendiği belirtilir. Sunulan seçenekler içinde bu sıklığı karşılayan yanıt 'Her yıl'dır.","source":{"questionPage":132,"answerPage":134,"pages":[120],"section":"Dopingle Mücadele II","evidence":"yılda en az bir kez olmak üzere belirli aralıklarla güncellenir."},"kind":"book"},{"id":"saglik-5-5","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":5,"stem":"Doping kontrolü amacıyla kan veya idrar örneklerini analiz eden laboratuvarlar için gereklilik nedir?","options":["Doping kontrol örnekleri herhangi bir laboratuvarda analiz edilebilir.","Laboratuvar, sporcunun ülkesinde bulunmalıdır.","Laboratuvar, Uluslararası Olimpiyat Komitesi tarafından akredite edilmiş olmalıdır.","Laboratuvar, Dünya Dopingle Mücadele Ajansı (WADA) tarafından akredite edilmiş olmalıdır.","Laboratuvar, sporcunun uluslararası federasyonu tarafından akredite edilmiş olmalıdır."],"answer":3,"explanation":"Kitaba göre analiz yapacak laboratuvarın WADA tarafından akredite edilmiş olması gerekir. Laboratuvarın sporcunun ülkesinde olması veya yalnızca federasyon onayı bu koşulun karşılığı değildir.","source":{"questionPage":132,"answerPage":134,"pages":[118],"section":"Dopingle Mücadele II","evidence":"Doping kontrol örneklerinin analizi Dünya Dopingle Mücadele Ajansı (WADA) tarafından akredite edilen laboratuvarlar tarafından gerçekleştirilir."},"kind":"book"},{"id":"saglik-5-6","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":6,"stem":"Bir sporcu hangi durumda müsabaka içi doping kontrolü için seçilebilir?","options":["Sporcu müsabakada birinci olduysa","Sporcu yedek değil asil listedeyse","Sporcuda herhangi bir sağlık sorunu yoksa","Sporcu müsabakada ilk üçe girdiyse","Sporcu herhangi bir nedenle müsabaka içi doping kontrolü için seçilebilir."],"answer":4,"explanation":"Kitap, müsabaka içi kontrol seçimini dereceyle sınırlandırmaz; rastgele seçim veya başka nedenlerle de seçim yapılabilir. Bu yüzden en kapsamlı ve doğru ifade E seçeneğidir.","source":{"questionPage":132,"answerPage":134,"pages":[123],"section":"Dopingle Mücadele II","evidence":"Sporcu rastgele, derecesine göre veya herhangi bir nedenden dolayı doping kontrolüne seçilebilir."},"kind":"book"},{"id":"hareket-1-1","courseId":"hareket","chapter":1,"chapterTitle":"Antrenmanda Yüklenme Dinlenme İlişkisi","number":1,"stem":"Aşağıdakilerden hangisi organizmadaki sistemlerin fonksiyonel değerlerinin dinamik bir denge içermesi durumunu ifade eder?","options":["Yüklenme","Dinlenme","Homeostasis","Katabolik","Anabolik süreç"],"answer":2,"explanation":"Homeostasis, organizmadaki sistemlerin fonksiyonel değerlerinin dinamik dengede bulunmasıdır. Bu soruda bir yüklenme yöntemi değil, organizmanın denge durumu sorulmaktadır.","source":{"questionPage":30,"answerPage":31,"pages":[3],"section":"Antrenmanda Yüklenme Dinlenme İlişkisi","evidence":"Bu dengeye “homeostasis” adı verilir"},"kind":"book"},{"id":"hareket-1-4","courseId":"hareket","chapter":1,"chapterTitle":"Antrenmanda Yüklenme Dinlenme İlişkisi","number":4,"stem":"Çocuk ve gençlerde antrenman amaçları uyarınca bir antrenman biriminde ısınmadan hemen sonra çalıştırılması önerilen ilk biyomotor yeti aşağıdakilerden hangisidir?","options":["Dayanıklılık","Sürat","Koordinasyon","Çabuk kuvvet","Patlayıcı kuvvet"],"answer":2,"explanation":"Kitabın çocuk ve gençler için verdiği antrenman birimi sıralaması ısınma, koordinasyon ve sürat ile başlar. Dolayısıyla ısınmadan hemen sonra koordinasyon gelir.","source":{"questionPage":30,"answerPage":31,"pages":[26],"section":"Antrenmanda Yüklenme Dinlenme İlişkisi","evidence":"1. Isınma, 2. Koordinasyon, 3. Sürat"},"kind":"book"},{"id":"hareket-1-7","courseId":"hareket","chapter":1,"chapterTitle":"Antrenmanda Yüklenme Dinlenme İlişkisi","number":7,"stem":"Çocukların antrenmanlara başladığı ilk basamakta minimum antrenman süresi kaç dakikadır?","options":["30","45","75","90","120"],"answer":2,"explanation":"Soru, s.25 Tablo 1.9’daki basamaklara dayanır: ilk basamakta süre 75 dakikadır. S.26’da başlangıç dönemi için 60 dakikalık oturumlardan 75 ve 90 dakikaya geçiş de anlatılır; bu soru tablodaki ilk basamağı sorar.","source":{"questionPage":30,"answerPage":31,"pages":[25,26],"section":"Antrenmanda Yüklenme Dinlenme İlişkisi","evidence":"Antrenman Süresi 75 90 90-120 75-90"},"kind":"book"},{"id":"hareket-1-10","courseId":"hareket","chapter":1,"chapterTitle":"Antrenmanda Yüklenme Dinlenme İlişkisi","number":10,"stem":"Enerji metabolizmaları açısından ATP-CP yenilenme süresi maksimum kaç dakikadır?","options":["3-4","10","30","60","120"],"answer":0,"explanation":"Kitabın s.9 Tablo 1.3’ünde kas fosfojenleri için minimum 2, maksimum 3–4 dakika verilir. Sorudaki ATP-CP yenilenme süresi bu tabloya dayanır.","source":{"questionPage":30,"answerPage":31,"pages":[9],"section":"Antrenmanda Yüklenme Dinlenme İlişkisi","evidence":"Kas fosfojenlerinin süperkompansasyonu 2 dakika 3-4 dakika"},"kind":"book"},{"id":"hareket-2-1","courseId":"hareket","chapter":2,"chapterTitle":"Dayanıklılık Antrenmanı I","number":1,"stem":"Aşağıdakilerden hangisi egzersiz şiddetini belirleme yöntemlerinden biridir?","options":["Aerobik eşik","Karvonen formülü","İnterval yöntem","VO₂maks","Anaerobik eşik"],"answer":1,"explanation":"Karvonen formülü, hedef kalp atım hızını belirleme yoluyla egzersiz şiddetinin düzenlenmesinde kullanılır. Soru, bir antrenman yöntemini değil şiddet belirleme aracını sorar.","source":{"questionPage":57,"answerPage":58,"pages":[44],"section":"Dayanıklılık Antrenmanı I","evidence":"hedef KAH’nı belirlemek için geliştirilmiş bir formüldür"},"kind":"book"},{"id":"hareket-2-2","courseId":"hareket","chapter":2,"chapterTitle":"Dayanıklılık Antrenmanı I","number":2,"stem":"Aşağıdakilerden hangisi dayanıklılık antrenman şiddetini belirlerken referans alınmaktadır?","options":["Sporcunu isteği","Antrenman koşulları","Branşın gerektirdikleri","Rakibin performansı","Antrenörün isteği"],"answer":2,"explanation":"Dayanıklılık antrenmanının şiddeti belirlenirken spor branşının gerektirdiği dayanıklılık özelliği esas alınır. Her branşa tek ve aynı şiddet uygulanacağı düşünülmemelidir.","source":{"questionPage":57,"answerPage":58,"pages":[36],"section":"Dayanıklılık Antrenmanı I","evidence":"Yapılan sportif branşın gerekli dayanıklılık özelliğinin antrene edilmesi"},"kind":"book"},{"id":"hareket-2-3","courseId":"hareket","chapter":2,"chapterTitle":"Dayanıklılık Antrenmanı I","number":3,"stem":"Aşağıdakilerden hangisi dayanıklılık antrenmanlarının şiddetlerine göre sınıflandırılma şekillerinden biri değildir?","options":["VO₂maks","Anaerobik eşik","Laktik aside tolerans","Sürekli koşu","Aerobik eşik"],"answer":3,"explanation":"Sürekli koşu, dayanıklılık geliştirme yöntemidir. Kitapta şiddet alanları aerobik eşik, anaerobik eşik, laktat toleransı ve maksimal oksijen tüketimi gibi fizyolojik ölçütlerle açıklanır; yöntem ile şiddet alanı ayrılmalıdır.","source":{"questionPage":57,"answerPage":58,"pages":[36,37],"section":"Dayanıklılık Antrenmanı I","evidence":"Sürekli Yüklenme Antrenmanı"},"kind":"book"},{"id":"hareket-2-7","courseId":"hareket","chapter":2,"chapterTitle":"Dayanıklılık Antrenmanı I","number":7,"stem":"İnterval antrenmanlarının şiddetine göre sınıflandırılması aşağıdakilerden hangisinde doğru bir şekilde verilmiştir?","options":["Aerobik Eşik-Anaerobik Eşik","Kısa-Uzun","Yaygın-Yoğun","Sürekli-Aralıklı","VO₂maks-LAT"],"answer":2,"explanation":"İnterval antrenmanları şiddetlerine göre ekstansif (yaygın) ve intensif (yoğun) olarak ayrılır. C seçeneği bu ikili sınıflandırmayı verir.","source":{"questionPage":57,"answerPage":58,"pages":[48],"section":"Dayanıklılık Antrenmanı I","evidence":"Ekstansif (yaygın) interval antrenmanları"},"kind":"book"},{"id":"hareket-3-1","courseId":"hareket","chapter":3,"chapterTitle":"Kuvvet Antrenmanı I","number":1,"stem":"Aşağıdakilerden hangisi “maksimal kuvvet” tanımına en yakın ifadedir?","options":["On (10) tekrarda üretilen en büyük kuvvet miktarıdır.","Bir defada üretilen patlayıcı kuvvet miktarıdır.","Vücudun uzun süren eforlara karşı ürettiği en büyük kuvvet miktarıdır.","Bir kasın veya kas grubunun uygun formda tek tekrarlı maksimal eforda üretebildiği kuvvet miktarıdır.","Vücudun zayıf kaslarının bir defada ürettiği maksimal kuvvet miktarıdır."],"answer":3,"explanation":"Maksimal kuvvet tanımında tek tekrar, maksimal efor ve uygun form birlikte bulunur. Çok sayıda tekrar yapabilme ise farklı bir kuvvet özelliğiyle ilgilidir.","source":{"questionPage":89,"answerPage":90,"pages":[64],"section":"Kuvvet Antrenmanı I","evidence":"Maksimal kuvvet, bir kasın veya kas grubunun uygun formda tek tekrarlı maksimal eforda üretebildiği kuvvet miktarıdır."},"kind":"book"},{"id":"hareket-3-3","courseId":"hareket","chapter":3,"chapterTitle":"Kuvvet Antrenmanı I","number":3,"stem":"Çocuk ve gençlerin antrenman yüklerini belirlemede hangi değerlendirme yöntemi kullanılmamalıdır?","options":["1-TM","8-TM","10-TM","20-TM","Katsayı aracılığı 1-TM hesaplama yöntemi"],"answer":0,"explanation":"Kitabın bu bölümünde çocuklarda ve spora yeni başlayanlarda doğrudan 1-TM testinin uygulanması onaylanmaz. Yanıt, kitaptaki değerlendirme yaklaşımını aktarmaktadır.","source":{"questionPage":89,"answerPage":90,"pages":[64],"section":"Kuvvet Antrenmanı I","evidence":"1-TM testinin çocuklar ile ya da sağlık için spora yeni başlayan kişilerde uygulanmasını onaylanmamaktadır."},"kind":"book"},{"id":"hareket-3-5","courseId":"hareket","chapter":3,"chapterTitle":"Kuvvet Antrenmanı I","number":5,"stem":"Bir sporcu, çömelme (squat) hareketini 2/0/1 tempoda, 10 kez yaparsa bu hareket toplam kaç saniyede tamamlanmış olur?","options":["10","20","25","28","30"],"answer":4,"explanation":"2/0/1 tempoda bir tekrar 2 + 0 + 1 = 3 saniyedir. On tekrar için toplam süre 10 × 3 = 30 saniye olur. Kitap tempo hesabını hareketin evrelerinin toplamıyla açıklar.","source":{"questionPage":89,"answerPage":90,"pages":[71,72],"section":"Kuvvet Antrenmanı I","evidence":"Tempo; sporcuya verilen hareketin, bir tekrarının toplam kaç saniye sürede yapılacağını açıklar."},"kind":"book"},{"id":"hareket-4-2","courseId":"hareket","chapter":4,"chapterTitle":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","number":2,"stem":"Aşağıdaki uyaranlarla verilen tepki eşleşmelerinden hangisi yanlıştır?","options":["Elma dersem çık, armut dersem çıkma (karmaşık reaksiyon)","Sırtına deyince çık (dokunsal reaksiyon, basit)","Tabanca sesi ile kalk (işitsel reaksiyon, basit)","Beyaz bayrak görünce koş (görsel reaksiyon, basit)","Sağ el kalkarsa kaç, sol el kalkarsa kovala (görsel reaksiyon, basit)"],"answer":4,"explanation":"Sağ el kalkınca kaçmak, sol el kalkınca kovalamak iki farklı uyarana farklı tepki seçmeyi gerektirir. Bu nedenle basit değil, karmaşık görsel reaksiyondur.","source":{"questionPage":119,"answerPage":120,"pages":[102,103],"section":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","evidence":"Karmaşık"},"kind":"book"},{"id":"hareket-4-3","courseId":"hareket","chapter":4,"chapterTitle":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","number":3,"stem":"Aşağıdakilerden hangisi çevikliğin özelliklerinden biri değildir?","options":["Tüm vücut hareketini içermesi","Yön değiştirmeyi içermesi","Hızlı hızlanma/yavaşlamayı içermesi","Sadece kapalı becerileri kapsaması","Bir uyaranın tanınması için fiziksel ve bilişsel bir bileşeni içermesi"],"answer":3,"explanation":"Kitap, çevikliği uyaranlara bağlı algılama ve karar verme içeren açık becerilerle ilişkilendirir. Bu yüzden yalnızca kapalı becerileri kapsadığını söyleyen D seçeneği yanlıştır.","source":{"questionPage":119,"answerPage":120,"pages":[98],"section":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","evidence":"Sadece açık becerileri kapsar."},"kind":"book"},{"id":"hareket-4-4","courseId":"hareket","chapter":4,"chapterTitle":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","number":4,"stem":"Sürat antrenmanlarında yük belirleme yöntemleri ile ilgili aşağıdaki eşleşmelerden hangisi yanlıştır?","options":["Kassal aktivite sırasında gerçekleştirilen işin kalitesi, uyaranın süresidir.","Yüklenme ile dinlenme arasındaki zamansal oran, uyaranın sıklığıdır.","Antrenmanda tamamlanan uyaran sayısı ve süresinin toplam miktarı, uyaranın kapsamıdır.","Haftalık antrenman seansı sayısı, antrenmanın sıklığıdır.","Yüklenmelere verilen ara, dinlenme süresidir."],"answer":0,"explanation":"Kassal işin kalitesi uyarının şiddetini ifade eder. Süre ise yüklenmenin ne kadar sürdüğüyle ilgilidir; A seçeneği bu iki değişkeni karıştırır.","source":{"questionPage":119,"answerPage":120,"pages":[100],"section":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","evidence":"Uyarının şiddeti: Kassal aktivite sırasında gerçekleştirilen işin kalitesini ifade eder."},"kind":"book"},{"id":"hareket-4-5","courseId":"hareket","chapter":4,"chapterTitle":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","number":5,"stem":"Aşağıdakilerden hangisi süratin genel antrenman ilkelerinden biri değildir?","options":["Sürat çalışmaları küçük yaşlarda başlayabilmesi","Sürat bir antrenman seansının sonunda çalışılması","Maksimal sürat gelişimi için şiddet yüksek olması","Sürat bariyerinin aşılabilmesi için, çok yönlü sürat antrenmanı yapılması","Aerobik dayanıklılık, kuvvet, koordinasyon, esneklik çalışmaları sürat antrenmanlarına eşlik etmesi"],"answer":1,"explanation":"Sürat çalışmaları, kitabın ilkesine göre ana evrenin başında ve sporcu dinlenikken yapılır. Antrenmanın sonuna bırakılmasını öneren B seçeneği bu ilkeye aykırıdır.","source":{"questionPage":119,"answerPage":120,"pages":[101],"section":"Sürat, Çeviklik ve Yön Değiştirme Hızı Antrenmanı I","evidence":"Sürat antrenmanı, antrenmanın ana evresinin başında ve dinlenik durumda iken uygulanmalıdır."},"kind":"book"},{"id":"hareket-5-1","courseId":"hareket","chapter":5,"chapterTitle":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","number":1,"stem":"Aşağıdaki germe tekniklerinden hangisi kas iğciğinin uyarımını azaltır?","options":["Dinamik","Balistik","Statik","Pasif","PNF"],"answer":2,"explanation":"Kitap, statik germenin düşük hız ve şiddeti nedeniyle gerilme refleksini ortaya çıkarmadığını açıklar. Sorudaki kas iğciği uyarımını azaltan teknik statik germedir.","source":{"questionPage":164,"answerPage":166,"pages":[129],"section":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","evidence":"statik germe gerilmiş kasın gerilme refleksini ortaya çıkarmaz"},"kind":"book"},{"id":"hareket-5-2","courseId":"hareket","chapter":5,"chapterTitle":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","number":2,"stem":"Mobilite antrenmanları ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["Antrenman ya da müsabakalar öncesinde uygulanması önerilir.","Dinamik olarak uygulanır ve fonksiyoneldir.","Foam roller (köpük silindir) kullanımı mobiliteyi arttıracak bir yöntemdir.","Çok eklemli çalışmalardır.","Kuvvet ve güç çıktısını olumsuz etkilediği için bu tür aktivitelerden önce tercih edilmemelidir."],"answer":4,"explanation":"Mobilite, hareket açıklığında kontrol, koordinasyon ve kuvvet göstermeyi destekleyen dinamik bir yapıdır. Kitap bunu aktivasyonla ilişkilendirir; kuvvet ve güç çıktısını olumsuz etkilediği gerekçesiyle öncesinde kullanılmamasını söyleyen E seçeneği yanlıştır.","source":{"questionPage":164,"answerPage":166,"pages":[138],"section":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","evidence":"sporcunun gösterilen herhangi bir ROM da kontrol, koordinasyon ve kuvvet göstermesini sağlar"},"kind":"book"},{"id":"hareket-5-3","courseId":"hareket","chapter":5,"chapterTitle":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","number":3,"stem":"“Hareketin mekân boyutu içerisinde akıcı ve dinamik değişimlere göre hareket edebilme özelliği” aşağıdaki koordinasyon yetilerinden hangisidir?","options":["Ritim yetisi","Oryantasyon yetisi","Denge yetisi","Kinestetik ayrımlama","Reaksiyon yetisi"],"answer":0,"explanation":"Bu tanım ritim yetisine aittir. Kitap ritmi, hareketin akıcı ve dinamik değişimlere uyarlanmasıyla açıklar.","source":{"questionPage":164,"answerPage":166,"pages":[145],"section":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","evidence":"Hareketin mekân boyutu içerisinde akıcı ve dinamik değişimlere göre hareket edebilme özelliğidir."},"kind":"book"},{"id":"hareket-5-4","courseId":"hareket","chapter":5,"chapterTitle":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","number":4,"stem":"Çocuk ve genç sporcularda denge antrenmanlarıyla ilgili aşağıdaki ifadelerden hangisi doğrudur?","options":["Antrenmanlara statik-gözler kapalı alıştırmalarla başlanmalıdır.","Denge alıştırmaları antrenmana son bölümünde yer verilmelidir.","Denge antrenmanları için gelişime en açık dönem ergenlik sonrasıdır.","Denge antrenmanlarında en son dinamik-gözler kapalı alıştırmalara yer verilmelidir.","Alıştırmalar tek tekrar uygulanarak sayısı arttırılmalıdır."],"answer":3,"explanation":"Kitapta sıra statik gözler açık, statik gözler kapalı, dinamik gözler açık ve dinamik gözler kapalıdır. Son aşama dinamik ve gözler kapalı alıştırmalardır.","source":{"questionPage":164,"answerPage":166,"pages":[163],"section":"Hareketlilik, Esneklik ve Koordinatif Yeti Antrenmanı I","evidence":"Sonrasında sırasıyla statik gözler kapalı, dinamik gözler açık ve dinamik gözler kapalı olarak uygulanmalıdır."},"kind":"book"},{"id":"hareket-6-1","courseId":"hareket","chapter":6,"chapterTitle":"Antrenman Planlama ve Periyotlama II","number":1,"stem":"Antrenman planlaması ve periyotlamasındaki bilimsel bilgiye yönelik en büyük sorunun kaynağı aşağıdakilerden hangisidir?","options":["Bilgilerin yanlış olması","Bilgilerin uygulama alanında kullanılamaması","Bilgilere sağlıklı erişim olanağı bulunmaması","Bilgilerin çok geç erişime sunulması","Bilginin elde edilmesinde kullanılan hatalı/eksik bilimsel araştırma tasarımları"],"answer":4,"explanation":"Bölüm, araştırmaların performans çıktısına önceden planlanan zamanda ulaşılıp ulaşılmadığını sınayamamasını bir tasarım sorunu olarak ele alır. Soruda aranan, bilimsel araştırma tasarımlarındaki bu eksikliktir.","source":{"questionPage":217,"answerPage":219,"pages":[172],"section":"Antrenman Planlama ve Periyotlama II","evidence":"bu alanda “kaliteli” bilimsel dergilerde yayımlanan araştırmaların bile bu tasarım sorununu barındırdığını"},"kind":"book"},{"id":"hareket-6-2","courseId":"hareket","chapter":6,"chapterTitle":"Antrenman Planlama ve Periyotlama II","number":2,"stem":"Antrenman planlaması ve periyotlamasının başarılı yönetilmesindeki en değerli bilgi kaynağı aşağıdakilerden hangisidir?","options":["Bilimsel makaleler","Bilimsel kitaplar","Elit sporcular","Güvenilir ve geçerli bilimsel bilgiyi uygulama alanında başarıyla kullanmış uygulamacılar","Profesörler"],"answer":3,"explanation":"Kitap hem bilimsel bilginin niteliğini hem uygulama başarısını sorgulamayı önerir. Güvenilir ve geçerli bilimsel bilgiyi başarılı biçimde kullanan uygulamacı, iki özelliği birlikte taşır.","source":{"questionPage":217,"answerPage":219,"pages":[174],"section":"Antrenman Planlama ve Periyotlama II","evidence":"İki özelliği de barındıran bir bilgi kaynağının aktardığı bilginin güncel, güvenilir ve geçerli olma olasılığı daha yüksektir"},"kind":"book"},{"id":"hareket-6-3","courseId":"hareket","chapter":6,"chapterTitle":"Antrenman Planlama ve Periyotlama II","number":3,"stem":"“Yüklenmedeki tekrar sayısı, set sayısı, yük miktarı, antrenman süresi ve dinlenme süresi gibi değişkenlerin uzun vadeli olarak düzenlenmesine antrenman periyotlaması denir” tanımını yapan bir araştırmacının en temel hatası aşağıdakilerden hangisidir?","options":["Bireysel farklılıkları göz ardı etmiştir.","Periyotlama ve planlama kavramlarını birbiriyle karıştırmıştır.","Periyotlamanın psikolojik boyutunu tanımlamaya dâhil etmemiştir.","Periyotlamanın en önemli değişkeni olan maks VO₂ düzeyinden bahsetmemiştir.","Hata yapmamıştır."],"answer":1,"explanation":"Kitap, temel yüklenme değişkenlerini düzenleyen planlama ile bu planlamayı amaç ve zamanlama yönünden yöneten periyotlamayı ayırır. Sadece tekrar, set, yük ve süre düzenlemesini periyotlamayla özdeşleştirmek iki kavramı karıştırır.","source":{"questionPage":217,"answerPage":219,"pages":[175,176],"section":"Antrenman Planlama ve Periyotlama II","evidence":"Antrenman planlaması, temel antrenman değişkenlerinin nispeten kısa zaman dilimleri içinde yönetilmesini tanımlar."},"kind":"book"},{"id":"hareket-6-5","courseId":"hareket","chapter":6,"chapterTitle":"Antrenman Planlama ve Periyotlama II","number":5,"stem":"“İki-uçlu (çift uçlu) periyotlama” terimindeki uç kelimesi aşağıdakilerden hangisini ifade eder?","options":["İki temel yetinin geliştirilmesini","Periyotlamanın hem kadınlar hem de erkekler için kullanılabileceğini","İki yüklenme döngüsünü bir dinlenme döngüsünün takip ettiğini","Performansın iki ayrı zaman diliminde en üst düzeye yaklaştırılmasını","Periyotlamanın tersten de uygulanabileceğini"],"answer":3,"explanation":"İki uçlu periyotlama, performansı iki ayrı zamanda zirveye yaklaştırmayı hedefler. Buradaki iki uç, iki spor dalı ya da iki farklı antrenman türü anlamına gelmez.","source":{"questionPage":217,"answerPage":219,"pages":[179],"section":"Antrenman Planlama ve Periyotlama II","evidence":"“uç” ifadesi, performansın kaç defa doruk (zirve) düzeye yaklaştırılacağını ifade etmektedir."},"kind":"book"},{"id":"hareket-7-1","courseId":"hareket","chapter":7,"chapterTitle":"Performans Ölçme ve Değerlendirme","number":1,"stem":"Çocuk ve gençlerde kardiyovasküler dayanıklılığı ölçebilmek için kullanılan test aşağıdakilerden hangisidir?","options":["Durarak uzun atlama","150 metre sprint","20 metre çok evreli mekik testi (PACER)","1 dk. mekik testi","Altıgen testi"],"answer":2,"explanation":"20 metre çok aşamalı mekik koşusu (PACER), koşuya dayalı kardiyovasküler uygunluğu ölçer. Bu nedenle dayanıklılık değerlendirmesi için doğru seçenektir.","source":{"questionPage":257,"answerPage":258,"pages":[229],"section":"Performans Ölçme ve Değerlendirme","evidence":"koşu tabanlı kardiyovasküler uygunluk ölçümü sağlar"},"kind":"book"},{"id":"hareket-7-3","courseId":"hareket","chapter":7,"chapterTitle":"Performans Ölçme ve Değerlendirme","number":3,"stem":"Aşağıdaki testlerden hangisi çocuk ve gençlerde çeviklik ve yön değiştirme yetisininin ölçümünde kullanılmaz?","options":["100m sprint","Altıgen testi","İlionis testi","T testi","505 testi"],"answer":0,"explanation":"100 metre sprint doğrusal sürati değerlendirir. Çeviklik ve yön değiştirme testlerinde ise farklı yönlere hareket veya dönüşler bulunur; kitap bunları sprint testlerinden ayrı başlıkta ele alır.","source":{"questionPage":257,"answerPage":258,"pages":[238,242,243,244],"section":"Performans Ölçme ve Değerlendirme","evidence":"505 çeviklik testinin amacı çeviklik, çok yönlü hız ve vücut kontrolüdür."},"kind":"book"},{"id":"hareket-7-4","courseId":"hareket","chapter":7,"chapterTitle":"Performans Ölçme ve Değerlendirme","number":4,"stem":"Çocuk ve gençlerde esneklik biyomotor yetisini ölçen test aşağıdakilerden hangisidir?","options":["Yıldız testi","T testi","Altıgen testi","Cooper testi","Otur eriş testi"],"answer":4,"explanation":"Otur-eriş testi sırt ve hamstring esnekliğini ölçmek için kullanılır. Bu nedenle soruda aranan biyomotor yeti esnekliktir.","source":{"questionPage":257,"answerPage":258,"pages":[240],"section":"Performans Ölçme ve Değerlendirme","evidence":"Testin amacı sırt ve hamstring esnekliğinin ölçülmesidir."},"kind":"book"},{"id":"hareket-8-1","courseId":"hareket","chapter":8,"chapterTitle":"Yetenek Seçimi ve İlkeleri II","number":1,"stem":"Çocuklar, yetenek seçimin aşağıdaki aşamalarından hangisinde faaliyetlere katılabilmesi için “Ebeveyn İzin Formu” gereklidir?","options":["İleri düzey aşamasında","Çoklu branş aşamasında","Temel seçim aşamasında","Hareket becerileri gelişimi aşamasında","İlgili federasyonlara yönlendirme aşamasında"],"answer":2,"explanation":"Temel seçim aşamasındaki faaliyetlerden önce çocuklar ve ebeveynler bilgilendirilir, ebeveyn izin formu alınır. İzin sonraki özel seçim aşamasına ertelenmez.","source":{"questionPage":283,"answerPage":284,"pages":[268],"section":"Yetenek Seçimi ve İlkeleri II","evidence":"ebeveynlerden “Ebeveyn İzin Formu” alınmalıdır"},"kind":"book"},{"id":"hareket-8-3","courseId":"hareket","chapter":8,"chapterTitle":"Yetenek Seçimi ve İlkeleri II","number":3,"stem":"Aşağıdakilerden hangisi yetenek seçimi ve yönlendirme sürecinin ilk aşamasını oluşturur?","options":["Yetenek yönlendirme","Yetenek belirleme","Yetenek tanılama","Yetenek seçimi","Yetenek gelişimi"],"answer":1,"explanation":"Yetenek belirleme, spora katılmış çocukların genel yeteneklerinin tespitidir. Kitabın yetenek seçimi ve yönlendirme akışında ilk aşamayı oluşturur.","source":{"questionPage":283,"answerPage":284,"pages":[265,266],"section":"Yetenek Seçimi ve İlkeleri II","evidence":"Yetenek belirleme (talent detection)"},"kind":"book"},{"id":"hareket-8-4","courseId":"hareket","chapter":8,"chapterTitle":"Yetenek Seçimi ve İlkeleri II","number":4,"stem":"Yetenek seçimi modelinde ikinci aşamada uygun bulunmayan 10-12 yaş grubu çocuklar aşağıdaki ülkelerin hangisinde tekrar seçmelere dahil edilir?","options":["Sovyet Modelinde","Britanya Modelinde","Avustralya Modelinde","Çin Modelinde","Amerika Modelinde"],"answer":0,"explanation":"Kitabın Sovyet modeli anlatımında 10–12 yaş grubundaki ikinci aşamada uygun bulunmayan çocuklara bir yıl sonra yeniden şans verilir. Bu yüzden doğru seçenek Sovyet modelidir.","source":{"questionPage":283,"answerPage":284,"pages":[276],"section":"Yetenek Seçimi ve İlkeleri II","evidence":"Uygun olmayan grubundaki çocuklar elenir ancak 1 yıl sonra potansiyellerinden emin olmak için bir şans daha verilir."},"kind":"book"},{"id":"hareket-8-8","courseId":"hareket","chapter":8,"chapterTitle":"Yetenek Seçimi ve İlkeleri II","number":8,"stem":"Uzun vadeli sporcu gelişimi yaklaşımı aşağıdaki ülkelerden hangisinin modelidir?","options":["Çin","Amerika","Kanada","Rusya","Avustralya"],"answer":2,"explanation":"Uzun vadeli sporcu gelişimi yaklaşımı bu bölümde Kanada modeli olarak anlatılır. Kitap modelin yedi aşamasını ayrıca sıralar.","source":{"questionPage":283,"answerPage":284,"pages":[274,275],"section":"Yetenek Seçimi ve İlkeleri II","evidence":"Kanada’nın 7 Aşamalı Uzun Vadeli Sporcu Gelişim Modeli"},"kind":"book"},{"id":"yonetim-1-1","courseId":"yonetim","chapter":1,"chapterTitle":"Sporda Yönetim ve Organizasyon II","number":1,"stem":"Aşağıdakilerden hangisi spor organizasyonlarının genel amaçlarından biri değildir?","options":["Kâr amacı gütmek","Toplumun her bir bireyine spor yoluyla fırsat eşitliği sağlamak","Spor branşlarının topluma tanıtılmasını ve yaygınlaştırılmasını sağlamak","Toplumlar arasında birlik ve beraberliği sağlamak","Fairplay ruhunu yaşatmak"],"answer":0,"explanation":"Kitap, kâr amacını spor organizasyonlarının özel amaçları arasında sayar. Genel amaçlar arasında birlik, fırsat eşitliği, sporun yaygınlaşması ve fair play ruhu bulunur.","source":{"questionPage":22,"answerPage":24,"pages":[5],"section":"Sporda Yönetim ve Organizasyon II","evidence":"2. Özel Amaçlar: • Kâr amacı gütmek"},"kind":"book"},{"id":"yonetim-1-2","courseId":"yonetim","chapter":1,"chapterTitle":"Sporda Yönetim ve Organizasyon II","number":2,"stem":"Aşağıdakilerden hangisi spor organizasyonlarının aşamalarından biri değildir?","options":["Planlama ve amaç belirleme","Faaliyet belirleme ve gruplandırma","Personel seçme ve görevlendirme","Yetki ve sorumluluk belirleme","Ayrılık gözetme"],"answer":4,"explanation":"Ayrılık gözetme, kitabın organizasyon ilkeleri içinde açıklanır. Planlama, faaliyetleri belirleme, personel seçme ve yetki-sorumluluk belirleme ise organizasyonun aşamalarıdır.","source":{"questionPage":22,"answerPage":24,"pages":[6,7],"section":"Sporda Yönetim ve Organizasyon II","evidence":"İstisna ilkesi olarak da adlandırılan ayrılık gözetme ilkesi"},"kind":"book"},{"id":"yonetim-1-3","courseId":"yonetim","chapter":1,"chapterTitle":"Sporda Yönetim ve Organizasyon II","number":3,"stem":"Türkiye Cumhuriyeti Devletinin çok sporlu ve çok kulüplü, ilk merkezî teşkilatlanma yapısı ve spor yönetiminin ilk hayat bulduğu resmî spor teşkilatı aşağıdakilerden hangisidir?","options":["Türk Spor Kurumu (TSK)","Türkiye İdman Cemiyetleri İttifakı (TİCİ)","Gençlik ve Spor Genel Müdürlüğü (GSGM)","Milli Eğitim Gençlik ve Spor Bakanlığı","Beden Terbiyesi Genel Müdürlüğü (BTGM)"],"answer":1,"explanation":"Kitap ilk merkezî spor teşkilatını Türkiye İdman Cemiyetleri İttifakı olarak tanımlar ve kuruluşunu 22 Mayıs 1922'ye tarihler. TSK ve BTGM daha sonraki örgütlenmelerdir.","source":{"questionPage":22,"answerPage":24,"pages":[9],"section":"Sporda Yönetim ve Organizasyon II","evidence":"Türkiye’nin ilk merkezî teşkilatlanma yapısı ve spor yönetiminin ilk hayat bulduğu teşkilat olan Türkiye İdman Cemiyetleri İttifakı 22 Mayıs 1922 tarihinde resmen kurulmuştur."},"kind":"book"},{"id":"yonetim-1-6","courseId":"yonetim","chapter":1,"chapterTitle":"Sporda Yönetim ve Organizasyon II","number":6,"stem":"“Sporcunun ya da bir spor takımının fiziksel, ruhsal ve zihinsel performanslarının geliştirilmesini sağlayan, onları antrene eden ve ilgili spor branşında özel eğitimler almış, branşında teknik donanıma sahip kişidir.” şeklinde açıklanan kavram aşağıdakilerden hangisidir?","options":["Beden eğitimi ve spor öğretmeni","Mentör","Hakem","Antrenör","Spor yöneticisi"],"answer":3,"explanation":"Bu tanım, sporcu veya takımın performansını geliştirmek üzere branşa özgü eğitim ve teknik donanıma sahip antrenöre aittir. Diğer mesleklerin görev tanımları kitapta ayrıca verilir.","source":{"questionPage":22,"answerPage":24,"pages":[16],"section":"Sporda Yönetim ve Organizasyon II","evidence":"fiziksel, ruhsal ve zihinsel performanslarının geliştirilmesini sağlayan, onları antrene eden"},"kind":"book"},{"id":"yonetim-1-7","courseId":"yonetim","chapter":1,"chapterTitle":"Sporda Yönetim ve Organizasyon II","number":7,"stem":"Aşağıdakilerden hangisi kariyer planlama sürecinde kullanılan araçlardan biri değildir?","options":["Kariyer danışmanlığı","Kariyer haritaları","Kariyer gelişim merkezleri","Kariyer rehberliği","Çok yönlü kariyer"],"answer":4,"explanation":"Kitabın kariyer planlama araçları listesinde danışmanlık, rehberlik, haritalar ve gelişim merkezleri yer alır. 'Çok yönlü kariyer' bu araçlar listesinin bir öğesi değildir.","source":{"questionPage":22,"answerPage":24,"pages":[16],"section":"Sporda Yönetim ve Organizasyon II","evidence":"kariyer danışmanlığı, kariyer rehberliği, kariyer haritaları, kariyer gelişim merkezleri, iş rotasyonu, iş zenginleştirme, mentörlük, eğitim ve geliştirme programları"},"kind":"book"},{"id":"yonetim-1-9","courseId":"yonetim","chapter":1,"chapterTitle":"Sporda Yönetim ve Organizasyon II","number":9,"stem":"“Örgüt içindeki tüm pozisyonların ve iş tanımlarının, ayrıca pozisyonlar arası geçişlerin açıkça gösterildiği bir şemadır.” şeklinde açıklanan kavram aşağıdakilerden hangisidir?","options":["Kariyer rehberliği","İş zenginleştirme","İş rotasyonu","Eğitim ve geliştirme programları","Kariyer haritaları"],"answer":4,"explanation":"Örgütteki pozisyonları ve bunlar arasındaki geçişleri gösteren şema kariyer haritasıdır. Bireysel kariyer haritası ise kişinin hedefine ulaşmak için ihtiyaç duyduğu eğitimlerin planlanmasıyla ilgilidir.","source":{"questionPage":23,"answerPage":24,"pages":[16],"section":"Sporda Yönetim ve Organizasyon II","evidence":"Kariyer haritaları; örgüt içinde tüm pozisyonları ve iş tanımlarını gösteren, pozisyonlar arası geçişlerin açıkça gösterildiği bir şemadır."},"kind":"book"},{"id":"yonetim-2-3","courseId":"yonetim","chapter":2,"chapterTitle":"Spor İşletmeciliği II","number":3,"stem":"Aşağıdakilerden hangisi orta kademe yöneticidir?","options":["Memur","Şef","Başkan","Genel Müdür","Şube Müdürü"],"answer":4,"explanation":"Kitap, şube müdürünü orta kademe yöneticiler arasında sayar. Şef alt kademede; başkan ve genel müdür üst kademede yer alır.","source":{"questionPage":43,"answerPage":45,"pages":[39],"section":"Spor İşletmeciliği II","evidence":"Şube müdürü, müdür muavini ve bazı durumlarda daire başkanı gibi unvanlarla anılan bu yöneticiler"},"kind":"book"},{"id":"yonetim-2-5","courseId":"yonetim","chapter":2,"chapterTitle":"Spor İşletmeciliği II","number":5,"stem":"Aşağıdakilerden hangisi uzman ve etkili bir yönetim tarzına sahip olan spor tesisinin sahip olması gereken niteliklerden biri değildir?","options":["Fiyatlandırma","Temizlik ve hijyen","Kapasite","Güvenlik","Hizmet sunma hızı"],"answer":0,"explanation":"Bu soruda genel işletmecilik işlevlerinden ziyade kitaptaki tesis hizmetleri listesi soruluyor. Temizlik, kapasite, güvenlik ve hizmet hızı listede yer alırken fiyatlandırma yer almaz.","source":{"questionPage":43,"answerPage":45,"pages":[37],"section":"Spor İşletmeciliği II","evidence":"Güvenlik ve emniyet, • Temizlik ve hijyen, • Kapasite ve envanter, • İşlevsellik ve teknoloji, • Müşteri memnuniyeti, • Hizmet sunma hızı"},"kind":"book"},{"id":"yonetim-2-6","courseId":"yonetim","chapter":2,"chapterTitle":"Spor İşletmeciliği II","number":6,"stem":"Özel beden eğitimi ve spor tesisleri yönetmeliğine göre tesislerin sahip olması gereken nitelikler aşağıdakilerden hangisinde doğru olarak verilmiştir?","options":["Kullanım alanı 10 m2’den daha az olmamak üzere en az 1 (bir) soyunma odasının olması","Kullanım alanı 10 m2’den az olmamak üzere en az bir dinlenme odasının olması","Tesislerde yangın söndürme ve benzeri aletlerin bulundurulma zorunluluğunun olmaması","Tesiste spor çalışmalarının yapıldığı yerin ısısının 20 dereceden az olmaması","Tesiste çalışma yapıldığı sürede duşların sıcak suyunun bulunması"],"answer":4,"explanation":"Kitabın aktardığı yönetmelik niteliklerinde çalışma boyunca duşlarda sıcak su bulunması sayılır. Yanıt, Eylül 2020 kitabındaki düzenleme anlatımına dayanmaktadır.","source":{"questionPage":43,"answerPage":45,"pages":[30],"section":"Spor İşletmeciliği II","evidence":"Tesiste çalışma yapıldığı sürece duşların sıcak suyunun bulunması"},"kind":"book"},{"id":"yonetim-2-8","courseId":"yonetim","chapter":2,"chapterTitle":"Spor İşletmeciliği II","number":8,"stem":"Aşağıdakilerden hangisi insanların sportif tesislerden yararlanma nedenlerinden biri değildir?","options":["Beden sağlığı","Boş zamanı değerlendirme","Para kazanma","Sosyalleşme","Ruh sağlığı"],"answer":2,"explanation":"Spor tesislerinden yararlanmanın sağlık, sosyalleşme ve boş zamanı değerlendirme gibi amaçları vardır. İşletmenin gelir elde etmesi ile kullanıcının tesisten yararlanma amacı aynı şey değildir; sorudaki 'para kazanma' bu ayrımı ölçer.","source":{"questionPage":43,"answerPage":45,"pages":[32,33],"section":"Spor İşletmeciliği II","evidence":"esas itibariyle, insanların spor ihtiyaçlarını karşılamak için kurulurlar"},"kind":"book"},{"id":"yonetim-2-9","courseId":"yonetim","chapter":2,"chapterTitle":"Spor İşletmeciliği II","number":9,"stem":"Spor tesislerinin oluşturulmasında temel kriterler ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["Spor tesisleri seyir sporuna yönelik olarak yapılmalıdır.","Tesisler planlandığı şekilde yapılmalıdır.","Uluslararası organizasyonların yapılabilmesine imkân vermelidir.","Okul çağındakileri spora teşvik edecek şekilde planlanmalıdır.","Acil şekilde müdahale edebilecek yeterlilikte teknik elemana ihtiyaç yoktur."],"answer":4,"explanation":"Kitap, arızalara hızlı müdahale edebilecek yeterlilikte ve sayıda teknik personel bulunmasını açıkça ister. Teknik elemana ihtiyaç olmadığını söyleyen E seçeneği bu ilkenin tersidir.","source":{"questionPage":44,"answerPage":45,"pages":[31],"section":"Spor İşletmeciliği II","evidence":"Arıza hâllerinde acil müdahale edebilecek yeterlilikte ve sayıda teknik eleman olmasına dikkat edilmelidir."},"kind":"book"},{"id":"yonetim-2-10","courseId":"yonetim","chapter":2,"chapterTitle":"Spor İşletmeciliği II","number":10,"stem":"Aşağıdakilerden hangisi, bir spor işletmesinin amaçlarından biri değildir?","options":["Kâr elde etmek","Sosyal sorumluluk","Sporun tabana yayılması","Spora yönelik ihtiyaçları dikkate almaması","Spor dalının bilinirliğinin artması"],"answer":3,"explanation":"Spor işletmesi sunduğu hizmetle gelir elde edebilse de hizmet verdiği grubun spor ihtiyaçlarını karşılamayı amaçlar. Bu ihtiyaçları dikkate almamak bir kuruluş amacı olamaz.","source":{"questionPage":44,"answerPage":45,"pages":[33],"section":"Spor İşletmeciliği II","evidence":"asıl amaçları, hizmet verdikleri kesimin spora yönelik ihtiyaçlarını gidermek üzere kurulur"},"kind":"book"},{"id":"yonetim-3-1","courseId":"yonetim","chapter":3,"chapterTitle":"Sporda Liderlik II","number":1,"stem":"I- Antrenörlük stili (1)\nII- Sporcu (a)\nIII- Durum (s)\n\nYukarıdaki ifadelerin hangisi durumsallık yaklaşımına göre antrenör bakımından liderlik formülünde yer alır?","options":["Yalnız II","Yalnız I","I ve III","I ve II","I, II ve III"],"answer":4,"explanation":"Durumsallık yaklaşımının L = l × a × s formülünde antrenörlük stili, sporcu ve durum birlikte yer alır. Bu nedenle üç öncülün tamamı doğrudur.","source":{"questionPage":59,"answerPage":61,"pages":[52],"section":"Sporda Liderlik II","evidence":"Bu formüle göre liderlik (L), antrenörlük stili (1), sporcu (a) ve durumun (s) bir fonksiyonudur."},"kind":"book"},{"id":"yonetim-3-3","courseId":"yonetim","chapter":3,"chapterTitle":"Sporda Liderlik II","number":3,"stem":"Lider antrenörlerin davranışları ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["Lider antrenörler bulundukları kurum içerisinde başarılı organizasyon, iletişim ve planlama için çalışırken arkadaşlık, yakınlık, güven, saygı ve sevgi ortamını da kurum içerisinde yerleştirmelidirler.","Lider antrenörler sporcularının hedefler belirlemelerine ve belirledikleri hedefleri başarmaları için yollar göstermeye her daim yardımcı olmalıdırlar.","Lider antrenörler beraber çalıştıkları yardımcı antrenörleri ile her türlü bilgi alışverişine girmeli ve takım ile ilgili taktik, teknik ve diğer konularda tartışmaktan kaçınmamalıdırlar.","Lider antrenörleri ile diğer başarılı lider antrenörlerin birbirlerinden farklı özellikleri bulunmamaktadır.","Antrenörler başarılı liderlerde gördükleri ve sahip olmak istedikleri özellikleri sonradan geliştirip öğrenebilirler."],"answer":3,"explanation":"Kitap, liderliği kişisel özellikler, davranışlar ve durumla birlikte açıklar; farklı koşullarda farklı tarzlar etkili olabilir. Başarılı lider antrenörlerin birbirinden hiçbir farklı özelliği bulunmadığını söylemek bu anlatımla uyuşmaz.","source":{"questionPage":59,"answerPage":61,"pages":[51,52,53],"section":"Sporda Liderlik II","evidence":"Liderlerin işlevlerini yürüttükleri ve yönettikleri nitelik, çeşit gibi farklı vaziyetlere istinaden değişimler izlenebilmektedir."},"kind":"book"},{"id":"yonetim-3-5","courseId":"yonetim","chapter":3,"chapterTitle":"Sporda Liderlik II","number":5,"stem":"“İster lider tanımlanırken güç ve kontrol vurgulansın, isterse grup ön plana çıkarılsın, varılmak istenilen tek nokta; bazı insanların doğal liderler olduğu ve bu doğal liderleri başkalarından ayıran ve yeteneklere ve fiziksel özelliklere sahip oldukları düşüncesidir. Zekâ, ileri görüşlü olabilme, karar verme ve dürüstlük özgüven, yaş, boy vb. nitelikleri olan antrenörler, sporcular açısından başarılı olarak kabul görmektedirler.” şeklindeki ifade aşağıdaki yaklaşımlardan hangisini tanımlar?","options":["Bilimsel yaklaşım","Davranışsal yaklaşım","Özellikler yaklaşım","Durumsallık yaklaşım","Yönetim süreci yaklaşımı"],"answer":2,"explanation":"Doğuştan geldiği düşünülen özellikler ve kişiyi başkalarından ayıran niteliklere odaklanmak özellikler yaklaşımının temelidir. Davranışsal yaklaşım ise liderin ne yaptığına odaklanır.","source":{"questionPage":59,"answerPage":61,"pages":[51],"section":"Sporda Liderlik II","evidence":"bazı insanların doğal liderler olduğu ve bu doğal liderleri başkalarından ayıran ve yeteneklere ve fiziksel özelliklere sahip oldukları düşüncesidir"},"kind":"book"},{"id":"yonetim-3-6","courseId":"yonetim","chapter":3,"chapterTitle":"Sporda Liderlik II","number":6,"stem":"“Liderlikte bu yaklaşımın odak noktası, liderin sergilemiş olduğu davranış biçimleridir. Liderliğin kişiye özel bir husus olmasından ziyade, liderin grup/takım üyeleriyle ilişkilerinden kaynaklanan bir davranış tarzı olduğu düşünülmektedir.” şeklindeki ifade aşağıdaki kavramlardan hangisini tanımlar?","options":["Yönetim süreci yaklaşımı","Durumsallık yaklaşım","Özellikler yaklaşım","Bilimsel yaklaşım","Davranışsal yaklaşım"],"answer":4,"explanation":"Soru, liderin davranışını ve grup üyeleriyle ilişkilerini öne çıkarır. Bu vurgu kitaptaki davranışsal yaklaşım tanımıyla doğrudan örtüşür.","source":{"questionPage":59,"answerPage":61,"pages":[52],"section":"Sporda Liderlik II","evidence":"Liderlikte davranışsal yaklaşımın odak noktası, liderin sergilemiş olduğu davranış biçimleridir."},"kind":"book"},{"id":"yonetim-3-9","courseId":"yonetim","chapter":3,"chapterTitle":"Sporda Liderlik II","number":9,"stem":"“Sorunlar ile karşılaşıldığı zaman olumlu ve iyimser tavır takınmak ile bir lider izleyicileri üzerinden güven duygusu uyandırabilir. Sağlam bir güven duygusu içerisinde olma örgütün, amaç ve başarıya ulaşmasında anahtar bir rol oynamaktadır.” şeklindeki ifade liderlik fonksiyonlarından hangisini tanımlar?","options":["Hedef belirleme fonksiyonu","Planlama fonksiyonu","Kontrol fonksiyonu","Liderin güven sağlama fonksiyonu","Grup temsilcisi fonksiyonu"],"answer":3,"explanation":"Olumlu ve iyimser tutumla takipçilerde güven yaratma, liderin güven sağlama fonksiyonudur. Planlama ve hedef belirleme, kitapta farklı işlevler olarak açıklanır.","source":{"questionPage":60,"answerPage":61,"pages":[53],"section":"Sporda Liderlik II","evidence":"Sorunlar ile karşılaşıldığı zaman olumlu ve iyimser tavır takınmak ile bir lider izleyicileri üzerinden güven duygusu uyandırabilir."},"kind":"book"},{"id":"yonetim-3-10","courseId":"yonetim","chapter":3,"chapterTitle":"Sporda Liderlik II","number":10,"stem":"Aşağıdakilerden hangisi lider antrenörün başarı bileşenlerinden biri değildir?","options":["Vizyon birliği","Yeteneklerin farklılığı","Lider oyuncu bulma","Oyuncular ile iletişim","Hakemlik fonksiyonu"],"answer":4,"explanation":"Kitap başarı bileşenleri arasında vizyon birliğini, farklı yetenekleri, lider oyuncuyu ve oyuncularla iletişimi ele alır. Hakemlik fonksiyonu bu başarı bileşenleri arasında değildir.","source":{"questionPage":60,"answerPage":61,"pages":[56,57],"section":"Sporda Liderlik II","evidence":"Lider Oyuncu Bulma"},"kind":"book"},{"id":"yonetim-4-1","courseId":"yonetim","chapter":4,"chapterTitle":"Sporda İletişim ve Halkla İlişkiler II","number":1,"stem":"Duygu, düşünce veya bilgilerin akla gelebilecek her türlü yolla başkalarına aktarılması, bildirişim, haberleşme, komünikasyon şekline ne denir?","options":["Haberleşme","İletişim","Öğrenme","Dinleme","Özümseme"],"answer":1,"explanation":"Kitap bu ifadeyi iletişimin tanımı olarak aktarır. Soru, bu tanımı kapsayan kavramı sorduğundan anahtardaki yanıt iletişimdir.","source":{"questionPage":79,"answerPage":80,"pages":[65],"section":"Sporda İletişim ve Halkla İlişkiler II","evidence":"Duygu, düşünce veya bilgilerin akla gelebilecek her türlü yolla başkalarına aktarılması, bildirişim, haberleşme, komünikasyon"},"kind":"book"},{"id":"yonetim-4-2","courseId":"yonetim","chapter":4,"chapterTitle":"Sporda İletişim ve Halkla İlişkiler II","number":2,"stem":"Aşağıdakilerden hangisi iletişimin ögelerinden değildir?","options":["Kaynak (verici)","Alıcı (hedef)","İleti (mesaj)","Kanal","İleti sayısı"],"answer":4,"explanation":"İletişim sürecinde kaynak, alıcı, mesaj, kanal ve geri bildirim ele alınır. Gönderilen 'ileti sayısı' kitabın süreç öğeleri arasında sayılmaz.","source":{"questionPage":79,"answerPage":80,"pages":[66,67],"section":"Sporda İletişim ve Halkla İlişkiler II","evidence":"Kaynak, Hedef ya da Alıcı, Kanal, Mesaj, Hedef ve Geri Bildirim."},"kind":"book"},{"id":"yonetim-4-3","courseId":"yonetim","chapter":4,"chapterTitle":"Sporda İletişim ve Halkla İlişkiler II","number":3,"stem":"İletinin (mesajın) aktarılma şekline ne denir?","options":["Geri bildirim","Gürültü","Kaynak (verici)","Kanal","İleti (mesaj)"],"answer":3,"explanation":"Mesajın alıcıya aktarılma biçimi kanaldır. Kaynak süreci başlatır; geri bildirim ise alıcının mesaja verdiği karşılıktır.","source":{"questionPage":79,"answerPage":80,"pages":[66],"section":"Sporda İletişim ve Halkla İlişkiler II","evidence":"Kanal, iletinin aktarılma şeklidir."},"kind":"book"},{"id":"yonetim-4-6","courseId":"yonetim","chapter":4,"chapterTitle":"Sporda İletişim ve Halkla İlişkiler II","number":6,"stem":"Halkla ilişkiler süreci kaç aşamadan oluşmaktadır?","options":["2","4","6","8","10"],"answer":1,"explanation":"Halkla ilişkiler süreci araştırma, planlama, uygulama ve değerlendirme olmak üzere dört aşamadır. Aşamalar birbirini izleyen bir bütün olarak ele alınır.","source":{"questionPage":79,"answerPage":80,"pages":[73],"section":"Sporda İletişim ve Halkla İlişkiler II","evidence":"Halkla ilişkiler süreci dört aşamadan oluşmaktadır. Bunlar sırasıyla araştırma, planlama, uygulama ve değerlendirme şeklindedir."},"kind":"book"},{"id":"yonetim-4-7","courseId":"yonetim","chapter":4,"chapterTitle":"Sporda İletişim ve Halkla İlişkiler II","number":7,"stem":"“Halkla ilişkiler sürecinin ilk aşaması hedef kitle hakkında bilgi sahibi olmaktır. Yani……… yapmaktır.”\n\nYukarıdaki ifadede boş bırakılan yeri aşağıdakilerden hangisi doğru olarak tamamlar?","options":["Araştırma","Planlama","Uygulama","Örgütleme","Değerlendirme"],"answer":0,"explanation":"İlk adım, hedef kitlenin ve mevcut durumun tanınması için araştırma yapmaktır. Elde edilen bilgiler daha sonra planlamaya temel olur.","source":{"questionPage":79,"answerPage":80,"pages":[73],"section":"Sporda İletişim ve Halkla İlişkiler II","evidence":"Halkla ilişkiler sürecinin ilk aşaması hedef kitle hakkında bilgi sahibi olmaktır. Yani araştırma yapmaktır."},"kind":"book"},{"id":"yonetim-4-10","courseId":"yonetim","chapter":4,"chapterTitle":"Sporda İletişim ve Halkla İlişkiler II","number":10,"stem":"Aşağıdakilerden hangisi halkla ilişkilerin etiğe dayalı esas değerlerinden biri değildir?","options":["Dürüstlük","Uzmanlık","Bağımsızlık","Adalet","Saldırı"],"answer":4,"explanation":"Etik esas değerler savunma, dürüstlük, uzmanlık, bağımsızlık, sadakat ve adalettir. 'Saldırı' bu değerler arasında bulunmaz; 'savunma' ile karıştırılmamalıdır.","source":{"questionPage":79,"answerPage":80,"pages":[75],"section":"Sporda İletişim ve Halkla İlişkiler II","evidence":"Adalet: Müşterilerle, işverenlerle, rakiplerle, iş arkadaşlarıyla, satıcılarla medyayla kısacası tüm çevreyle dürüstlük çerçevesinde adil ilişki kurmak"},"kind":"book"},{"id":"yonetim-5-1","courseId":"yonetim","chapter":5,"chapterTitle":"Spor Hukuku II","number":1,"stem":"Aşağıdakilerden hangisi Türkiye’de gençlik ve spor politikalarının birincil kaynağı olarak kabul edilen mevzuat türüdür?","options":["Anayasa","5894 sayılı Türkiye Futbol Federasyonu Kuruluş ve Görevleri Hakkında Kanun","6222 sayılı Sporda Şiddet ve Düzensizliğin Önlenmesine Dair Kanun","3289 sayılı Gençlik ve Spor Hizmetleri Kanunu","Gençlik ve Spor Kulüpleri Yönetmeliği"],"answer":0,"explanation":"Kitap, normlar hiyerarşisinde Anayasayı en üst düzeye yerleştirir. Gençlik ve spor politikalarının birincil mevzuat kaynağı bu nedenle Anayasadır.","source":{"questionPage":107,"answerPage":108,"pages":[85],"section":"Spor Hukuku II","evidence":"önem ve öncelik bakımından birincil düzeye sahip olan Anayasaya"},"kind":"book"},{"id":"yonetim-5-2","courseId":"yonetim","chapter":5,"chapterTitle":"Spor Hukuku II","number":2,"stem":"Aşağıdaki konulardan hangisi 1982 tarihli T.C. Anayasasının 59. maddesinde düzenlenen konular arasında yer almaktadır?","options":["Konut hakkı","Gençliğin korunması","Eğitim hakkı","Dilekçe hakkı","Tahkim Kurulu Kararları"],"answer":4,"explanation":"Kitabın Anayasa'nın 59. maddesi anlatımında sporun geliştirilmesi yanında tahkim düzenlemesi yer alır. Gençliğin korunması ise 58. madde başlığı altında anlatılır.","source":{"questionPage":107,"answerPage":108,"pages":[86],"section":"Spor Hukuku II","evidence":"Spor federasyonlarının spor faaliyetlerinin yönetimine ve disiplinine ilişkin kararlarına karşı ancak zorunlu tahkim yoluna başvurulabilir."},"kind":"book"},{"id":"yonetim-5-3","courseId":"yonetim","chapter":5,"chapterTitle":"Spor Hukuku II","number":3,"stem":"Gençlik ve Spor Bakanlığına bağlı spor il ve ilçe müdürlüklerinin görev ve yetkilerine ait esas ve usuller hangi kanun uyarınca düzenlenmektedir?","options":["5393 sayılı Belediye Kanunu","5216 sayılı Büyükşehir Belediyesi Kanunu","3289 sayılı Gençlik ve Spor Hizmetleri Kanunu","5253 sayılı Dernekler Kanunu","5894 sayılı Türkiye Futbol Federasyonu Kuruluş ve Görevleri Hakkında Kanun"],"answer":2,"explanation":"Kitabın 3289 sayılı Kanun başlığı altında aktardığı amaç hükmü, il ve ilçe müdürlüklerinin kuruluşu ile görev ve yetkilerini kapsar. Yanıt bu kitap baskısındaki mevzuat anlatımına dayanır.","source":{"questionPage":107,"answerPage":108,"pages":[91],"section":"Spor Hukuku II","evidence":"Bu Kanun’un amacı, Gençlik ve Spor Bakanlığında tüzel kişiliğe sahip taşrada özel bütçeli Gençlik Hizmetleri ve Spor İl ve İlçe Müdürlüklerinin kurulmasına, teşkilat, görev ve yetkilerine ait esas ve usulleri düzenlemektir"},"kind":"book"},{"id":"yonetim-5-4","courseId":"yonetim","chapter":5,"chapterTitle":"Spor Hukuku II","number":4,"stem":"Aşağıdaki spor federasyonlarından hangisi hukuki yapısı ve işleyişi bakımından diğerlerinden farklıdır?","options":["Türkiye Güreş Federasyonu","Türkiye Oryantiring Federasyonu","Türkiye Ragbi Federasyonu","Türkiye Futbol Federasyonu","Türkiye Voleybol Federasyonu"],"answer":3,"explanation":"Kitap, Türkiye Futbol Federasyonunun kendine ait kanunu ve özerk yapısı nedeniyle diğer federasyonlardan ayrıldığını vurgular. Bu sorudaki ayırt edici özellik hukuki yapıdır.","source":{"questionPage":107,"answerPage":108,"pages":[95],"section":"Spor Hukuku II","evidence":"Türkiye Futbol Federasyonu, Türkiye’ deki diğer spor federasyonlarından farklı olarak kendisine ait bir kanunu bulunan ve özerk olan bir federasyondur."},"kind":"book"},{"id":"yonetim-5-6","courseId":"yonetim","chapter":5,"chapterTitle":"Spor Hukuku II","number":6,"stem":"Spor kulüplerinin bünyelerinde aşağıdaki kurullardan hangisinin oluşturulması zorunludur?","options":["Disiplin kurulu","Yönetim kurulu","Etik kurulu","Sağlık kurulu","Eğitim kurulu"],"answer":1,"explanation":"Kitabın saydığı zorunlu organlar genel kurul, yönetim kurulu ve denetim kuruludur. Seçeneklerde bunlardan yalnızca yönetim kurulu bulunur.","source":{"questionPage":107,"answerPage":108,"pages":[98],"section":"Spor Hukuku II","evidence":"zorunlu olduğu organları şu şekildedir: Ø Genel kurul Ø Yönetim kurulu Ø Denetim kurulu"},"kind":"book"},{"id":"yonetim-5-10","courseId":"yonetim","chapter":5,"chapterTitle":"Spor Hukuku II","number":10,"stem":"Aşağıdakilerden hangisi Türkiye Futbol Federasyonu Kuruluş ve Görevleri Hakkındaki güncel kanundur?","options":["3813 Sayılı Kanun","3461 Sayılı Kanun","3289 Sayılı Kanun","5894 Sayılı Kanun","5105 Sayılı Kanun"],"answer":3,"explanation":"Kitabın Eylül 2020 baskısında TFF'nin kuruluş ve görevleri 5894 sayılı Kanun başlığında ele alınır. Soru kökündeki 'güncel' ifadesi bu baskının bağlamına aittir.","source":{"questionPage":107,"answerPage":108,"pages":[95],"section":"Spor Hukuku II","evidence":"Türkiye Futbol Federasyonu Kuruluş ve Görevlerine İlişkin Mevzuat (Güncel: 5894 Sayılı Kanun)"},"kind":"book"},{"id":"ogrenme-1-1","courseId":"ogrenme","chapter":1,"chapterTitle":"Antrenörlük Mesleğine Giriş II – 2. Kademe","number":1,"stem":"Aşağıdakilerden hangisi antrenörlerin sahip olması gereken içsel alan bilgisi ile ilgili doğru bir ifadedir?","options":["Antrenörün başkalarıyla olumlu ve verimli ilişkiler kurma yeteneğidir.","Antrenörün, hangi spor dalının antrenörlüğünü yapıyorsa o sporun yönetim ve kural bilgisine sahip olmasıdır.","Antrenörlerin kendini anlama, iç gözlem ve düşünme yeteneğidir.","Antrenörün temel teknik ve taktik bilgisine ve spor dalının öğretim bilgisine sahip olmasıdır.","Antrenörün sporcularının kapasitelerini ve gelişim dönemlerini, sporcuların motivasyonlarını bilmesine yönelik bilgileri içerir."],"answer":2,"explanation":"İçsel alan bilgisi, antrenörün kendini anlaması, iç gözlem yapması ve düşünmesidir. Başkalarıyla olumlu ilişki kurma kişilerarası bilgiye; teknik, taktik ve öğretim bilgisi ise profesyonel alan bilgisine girer.","source":{"questionPage":20,"answerPage":22,"pages":[15],"section":"Antrenörlerin Bilgi Kaynakları ve Yeterlikleri – Öğrenme Çıktısı Özeti","evidence":"İçsel alan bilgisi ise antrenörün kendini anlama, iç gözlem yapma ve düşünme yeteneğini ifade eder."},"kind":"book"},{"id":"ogrenme-1-2","courseId":"ogrenme","chapter":1,"chapterTitle":"Antrenörlük Mesleğine Giriş II – 2. Kademe","number":2,"stem":"Aşağıdakilerden hangisi antrenörlük bilgilerinin spor ortamının amaçlarına göre kullanılmasında gerekli olan yetkinliklerden biri değildir?","options":["Vizyon ve strateji oluşturmak","Çevresel düzenlemeler yapmak","Spor ortamının paydaşları ile iyi ilişkiler kurmak","Antrenör ve yönetim merkezli bir yaklaşım izlemek","Öğrenmeye açık olmak ve yansıma yapabilmek"],"answer":3,"explanation":"Kitapta yetkinliklerin odağı sporcuların performansını ve kişisel gelişimini artırmaktır. Vizyon oluşturma, çevreyi düzenleme, ilişki kurma ve öğrenerek yansıma yapma bu yetkinliklerdendir; yaklaşımın sporcu merkezli olması beklenir.","source":{"questionPage":20,"answerPage":22,"pages":[4],"section":"Antrenörlük Bilgilerinin Spor Ortamının Amaçlarına Göre Kullanılması","evidence":"Antrenörler sporcu merkezli bir yaklaşım izleyerek birlikte çalıştığı kişilerin dürüstlüğüne ve bireyselliğine saygı göstermelidir."},"kind":"book"},{"id":"ogrenme-1-4","courseId":"ogrenme","chapter":1,"chapterTitle":"Antrenörlük Mesleğine Giriş II – 2. Kademe","number":4,"stem":"Uzun süreli sporcu gelişimi modeli ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["Model bireyin spora katılımını ve gelişimini fiziksel gelişim ve olgunlaşma gibi unsurlarla açıklar.","Bir model bireyin psikososyal gelişim özelliklerini daha çok baskın tutarak tasarlanmıştır.","Modele göre biyolojik gelişim süreçlerine bağlı olarak sporcuların ihtiyacı olan antrenman içerikleri belirlenir.","Antrenörler modeli uygularken sporcularının biyolojik olarak gelişmesine uygun bireyselleştirilmiş antrenman etkinlikleri seçmelidir.","Antrenörler küçük yaştaki çocuklara beden okur-yazarlığı kazandırmak için çeşitli hareket becerilerini geliştirebileceği etkinlikler sunmalıdır."],"answer":1,"explanation":"Uzun süreli sporcu gelişimi modeli biyolojik gelişim ve olgunlaşmayı temel alır; antrenman içerikleri bu süreçlere göre belirlenir. Psikososyal gelişim özelliklerinin ön planda tutulması ise kitapta spora katılımın gelişimsel modeline ait bir özellik olarak açıklanır.","source":{"questionPage":20,"answerPage":22,"pages":[7,22],"section":"Uzun Süreli Sporcu Gelişimi Modeli; Araştır 2 Yanıtı","evidence":"Modele göre biyolojik gelişim süreçlerine bağlı olarak sporcuların ihtiyacı olan antrenman içerikleri belirlenir."},"kind":"book"},{"id":"ogrenme-1-5","courseId":"ogrenme","chapter":1,"chapterTitle":"Antrenörlük Mesleğine Giriş II – 2. Kademe","number":5,"stem":"Aşağıdakilerden hangisi etkili bir antrenörlük için gerekli olan güvenli sosyal ve fiziksel çevre oluşturmada antrenörlerin dikkat etmesi gereken unsurlardan biri değildir?","options":["Akran zorbalığı gibi istenmeyen durumların önüne geçilirken olumlu bir iklim oluşturmak","Çevredeki fiziksel olarak risk oluşturabilecek potansiyel unsurları en aza indirmek","Spor ortamının fiziksel olarak kontrollerini her hafta mutlaka yapmak","Sporculara birbirleri ile olumlu bir ilişki ortamı kurmasını sağlamak","Sporun uygulanması sırasında herhangi bir güvenlik ekipmanına gerek varsa bunun ulaşılabilir olmasını sağlamak"],"answer":2,"explanation":"Fiziksel ortamın kontrolü haftalık aralıkla sınırlandırılmaz; kitap kontrollerin antrenmanlar öncesinde yapılmasını ister. Risklerin azaltılması, olumlu ilişkiler ve erişilebilir güvenlik ekipmanı güvenli çevrenin diğer unsurlarıdır.","source":{"questionPage":20,"answerPage":22,"pages":[9],"section":"Güvenli Sosyal ve Fiziksel Çevre Oluşturma","evidence":"Antrenörler tarafından spor ortamının fiziksel olarak kontrolleri antrenmanlar öncesinde mutlaka yapılmalı, gerekli önlemler alınmalıdır."},"kind":"book"},{"id":"ogrenme-1-7","courseId":"ogrenme","chapter":1,"chapterTitle":"Antrenörlük Mesleğine Giriş II – 2. Kademe","number":7,"stem":"Aşağıdakilerden hangisi otokratik antrenörlük stilinin özelliklerinden biri değildir?","options":["Antrenörlerin kararlarını genellikle kendi başlarına almaları","Sporcuların fikrinin nadiren alınması veya hiç alınmaması","Kazanmaya odaklı olması ve tipik olarak esnek olmayan eğitim yapılarına sahip olması","Takım sporlarında bireysel sporlardan daha iyi çalışması","Sporcu merkezli olması"],"answer":4,"explanation":"Otokratik stilde kararları genellikle antrenör verir ve sporculardan az fikir alınır. Bu nedenle sporcu merkezli olmak otokratik stilin tanımlayıcı özelliği değildir.","source":{"questionPage":21,"answerPage":22,"pages":[11],"section":"Otokratik Antrenörlük Stili","evidence":"genellikle kendi başlarına alırlar veya çok az sporcudan fikir alırlar."},"kind":"book"},{"id":"ogrenme-2-1","courseId":"ogrenme","chapter":2,"chapterTitle":"Beceri Öğrenimi II","number":1,"stem":"Fitts ve Posner’a göre aşağıda belirtilen özelliklerden hangisi ilişkilendirme aşamasında gözlemlenir?","options":["Hareket kalıbının detaylandırılması","Hareket kalıbının oluşturulması","Hareket üretiminin nerdeyse otomatik olması","Hareketle ilintili düşüncenin oluşması","Hareketin sabitlenmesi"],"answer":0,"explanation":"Fitts ve Posner modelinde ilişkilendirme aşaması hareket kalıbının detaylandırıldığı aşamadır. Temel kalıbın oluşturulması bilişsel aşamaya, hareketin neredeyse otomatikleşmesi özerk aşamaya aittir.","source":{"questionPage":45,"answerPage":46,"pages":[26],"section":"Fitts ve Posner’in Üç Aşamalı Öğrenme Modeli – Şekil 2.1","evidence":"İlişkilendirme Aşaması"},"kind":"book"},{"id":"ogrenme-2-2","courseId":"ogrenme","chapter":2,"chapterTitle":"Beceri Öğrenimi II","number":2,"stem":"Gentile’ye göre kapalı becerilerin öğretilmesinde antrenörlerin hangi uygulamayı yapması önerilir?","options":["Çeşitleme","Detaylandırma","Sabitleme","Değişkenleştirme","Serbestlik derecesini arttırma"],"answer":2,"explanation":"Gentile’ye göre kapalı becerilerde hareketin tutarlı ve doğru biçimde aynı kalıpla tekrarlanması, yani sabitleme amaçlanır. Sürekli değişen çevrede yapılan açık becerilerde ise çeşitleme kullanılır.","source":{"questionPage":45,"answerPage":46,"pages":[27],"section":"Gentile’nin İki Aşamalı Modeli – Sabitleme/Çeşitleme","evidence":"sporcunun bu beceriyi tutarlı ve doğru bir şekilde sürekli aynı olacak şekilde tekrar etmesi gereklidir (Sabitleme)."},"kind":"book"},{"id":"ogrenme-2-3","courseId":"ogrenme","chapter":2,"chapterTitle":"Beceri Öğrenimi II","number":3,"stem":"“Kayak öğrenen bir kişinin hareketleri çok kaba ve daha çok robota benzemektedir” verilen bilgiye göre bu durumda bu kişi Bernstein’in öğrenme yaklaşımına göre hangi aşamadadır?","options":["Serbestlik derecesini azaltma","Pasif Dinamiklerden yararlanma","Temel hareket kalıbının detaylandırılması","İlişkilendirme","Otonom"],"answer":0,"explanation":"Bernstein’in ilk aşamasında sporcu kontrolü kolaylaştırmak için gereksiz vücut parçalarının hareketini sınırlar ve serbestlik derecelerini azaltır. Kitap bu aşamadaki hareketleri düz, estetik olmayan ve robot hareketlerine benzeyen hareketler olarak betimler.","source":{"questionPage":45,"answerPage":46,"pages":[28],"section":"Bernstein’nin Üç Aşamalı Modeli – Serbestlik Derecesini Azaltma","evidence":"Bu aşamada sporcunun hareketleri “robot”un hareketleri gibi çok düz ve estetik değildir."},"kind":"book"},{"id":"ogrenme-2-4","courseId":"ogrenme","chapter":2,"chapterTitle":"Beceri Öğrenimi II","number":4,"stem":"Beceri gösterimi yapılırken becerinin neden önemli olduğu ve bu beceriyi öğrenmelerinin sporcular için ne işe yarayacağının anlatılması aşağıdakilerinden hangisini sağlar?","options":["Ortamı sakinleştirir","Motivasyonu ve istekleri arttırır","Hiçbir etkisi yoktur","Sporcuların ilgileri dağılır","Antrenörün ilgisi artar"],"answer":1,"explanation":"Becerinin niçin önemli olduğunu ve sporcuya ne sağlayacağını açıklamak öğrenme isteğini ve motivasyonu artırır. Kitap bunu becerinin gösterimi sırasında dikkat edilmesi gereken bir nokta olarak vurgular.","source":{"questionPage":45,"answerPage":46,"pages":[30],"section":"Becerinin Gösterimi","evidence":"Böylelikle motivasyon ve istekleri artabilecektir."},"kind":"book"},{"id":"ogrenme-2-5","courseId":"ogrenme","chapter":2,"chapterTitle":"Beceri Öğrenimi II","number":5,"stem":"Mekansal doğruluk gerektiren becerileri öğretirken ilk aşamada antrenörlerin hangi alıştırma yöntemini kullanmaları daha iyi olur?","options":["Rastgele","Değişken","Seri","Farklılaştırılmış","Blok"],"answer":4,"explanation":"Kitap, mekânsal doğruluk gerektiren becerilerin ilk uygulanmasında blok alıştırmayı; geliştirilme aşamasında rastgele alıştırmayı önerir. Blok alıştırmada beceriler gruplar hâlinde tekrarlanır.","source":{"questionPage":45,"answerPage":46,"pages":[31],"section":"Alıştırmanın Programlanması","evidence":"özellikle becerinin ilk defa uygulanmasında blok alıştırma, geliştirilme aşamasında ise rastgele alıştırma kullanılması önerilebilir."},"kind":"book"},{"id":"ogrenme-3-1","courseId":"ogrenme","chapter":3,"chapterTitle":"Hareket Eğitimi ve Oyun II","number":1,"stem":"Koordinasyon gelişimi planlanırken ritim yetisini gelişimi için hem hareketin ritmini hem de dışarıdan gelen ritmin algılanması gerekmektedir. Ritim yetisi hangi yaş aralığında gelişir?","options":["5-8 yaş aralığı","6-15 yaş aralığı","4-11 yaş aralığı","5-15 yaş aralığı","8-11 yaş aralığı"],"answer":1,"explanation":"Kitapta ritim yetisinin gelişim yaşı 6-15 olarak verilir; gelişimin en hızlı olduğu aralık ise 8-9 yaştır. Soruda genel gelişim aralığı sorulduğu için 6-15 seçilir.","source":{"questionPage":73,"answerPage":75,"pages":[53],"section":"Ritim Yetisi","evidence":"Ritim özelliğinin gelişim yaşı 6-15 yaş olarak bilinmektedir. En hızlı geliştiği 8-9 yaş aralığındadır."},"kind":"book"},{"id":"ogrenme-3-2","courseId":"ogrenme","chapter":3,"chapterTitle":"Hareket Eğitimi ve Oyun II","number":2,"stem":"Mekân algılama, hareketin boyutunu kavrama anlamına gelmektedir. Aynı zamanda uyaranlarla eş güdüm içerisinde çalışır.\nYukarıdaki bilgiye göre aşağıdakilerden hangisi mekân algısının uyaranlarıdır?","options":["İşitsel –görsel uyaranlar","Görsel uyaranlar","Kinestetik uyaranlar","Bedensel uyaranlar","Dokunsal-İşitsel uyaranlar"],"answer":0,"explanation":"Mekân uyumu, hareketin en, boy ve yükseklik boyutlarını kavramaktır. Kitap bu yetinin işitsel ve görsel uyaranlarla beslendiğini belirtir.","source":{"questionPage":73,"answerPage":75,"pages":[53],"section":"Oryantasyon Yetisi (Mekân Uyumu)","evidence":"İşitsel ve görsel uyaranlarla beslenir."},"kind":"book"},{"id":"ogrenme-3-5","courseId":"ogrenme","chapter":3,"chapterTitle":"Hareket Eğitimi ve Oyun II","number":5,"stem":"İnsan vücudunun dengesini belli bir yerde ya da pozisyonda sağlanmasına ne ad verilir?","options":["Dinamik denge","Statik denge","Objeyi dengeleme","Nesneyi dengeleme","Hareketli denge"],"answer":1,"explanation":"Belli bir yerde ya da pozisyonda dengeyi korumak statik dengedir. Hareket sırasında denge sağlamak dinamik denge, ek bir araçla çalışırken denge sağlamak ise objeyle dengeleme olarak açıklanır.","source":{"questionPage":73,"answerPage":75,"pages":[53],"section":"Denge Yetisi","evidence":"Statik Denge: İnsan vücudunun dengesinin belli bir yerde ya da pozisyonda sağlanmasıdır."},"kind":"book"},{"id":"ogrenme-3-6","courseId":"ogrenme","chapter":3,"chapterTitle":"Hareket Eğitimi ve Oyun II","number":6,"stem":"Mücadele oyunlarında en çok kullanılan motorik özellik aşağıdakilerden hangisidir?","options":["Kuvvet","Çabukluk","Dayanıklılık","Esneklik","Koordinasyon"],"answer":0,"explanation":"Mücadele oyunlarında karşı kuvvete veya dirence karşı koyulduğu için temel vurgu kuvvettir. Kitap halat çekme ve turp çıkarma gibi oyunları örnek verir.","source":{"questionPage":73,"answerPage":75,"pages":[64],"section":"Oyunların Kuvvet Gelişimine Etkisi","evidence":"Mücadele oyunlarında ilk akla gelen özellik kuvvet özelliğidir."},"kind":"book"},{"id":"ogrenme-3-7","courseId":"ogrenme","chapter":3,"chapterTitle":"Hareket Eğitimi ve Oyun II","number":7,"stem":"Hareketlilik-Esneklik motorik özelliğini aşağıdakilerden hangisi daha çok geliştirir?","options":["Koşmalı - kovalamalı oyunlar","İtmeli - çekmeli oyunlar","Atmalı - atlamalı oyunlar","Eğilmeli, sürünmeli, köprülü oyunlar","Boğuşmalı oyunlar"],"answer":3,"explanation":"Eğilme, sürünme, gövdeyi farklı yönlere çevirme ve köprü gibi hareketler esnekliği geliştirir. Kitap oyunlara takla, köprü ve engellerin içinden geçme eklenmesini esnekliği geliştirmeye örnek gösterir.","source":{"questionPage":73,"answerPage":75,"pages":[65],"section":"Oyunların Esneklik-Hareketlilik Gelişimine Etkisi","evidence":"Bütün bu faaliyetler esnekliği geliştirir ve pekiştirir."},"kind":"book"},{"id":"ogrenme-4-1","courseId":"ogrenme","chapter":4,"chapterTitle":"Motor Gelişim II","number":1,"stem":"Bireysel ve çevresel faktörlere bağlı olarak zaman içinde bireylerde meydana gelen değişiklikler bütününe ne ad verilir?","options":["Değişim","Büyüme","Gelişim","Olgunlaşma","Öğrenim"],"answer":2,"explanation":"Gelişim, bireysel ve çevresel etkenlerle zaman içinde oluşan değişikliklerin bütünüdür. Kitap bu değişimlerin yaşam boyu sürdüğünü, sistematik ve devamlı olduğunu vurgular.","source":{"questionPage":99,"answerPage":101,"pages":[79],"section":"Gelişim Modellerinin Sınıflaması","evidence":"Gelişim, bireysel ve çevresel faktörlere bağlı olarak zaman içinde bireylerde meydana gelen değişiklikler bütünüdür."},"kind":"book"},{"id":"ogrenme-4-2","courseId":"ogrenme","chapter":4,"chapterTitle":"Motor Gelişim II","number":2,"stem":"Aşağıdakilerden hangisi Sigmund Freud ve Erik Erikson’un teorilerini kategorize etmek için kullanılan tanımlamadır?","options":["Psikodinamik teoriler","Davranışsal teoriler","Sistem teorileri","Biyoloji temelli teoriler","Bilişsel gelişim teorileri"],"answer":0,"explanation":"Freud’un psikoanalitik ve Erikson’un psikososyal teorileri kitapta psikodinamik teoriler başlığı altında ele alınır. Erikson, Freud’dan yararlanırken sosyal etkileşimi ve yaşam boyu gelişim dönemlerini de vurgular.","source":{"questionPage":99,"answerPage":101,"pages":[80],"section":"Psikodinamik Teoriler","evidence":"Erik Erikson ise Freud’un teorisinden yararlanarak kendi teorisini ortaya koymuştur."},"kind":"book"},{"id":"ogrenme-4-3","courseId":"ogrenme","chapter":4,"chapterTitle":"Motor Gelişim II","number":3,"stem":"Aşağıdaki modellerden hangisinde merkezi sinir sisteminin motor gelişim üzerindeki etkisine çoğunlukla vurgu yapılmaktadır?","options":["Gelişimsel Model","Kum Saati Modeli","Motor Gelişim Dağı Modeli","Gelişimsel Mekanizmalar Modeli","Motor Yeterlik Seviyesi İlerleme Modeli"],"answer":0,"explanation":"Seaman ve Paul’un Gelişimsel Modeli doğuştan gelen sinirsel kapasitenin motor gelişimdeki etkisini öne çıkarır. Modelde merkezi sinir sistemi hasarının motor gelişim gerilikleriyle ilişkisi açıklanır.","source":{"questionPage":99,"answerPage":101,"pages":[85],"section":"Gelişimsel Model","evidence":"Doğuştan gelen sinirsel kapasitenin motor gelişimi etkileyen en önemli etken olduğunu gösteren Gelişimsel Model"},"kind":"book"},{"id":"ogrenme-4-4","courseId":"ogrenme","chapter":4,"chapterTitle":"Motor Gelişim II","number":4,"stem":"Fiziksel aktiviteye veya spora katılmak için gerekli olan motor becerilere sahip olma durumu aşağıdakilerden hangisi ile ifade edilmektedir?","options":["Algısal motor yeterlik","Motor yeterlik","Fiziksel uygunluk","Koordinasyon","Fiziksel aktivite seviyesi"],"answer":1,"explanation":"Motor yeterlik, aktiviteye veya spora katılmak için gereken motor becerilere sahip olmaktır. Algısal motor yeterlik ise kişinin bu yeterliği hakkındaki farkındalığı veya inancıdır.","source":{"questionPage":99,"answerPage":101,"pages":[90],"section":"Gelişimsel Mekanizmalar Modeli – Kavram Tanımları","evidence":"Motor Yeterlik: Fiziksel aktiviteye veya spora katılmak için gerekli olan motor becerilere sahip olma durumudur"},"kind":"book"},{"id":"ogrenme-4-5","courseId":"ogrenme","chapter":4,"chapterTitle":"Motor Gelişim II","number":5,"stem":"Aşağıdakilerden hangisinde Gelişimsel Mekanizmalar Modeli’nde belirtilen ve birbirleriyle dinamik etkileşime giren faktörler birlikte ve doğru şekilde verilmiştir?","options":["Motor yeterlik, algısal motor yeterlik ve fiziksel uygunluk","Motor yeterlik, algısal motor yeterlik ve fiziksel aktivite","Motor yeterlik, fiziksel aktivite ve fiziksel uygunluk","Fiziksel aktivite, fiziksel uygunluk, algısal motor yeterlik","Motor yeterlik, algısal motor yeterlik, fiziksel uygunluk ve fiziksel aktivite"],"answer":4,"explanation":"Model dört unsur arasındaki dinamik ilişkiyi ele alır: motor yeterlik, algısal motor yeterlik, fiziksel aktivite ve fiziksel uygunluk. İlk dört seçenek bu unsurlardan birini eksik bırakır.","source":{"questionPage":99,"answerPage":101,"pages":[89,90],"section":"Gelişimsel Mekanizmalar Modeli – Şekil 4.8","evidence":"Motor yeterlik, algısal motor yeterlik, fiziksel aktivite ve fiziksel uygunluk arasında dinamik bir ilişki vardır."},"kind":"book"},{"id":"ogrenme-5-1","courseId":"ogrenme","chapter":5,"chapterTitle":"Ölçme ve Değerlendirme II","number":1,"stem":"Aşağıdakilerden hangisinde hata türü ve örneği yanlış eşleştirilmiştir?","options":["Tesadüfi hata – antrenörün maçın kadrosunu belirlerken velisini tanıdığı sporculara öncelik tanıması","Sabit hata - antrenörün sporcuların beceri düzeylerini ölçen bir rubrik kullanırken sporculara üç puan fazla vermesi","Tesadüfi hata – antrenörün sporculara sürat testi uygularken dikkatsiz davranması","Sabit hata – antrenörün sporcuların sürat testinde bozuk kronometre ile koşu sürelerini iki sn az ölçmesi","Sistematik hata – antrenörün sporcuların beceri düzeylerini ölçen bir rubrik kullanırken yaşı küçük sporculara fazla puan vermesi"],"answer":0,"explanation":"Velisini tanıdığı sporculara öncelik tanımak belirli bir koşula bağlı yanlılıktır; tesadüfi hata değildir. Kitapta tesadüfi hatanın yönü, miktarı ve kaynağı belli olmazken sistematik hata belirli ölçme koşullarına göre değişir.","source":{"questionPage":126,"answerPage":128,"pages":[105,106],"section":"Hata Türleri","evidence":"Sistematik hata: Ölçülen büyüklüğe ve ölçme koşullarına bağlı olarak sistematik bir biçimde değişkenlik gösteren hatadır."},"kind":"book"},{"id":"ogrenme-5-3","courseId":"ogrenme","chapter":5,"chapterTitle":"Ölçme ve Değerlendirme II","number":3,"stem":"Bir antrenör, sporcularına altı tane motorik beceri testi uygulamış ancak iki becerinin hiçbir sporcu tarafından doğru bir şekilde uygulanmadığını görmüştür. Bu sebeple antrenör bu iki testi puanlamaya dahil etmemiştir. Bu durum ölçümün geçerliğini nasıl etkiler?","options":["Test kolaylaştığı için geçerlik artar.","Yapılamayan testler puanlanmadığından geçerlik etkilenmez.","Test kapsamı daraldığı için geçerlik düşer.","Puanlama güvenirliği arttığı için geçerlik yükselir.","Geçerlik etkilenmez."],"answer":2,"explanation":"Geçerlik, ölçülmek istenen özelliğin tam ve doğru ölçülmesiyle ilgilidir. İki becerinin puanlamadan çıkarılması ölçülen kapsamı daraltır; kitabın cevap anahtarı bu nedenle geçerliğin düşeceğini belirtir.","source":{"questionPage":126,"answerPage":128,"pages":[107,128],"section":"Ölçmede Geçerlik; Neler Öğrendik Yanıt Anahtarı","evidence":"Geçerlik kavramı, bir ölçme aracının ölçmeyi amaçladığı özelliği, başka özelliklerle karıştırmadan tam ve doğru olarak ölçebilmesi anlamına gelir."},"kind":"book"},{"id":"ogrenme-5-4","courseId":"ogrenme","chapter":5,"chapterTitle":"Ölçme ve Değerlendirme II","number":4,"stem":"- Sporcuların uzan-eriş esneklik testinden aldığı puanların mm olarak hassas sonuçlar vermesi\n- Sporcuların uzan-eriş esneklik testinden bir hafta ara ile aldıkları iki sonucun benzer olması\nAşağıdaki özellikler uzan-eriş esneklik testinin hangi niteliği ile ilgilidir?","options":["Uyumlu","Ekonomik","Güvenilir","Kullanışlı","Geçerli"],"answer":2,"explanation":"Ölçme aracının farklı zamanlarda aynı özelliğe ilişkin aynı ya da çok benzer sonuçlar vermesi güvenirliğin göstergesidir. Sorudaki iki ölçümün benzerliği bu tutarlılığı anlatır.","source":{"questionPage":126,"answerPage":128,"pages":[106],"section":"Ölçmede Güvenirlik","evidence":"Bir ölçme aracının, hatalardan arınık biçimde tutarlı ölçümler yapması, o ölçme aracının güvenirlik düzeyini belirler."},"kind":"book"},{"id":"ogrenme-5-6","courseId":"ogrenme","chapter":5,"chapterTitle":"Ölçme ve Değerlendirme II","number":6,"stem":"Sporcularının tüm yüzme tekniklerine ilişkin beceri düzeylerini birlikte değerlendirmek isteyen bir yüzme antrenörünün aşağıdaki ölçme araçlarından hangisini kullanması daha uygun olur?","options":["Gözlem","Kontrol listesi","Niceliksel analitik rubrik","Niteliksel analitik rubrik","Bütüncül rubrik"],"answer":4,"explanation":"Bütüncül rubrikte ölçülecek özelliklerin tüm ölçütleri bir arada sunulur ve birlikte değerlendirilir. Soruda tüm tekniklere ilişkin beceri düzeylerinin beraber değerlendirilmesi istendiği için bütüncül rubrik seçilir.","source":{"questionPage":126,"answerPage":128,"pages":[111,125],"section":"Bütüncül Rubrikler","evidence":"Bütüncül rubrikler ise ölçülmek istenen özelliğe ilişkin tüm ölçütlerin bir arada verildiği"},"kind":"book"},{"id":"ogrenme-5-7","courseId":"ogrenme","chapter":5,"chapterTitle":"Ölçme ve Değerlendirme II","number":7,"stem":"Bir antrenörün kullandığı ölçme aracının başlıca özellikleri şöyledir;\n- Hedef becerilerden kaç tanesinin yapıldığını gösterir.\n- En belirgin gözlenebilecek davranışları içerir.\n- Performansın düzeyi hakkında bilgi vermese de performansın gerektirdiği davranışların gerçekleştirilip gerçekleştirilmediğini gösterir.\nYukarıda özellikleri verilen ölçme aracı aşağıdakilerden hangisidir?","options":["Kontrol listesi","Öz-değerlendirme","Grup değerlendirmesi","Dereceli puanlama anahtarı","Akran değerlendirme"],"answer":0,"explanation":"Kontrol listesi becerinin yapılıp yapılmadığını, gözlenip gözlenmediğini gibi ikili biçimde kaydeder. Özelliğe hangi derecede sahip olunduğunu göstermez; bu yönüyle dereceli puanlama anahtarından ayrılır.","source":{"questionPage":126,"answerPage":128,"pages":[108],"section":"Kontrol Listeleri","evidence":"Ölçülmek istenen özelliğe ne derece sahip olunduğuna ilişkin bilgi vermez; yalnızca o özelliğe sahip olunup olunmadığı bilgisini verir."},"kind":"book"},{"id":"ogrenme-6-1","courseId":"ogrenme","chapter":6,"chapterTitle":"Spor Pedagojisi II","number":1,"stem":"Aşağıdakilerden hangisinde öğretim tasarımının aşamaları sırasıyla ve doğru olarak verilmiştir?","options":["Tasarımlama - Uygulama - Geliştirme –Değerlendirme - Çözümleme","Tasarımlama - Geliştirme – Uygulama -Değerlendirme - Çözümleme","Çözümleme - Geliştirme – Uygulama -Tasarımlama - Değerlendirme","Çözümleme- Tasarımlama - Geliştirme – Uygulama -Değerlendirme","Çözümleme -Tasarımlama- Uygulama - Geliştirme -Değerlendirme"],"answer":3,"explanation":"Öğretim tasarımı sırasıyla çözümleme, tasarımlama, geliştirme, uygulama ve değerlendirmeden oluşur. Önce ihtiyaç belirlenir; hedefler ve içerik oluşturulduktan sonra uygulamaya ve sonuçların değerlendirilmesine geçilir.","source":{"questionPage":153,"answerPage":155,"pages":[131,132],"section":"Antrenörler İçin Öğretim Tasarımı – Şekil 6.1","evidence":"Çözümleme (ihtiyaç belirleme)"},"kind":"book"},{"id":"ogrenme-6-2","courseId":"ogrenme","chapter":6,"chapterTitle":"Spor Pedagojisi II","number":2,"stem":"Aşağıdaki öğretim yöntemlerinden hangisi sunuş yaklaşımı içerisinde yer almaz?","options":["Komut","Eşli çalışma","Kendini denetleme","Alıştırma","Öğrencinin tasarımı"],"answer":4,"explanation":"Sunuş stratejisi komut, alıştırma, eşli çalışma, kendini denetleme ve katılım yöntemlerini içerir. Öğrencinin tasarımı, I yöntemi olarak buluş stratejisinde yer alır.","source":{"questionPage":153,"answerPage":155,"pages":[133],"section":"Öğretim Yöntemleri – Şekil 6.2","evidence":"Öğrencinin tasarımı (I Yöntemi)"},"kind":"book"},{"id":"ogrenme-6-3","courseId":"ogrenme","chapter":6,"chapterTitle":"Spor Pedagojisi II","number":3,"stem":"Sunuş yaklaşımını temel alan yöntemlerden buluş yaklaşımını temel alan yöntemlere geçilirken ki noktaya “Buluş eşiği” denir.\nYukarıdaki açıklamaya dayanarak öğretim stilleri yelpazesinde ‘Buluş eşiği’ hangi iki öğretim yöntemi arasındadır?","options":["Komut – alıştırma","Kendini denetleme – katılım","Eşli – yönlendirilmiş buluş","Kendini denetleme – problem çözme","Katılım – yönlendirilmiş buluş"],"answer":4,"explanation":"Buluş eşiği, sunuş grubunun son yöntemi olan katılım (E) ile buluş grubunun ilk yöntemi olan yönlendirilmiş buluş (F) arasındadır. Bu eşikten sonra öğrenenin karar vermede daha etkin olduğu yöntemlere geçilir.","source":{"questionPage":153,"answerPage":155,"pages":[133],"section":"Öğretim Yöntemleri – Öğretim Stilleri Yelpazesi","evidence":"Katılım (E Yöntemi)"},"kind":"book"},{"id":"ogrenme-6-4","courseId":"ogrenme","chapter":6,"chapterTitle":"Spor Pedagojisi II","number":4,"stem":"Bir antrenör, antrenmanı sırasında sporcuları için aynı amaca uygun farklı zorluk düzeyinde alıştırmalar hazırlar. Sporcularından bir düzeyi çalıştıklarında ve başarılı olduklarında bir diğer düzeye geçerek, gittikçe hedefi yükseltmeleri ister.\nYukarıdaki örnekte antrenörün kullandığı öğretim yöntemi aşağıdakilerden hangisidir?","options":["Alıştırma","Kendini denetleme","Katılım","Yönlendirilmiş buluş","Problem çözme"],"answer":2,"explanation":"Katılım yönteminde aynı amaç için farklı güçlük düzeyleri hazırlanır. Sporcu kendi düzeyini seçer; başarılı olursa üst, zorlanırsa alt düzeyde çalışmaya devam edebilir.","source":{"questionPage":153,"answerPage":155,"pages":[139,140],"section":"Katılım Yöntemi (E Yöntemi)","evidence":"Sporcular bir beceriyi çalıştıklarında ve başarılı olduklarında bir diğer düzeye geçerek, gittikçe hedefi yükseltebilirler."},"kind":"book"},{"id":"ogrenme-6-5","courseId":"ogrenme","chapter":6,"chapterTitle":"Spor Pedagojisi II","number":5,"stem":"Bir antrenör spor salonunda sporcularının bir becerinin farklı bölümlerini ya da değişik becerileri çalışabilecekleri birkaç istasyon hazırlar. Sporcular istasyonlar arasında gelip giderler ve hareketleri kendi hızlarında yaparlar.\nYukarıdaki örnekte antrenörün kullandığı öğretim yöntemi aşağıdakilerden hangisidir?","options":["Komut","Alıştırma","Eşli","Yönlendirilmiş buluş","Problem çözme"],"answer":1,"explanation":"Alıştırma yönteminde hareketin zaman kontrolü ağırlıklı olarak sporcudadır. İstasyon çalışmaları bu yöntemin sık kullanılan tekniğidir; sporcular kendi hızlarında ve tekrar sayılarında çalışır.","source":{"questionPage":153,"answerPage":155,"pages":[134],"section":"Alıştırma Yöntemi (B Yöntemi)","evidence":"Yöntemin en sık antrenman ortamında kullandığı teknik istasyon çalışmalarıdır."},"kind":"book"},{"id":"psikososyal-1-1","courseId":"psikososyal","chapter":1,"chapterTitle":"Spor Tarihi II","number":1,"stem":"Eski Türk bozkır yaşam tarzında hangi fiziksel aktivitenin çok yönlü beceri gelişimine en fazla katkıyı sağladığı söylenebilir?","options":["Binicilik","Okçuluk","Avcılık","Güreş","Kayak"],"answer":2,"explanation":"Avcılık; değişen arazi, iklim ve hedeflere uyum sağlamayı, ata hâkim olmayı, okçuluğu ve grupla hareket etmeyi bir arada geliştiriyordu. Bu nedenle çok yönlü beceri gelişimi için kitapta öne çıkan etkinlik avcılıktır.","source":{"questionPage":34,"answerPage":35,"pages":[4],"section":"Spor Tarihi II","evidence":"Avcılık, sürekli değişkenlik gösteren karakteri sebebiyle binicilik ve okçuluk yeteneklerini gerek teknik gerekse taktik açıdan iyileştirmekteydi."},"kind":"book"},{"id":"psikososyal-1-2","courseId":"psikososyal","chapter":1,"chapterTitle":"Spor Tarihi II","number":2,"stem":"Selçuklu yayları ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["Bileşik yapıdadır.","Boyları kısadır.","Uzun süre kurulu kalabilir.","Yağmurdan etkilenmez.","Güç ve esnekliği ayarlanabilir."],"answer":3,"explanation":"Kitap, yağmurun ve kirişin ıslanmasının yayı kullanmayı zorlaştırdığını açıkça belirtir. Bu yüzden yağmurdan etkilenmediğini söyleyen D seçeneği yanlıştır.","source":{"questionPage":34,"answerPage":35,"pages":[9],"section":"Spor Tarihi II","evidence":"Yağmur, yayın baş düşmanıydı. Kirişi ıslanan yayı kullanmak hemen hemen imkânsızdı."},"kind":"book"},{"id":"psikososyal-1-3","courseId":"psikososyal","chapter":1,"chapterTitle":"Spor Tarihi II","number":3,"stem":"Aşağıdakilerden hangi okçuluk disiplini Osmanlı rekor okçuluğuna verilen addır?","options":["Darp atış","Puta atış","Kabak atış","Menzil atış","Ok koşusu"],"answer":3,"explanation":"Menzil atışı rekor kırma amacı taşır. Kitap ok koşularını yarışma ödülü kazanma, menzil atışlarını ise uzaklık rekoru hedefi bakımından ayırır.","source":{"questionPage":34,"answerPage":35,"pages":[16],"section":"Spor Tarihi II","evidence":"Menzil atışlarında amaç, rekor kırmak hedefiyle okun mümkün olabilecek en uzak mesafeye atılmasıdır."},"kind":"book"},{"id":"psikososyal-1-4","courseId":"psikososyal","chapter":1,"chapterTitle":"Spor Tarihi II","number":4,"stem":"Aşağıdakilerden hangisi Türkiye’de okul beden eğitiminde İsveç jimnastiğinin tercih edilme nedenlerinden biri değildir?","options":["Her öğrencinin yapabileceği ve katılım sağlayabileceği basamaklı yapısı","Öğretmenin sınıfın tamamına hakim olabilmesi","Jimnastik salonu ya da alet yetersizliği gibi sorunları barındırmaması","Açık ya da kapalı her ortamda yapılabiliyor olması","Hareketlerin toplu olarak değil bireysel olarak yapılması"],"answer":4,"explanation":"İsveç jimnastiğinin tercih edilmesinde hareketlerin toplu yapılabilmesi, sosyalleşme ve sınıf disiplinine katkısı vardır. Hareketlerin toplu değil bireysel yapılmasını gerekçe gösteren E seçeneği bu anlatımla uyuşmaz.","source":{"questionPage":34,"answerPage":35,"pages":[21],"section":"Spor Tarihi II","evidence":"Toplu yapılan hareketler öğrencilerin sosyalleşmesine yardımcı oluyor"},"kind":"book"},{"id":"psikososyal-1-5","courseId":"psikososyal","chapter":1,"chapterTitle":"Spor Tarihi II","number":5,"stem":"Aşağıdakilerden hangisi 19. yüzyılda Osmanlı Devleti’nde yabancıların kurduğu modern spor kulüplerinden biri değildir?","options":["İzmir At Yarışı Kulübü","Su Sporları Kulübü","Futbol ve Rugby Kulübü","İstanbul Jokey Kulübü","Hokey Kulübü"],"answer":4,"explanation":"Kitabın bu döneme ilişkin kulüpler anlatımında at yarışı, su sporları, futbol-ragbi ve golf kulüpleri yer alır. Hokey Kulübü bu listede bulunmadığı için aranan seçenektir.","source":{"questionPage":34,"answerPage":35,"pages":[22,23],"section":"Spor Tarihi II","evidence":"1864’te İstanbul’da Jokey Kulübü kurulmuştur."},"kind":"book"},{"id":"psikososyal-2-1","courseId":"psikososyal","chapter":2,"chapterTitle":"Spor Sosyolojisi II","number":1,"stem":"Sınıf sistemleri içerisinde akışkanlık söz konusudur ve spor aracılığıyla dikey hareketlilik gerçekleşebilmektedir.\n\nYukarıdaki bilgiye göre, aşağıdakilerden hangisi spor aracılığıyla gerçekleşen dikey hareketliliğe bir örnektir?","options":["Okul takımına seçilmek","Mahalleler arası turnuvada gol kralı/kraliçesi olmak","Oynadığı ilçedeki amatör basketbol takımından ildeki amatör basketbol takımına transfer olmak","Amatör takımdan, profesyonel sözleşme imzalayarak profesyonel lige transfer olmak","Spor okulundan kulüp takımı alt yapısına geçiş yapmak"],"answer":3,"explanation":"Dikey hareketlilik toplumsal konum ve gelirde değişim içerir. Amatörlükten profesyonel sözleşmeye geçiş bu ölçütü karşılar; sadece aynı düzeyde takım değiştirmek aynı anlama gelmez.","source":{"questionPage":61,"answerPage":63,"pages":[40],"section":"Spor Sosyolojisi II","evidence":"dikey hareketlilik aşağı veya yukarıya doğru gerçekleştiğinde kişinin pozisyonunda, gelirinde farklılıklar meydana gelmektedir"},"kind":"book"},{"id":"psikososyal-2-2","courseId":"psikososyal","chapter":2,"chapterTitle":"Spor Sosyolojisi II","number":2,"stem":"Sosyolojik bir kurum olarak ------- bünyesinde ekonomik eşitsizlikleri, sınıf ilişkilerini ve büyük çaplı toplumsal hareketliliği de barındırmaktadır.\n\nYukarıdaki cümlede boş bırakılan yeri aşağıdakilerden hangisi doğru bir şekilde tamamlar?","options":["Kültür","İmaj","İdeoloji","Sosyalizasyon","Spor"],"answer":4,"explanation":"Cümle, sporun toplumsal sınıf ve ekonomik eşitsizliklerle ilişkisini tanımlar. Kitaptaki ifadede boşluğun karşılığı doğrudan spordur.","source":{"questionPage":61,"answerPage":63,"pages":[39],"section":"Spor Sosyolojisi II","evidence":"Sosyolojik bir kurum olarak spor, bünyesinde ekonomik eşitsizlikleri, sınıf ilişkilerini ve büyük çaplı toplumsal hareketliliği barındırmaktadır."},"kind":"book"},{"id":"psikososyal-2-3","courseId":"psikososyal","chapter":2,"chapterTitle":"Spor Sosyolojisi II","number":3,"stem":"David Rowe’un alt ve üst sınıflara mensup olanların ilgilendiğini ifade ettiği spor dalları aşağıdakilerden hangisinde birlikte ve doğru olarak verilmiştir?","options":["Ragbi-Tenis","Boks-Artistik Patinaj","Golf-Basketbol","Bisiklet-Su Topu","Halter-Hentbol"],"answer":0,"explanation":"Soruda sıra alt sınıf, ardından üst sınıftır. Rowe’un kitapta aktarılan örneklerine göre ragbi ve tenis bu sırayı doğru karşılar.","source":{"questionPage":61,"answerPage":63,"pages":[42],"section":"Spor Sosyolojisi II","evidence":"Rowe, üst sınıflara mensup olarak yapılan sporlara tenis ve golfu örnek gösterirken, daha alt sınıflara mensup olanlar için ise boks ve ragbiyi örnek göstermektedir."},"kind":"book"},{"id":"psikososyal-2-4","courseId":"psikososyal","chapter":2,"chapterTitle":"Spor Sosyolojisi II","number":4,"stem":"Şiddetle bağlantılı sportif karşılaşmalar genel olarak ------- olarak yapılmakta olanlardır.\n\nYukarıdaki cümlede boş bırakılan yeri aşağıdakilerden hangisi doğru bir şekilde tamamlar?","options":["amatör","tek","takım","profesyonel","kitlesel"],"answer":2,"explanation":"Kitap, rekabet, rakip takım algısı ve fiziksel temas bağlamında takım karşılaşmalarını ele alır. Bu soru o anlatımdaki genellemeyi sorar; bütün takım müsabakalarının şiddet içerdiği anlamına gelmez.","source":{"questionPage":61,"answerPage":63,"pages":[47],"section":"Spor Sosyolojisi II","evidence":"Saldırganlık ve şiddet; zaman zaman bazı spor dalları, özellikle takım sporları ile anılır bir hale dönüşmüştür."},"kind":"book"},{"id":"psikososyal-2-5","courseId":"psikososyal","chapter":2,"chapterTitle":"Spor Sosyolojisi II","number":5,"stem":"Aşağıdakilerden hangisi Jay Coakley tarafından stadyumlarda şiddeti azaltmaya yönelik olarak ortaya konulan önlemler ve önerilerden biri değildir?","options":["Seyircilerin ihtiyaçları ve haklarını bilmenin yanı sıra buna saygı göstermek gerekir.","Kalabalığı kontrol etmekle görevli personelin, potansiyel taşkın hareketlere müdahale etme şekli bakımından eğitilmesi gerekir.","Seyirciler sürü/toplu halde getirilmeye çalışılmamalıdır.","Çıkış kapıları kolay ulaşılabilir olmalı ve açık bir şekilde gösterilmelidir.","Bireysel maç seyretme alışkanlığı özendirilmelidir."],"answer":4,"explanation":"Kitapta önerilen, ailece maç seyretmenin teşvik edilmesidir. Bireysel maç seyretme alışkanlığını özendirmek aynı öneri değildir ve bu nedenle E seçeneği listede yer almaz.","source":{"questionPage":61,"answerPage":63,"pages":[50],"section":"Spor Sosyolojisi II","evidence":"Son dönemde artan ailece maç seyretme uygulaması kulüpler tarafından teşvik edilmelidir."},"kind":"book"},{"id":"psikososyal-3-1","courseId":"psikososyal","chapter":3,"chapterTitle":"Spor Psikolojisi II","number":1,"stem":"Aşağıdakilerden hangisi dışa dönük kişilik özelliğidir?","options":["Güvenli","Çalışkan","Duygusal","Girişken","Yenilikçi"],"answer":3,"explanation":"Girişkenlik, kitapta dışa dönük kişiliğin özellikleri arasında sayılır. İçe dönük özellikler ise sessizlik ve çekingenlik gibi ifadelerle ayrıca açıklanır.","source":{"questionPage":86,"answerPage":88,"pages":[68],"section":"Spor Psikolojisi II","evidence":"Dışa dönük bireyler; girişken, enerjik ve baskın karakterlidirler."},"kind":"book"},{"id":"psikososyal-3-3","courseId":"psikososyal","chapter":3,"chapterTitle":"Spor Psikolojisi II","number":3,"stem":"Morgan’ın kişilik araştırmaları çerçevesinde ortaya attığı Buz Dağı profili ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["Sporcuların duygu durumlarının incelenmesi sonucu geliştirilmiştir.","Başarılı ve başarısız sporcuyu ayırt eden en önemli olgu, sporcuların duygu durumlarıdır.","Başarılı sporcuların duygu durum profilleri başarısız sporcularla karşılaştırıldığında buz dağı şeklindedir.","Başarılı sporcular olumsuz duygulanımlarda düşük, olumlu duygulanımlarda yüksek puanlara sahiptir.","Başarısız sporcular olumsuz duygulanımlarda düşük, olumlu duygulanımlarda yüksek puanlara sahiptir."],"answer":4,"explanation":"Buz Dağı profilinde başarılı sporcular olumlu duygu durumlarında yüksek, olumsuz duygu durumlarında düşük görünür. E seçeneği bu örüntüyü başarısız sporculara yüklediği için yanlıştır.","source":{"questionPage":86,"answerPage":88,"pages":[70],"section":"Spor Psikolojisi II","evidence":"başarılı sporcuların duygu durumları buzdağını andırır"},"kind":"book"},{"id":"psikososyal-3-4","courseId":"psikososyal","chapter":3,"chapterTitle":"Spor Psikolojisi II","number":4,"stem":"Aşağıdakilerden hangisi katılımcı güdülenmesini etkileyen kişisel faktörlerden biri değildir?","options":["İhtiyaçlar","İlgiler","Kazanma","Hedefler","Kişilik"],"answer":2,"explanation":"Şekilde kişisel faktörler ihtiyaçlar, ilgiler, hedefler ve kişilik olarak verilir. Kazanma-kaybetme oranı durumsal faktörlerdendir; bu nedenle kazanma kişisel faktör listesinin dışındadır.","source":{"questionPage":86,"answerPage":88,"pages":[72],"section":"Spor Psikolojisi II","evidence":"Kişisel Faktörler İhtiyaçlar İlgiler"},"kind":"book"},{"id":"psikososyal-3-5","courseId":"psikososyal","chapter":3,"chapterTitle":"Spor Psikolojisi II","number":5,"stem":"Kaan bir başka kişi ya da neden olmadan kendi hür iradesi ile spora katılmakta ve bundan haz almaktadır. Kaan’ın ------- olarak güdülendiği söylenebilir.\n\nYukarıdaki cümlede boş bırakılan yeri aşağıdakilerden hangisi doğru şekilde tamamlar?","options":["dışsal","içsel","dışsal düzenleme","içeatım","özdeşimle düzenleme"],"answer":1,"explanation":"Kaan’ın kendi isteğiyle ve etkinlikten haz aldığı için katılması içsel güdülenmedir. Davranışın dış ödül veya başka kişilerin baskısıyla yönlendirilmesi anlatılmamaktadır.","source":{"questionPage":86,"answerPage":88,"pages":[73,74],"section":"Spor Psikolojisi II","evidence":"İçsel güdülenmede kişiler aktiviteye eğlence, ilgi ve memnuniyet duygusundan dolayı katılırlar."},"kind":"book"},{"id":"psikososyal-3-7","courseId":"psikososyal","chapter":3,"chapterTitle":"Spor Psikolojisi II","number":7,"stem":"Hür irade kuramında dışsal güdülenme biçimlerinin farklı biçimde ele alındığı görülmektedir. Bireyin davranışlarının dışsal kaynaklar tarafından kontrol edilmesi ve kişinin spora katılım nedeninin daha çok başkalarının baskıları, ödül, saygı görme isteği olması -------, içsel baskı, utanç duygusundan dolayı aktiviteye katılması -------, bireyin, davranışı önemli olarak değerlendirmesi, katılımının kişisel gelişimine katkıda bulunduğuna inanması ve bunun için aktiviteye katılması ------- olarak ifade edilmektedir.\n\nYukarıdaki paragrafı aşağıdakilerden hangisi doğru şekilde ve sırasıyla tamamlar?","options":["Dışsal Düzenleme, Özdeşimle Düzenleme, İçeatım","İçeatım, Özdeşimle Düzenleme, Dışsal Düzenleme","Özdeşimle Düzenleme, Dışsal Düzenleme, İçeatım","Dışsal Düzenleme, İçeatım, Özdeşimle Düzenleme","Özdeşimle Düzenleme, İçeatım, Dışsal Düzenleme"],"answer":3,"explanation":"Başkalarının baskısı ve ödül dışsal düzenleme; iç baskı ve utanç içeatım; davranışı önemli bulup kişisel gelişime katkısına inanma özdeşimle düzenlemedir. Sıralama D seçeneğindeki gibidir.","source":{"questionPage":87,"answerPage":88,"pages":[74],"section":"Spor Psikolojisi II","evidence":"Bunlar; dışsal düzenleme, içeatım ve özdeşimle düzenlemedir."},"kind":"book"},{"id":"psikososyal-4-1","courseId":"psikososyal","chapter":4,"chapterTitle":"Sporda Fair Play II","number":1,"stem":"Aşağıdakilerden hangisi fair play uygulamalarından biri değildir?","options":["İşbirliği-Takım arkadaşlığı aktiviteleri","Empati Eğitimi","Fair play oyunları","Fair playi konuşma","Teknik-taktik çalışmalar"],"answer":4,"explanation":"Kitap fair play eğitiminde iş birliği, yardımlaşma, duyguları kabullenme ve örnek olayları tartışma gibi uygulamalar verir. Teknik-taktik çalışma tek başına bu eğitim uygulamaları listesindeki bir yöntem değildir.","source":{"questionPage":119,"answerPage":121,"pages":[105,106],"section":"Sporda Fair Play II","evidence":"antrenörlerin sporcularına fair play öğretiminde kullanabilecekleri farklı uygulamalar bulunmaktadır"},"kind":"book"},{"id":"psikososyal-4-2","courseId":"psikososyal","chapter":4,"chapterTitle":"Sporda Fair Play II","number":2,"stem":"Bir antrenörün sporcusuna empatik duyarlılıkla yaklaşımında aşağıdakilerden hangisi yer almaz?","options":["Sporcusunun duygularını anlamak","Sporcusunu kendi duyguları çerçevesinde anlamaya çalışmak","Sporcusunun duygularını hissetmek","Objektif bir tutum sergilemek","Sporcusuna onu anladığını hissettirmek"],"answer":1,"explanation":"Empati karşıdaki kişinin duygu ve bakış açısını anlamayı gerektirir. Sporcuyu antrenörün kendi duyguları çerçevesinde değerlendirmesi bu ilkeye uymaz.","source":{"questionPage":119,"answerPage":121,"pages":[106],"section":"Sporda Fair Play II","evidence":"kişi kendi duygularını bir tarafa bırakarak, karşı tarafın duygularını anlamaya çalışmalıdır."},"kind":"book"},{"id":"psikososyal-4-3","courseId":"psikososyal","chapter":4,"chapterTitle":"Sporda Fair Play II","number":3,"stem":"Antrenörün sporcusunda “kural bilincinin” artırılmasına yönelik olarak aşağıdakilerden hangisini uygulaması gerekmektedir?","options":["Kuralları tanıtma, öğretme ve içselleştirme","Kurallar karşısında edilgen uyum sağlama","Kurallara uymayanın ciddi şekilde cezalandırılması","Kurallara karşı korku oluşturulması","Kurallara uymayanların cezalandırılması"],"answer":0,"explanation":"Kural bilinci, kuralları yalnızca ceza baskısıyla uygulatmakla sınırlı değildir. Kuralları tanıtmak, öğretmek ve nedenlerini kavratarak içselleştirmek gerekir.","source":{"questionPage":119,"answerPage":121,"pages":[105],"section":"Sporda Fair Play II","evidence":"Sporcular kuralları otorite baskısı ile değil neden önemli olduğunu kavrayarak içselleştirecek duruma getirebilmelidir."},"kind":"book"},{"id":"psikososyal-4-4","courseId":"psikososyal","chapter":4,"chapterTitle":"Sporda Fair Play II","number":4,"stem":"Sporcunun başarısını genelde haksız yollara başvurarak, hakemleri aldatarak sağlaması, sporcunun hangi değer türüne sahip olmadığını göstermektedir?","options":["Ahlaksal değerler","Sosyal Değerler","Yasaklayıcı Değerler","Varoluşçu Değerler","Betimsel Değerler"],"answer":0,"explanation":"Hakemi aldatıp haksız yoldan başarı kazanmak, doğruluk ve adalet gibi ahlaksal değerlere aykırıdır. Kulübe bağlı olmak veya çok çalışmak bu eksikliği ortadan kaldırmaz.","source":{"questionPage":119,"answerPage":121,"pages":[102],"section":"Sporda Fair Play II","evidence":"başarısını genelde haksız yollara başvurarak, hakemleri aldatarak sağlıyorsa burada ahlaksal değerlerden bahsedilemez."},"kind":"book"},{"id":"psikososyal-4-5","courseId":"psikososyal","chapter":4,"chapterTitle":"Sporda Fair Play II","number":5,"stem":"Aşağıdakilerden hangisi suçluların cezalandırılmasından ziyade doping kullanımının önlenebilmesi için yapılacak uygulamalardandır?","options":["Doping kullananların cezalandırılması","Doping kullanımını ortaya çıkaracak teknolojinin geliştirilmesi","Dopingin spor için ne kadar etik dışı olduğunu gösteren eğitim programlarının kullanılması","Doping kullanan sporcuların spor ortamından uzaklaştırılması","Doping testlerinin artırılması"],"answer":2,"explanation":"Bölüm, cezalandırmanın yanında önleyici eğitimi vurgular. Dopingin etik dışı niteliğini anlatan eğitim programları, kullanımın önlenmesine yönelik doğru seçenektir.","source":{"questionPage":119,"answerPage":121,"pages":[97],"section":"Sporda Fair Play II","evidence":"dopingin spor için ne kadar etik dışı olduğunu gösteren eğitim programlarına ihtiyacımız olduğunu savunmaktadır"},"kind":"book"},{"id":"psikososyal-5-1","courseId":"psikososyal","chapter":5,"chapterTitle":"Sporda Koruma II","number":1,"stem":"Sporcu odaklı yaklaşıma göre aşağıdaki ifadelerden hangisi yanlıştır?","options":["Performansa tek taraflı odaklanmak, çocuklarda stres ve kaygıyı tetikleyebilir.","Bir çocuğu zafere, rekora, ödüllendirmeye yönlendirmek temel amaç olmamalıdır.","Sporcunun istek ve ihtiyaçları her zaman ilk sıraya konulmalıdır.","Yetenekli sporcular, diğerlerinden daha uzun süre oyun içerisinde tutulmalıdır.","Spordaki başarı madalya ve skorla değil, çocuğun sporda ne kadar eğlendiği ile ölçülmelidir."],"answer":3,"explanation":"Sporcu odaklı yaklaşımda her sporcuya aynı şans verilir; favori oyuncu uygulaması eleştirilir. Yalnızca yetenekli sporcuları daha uzun oynatmak bu yaklaşımın tersi olduğu için D yanlıştır.","source":{"questionPage":152,"answerPage":154,"pages":[129],"section":"Sporda Koruma II","evidence":"çocuk sporcular mümkün olduğunca eşit süre almalıdır"},"kind":"book"},{"id":"psikososyal-5-2","courseId":"psikososyal","chapter":5,"chapterTitle":"Sporda Koruma II","number":2,"stem":"I. Diğer alanlardan farklı olarak sporda antrenörün sporcusu ile daha yoğun temas hâlinde olması\nII. Spor örgütlerinin; dokunma, fiziksel temas gibi konularda açık, uygulanabilir, fikirlerin ve politikaların olmaması\nIII. Soyunma odası, duş gibi mahrem alanlara antrenörün, telefon gibi kameralı cihazlarla girmesi\nIV. Özellikle ergenlik döneminde sporcuların duygusal olarak yaşadığı karmaşadan kaynaklı antrenör davranışlarını farklı yorumlaması\n\nYukarıdaki durumlardan hangileri antrenör için riskler oluşturmaktadır?","options":["I, II ve III","I, II ve IV","I, III ve IV","II, III ve IV","I, II, III ve IV"],"answer":4,"explanation":"Kitap yoğun fiziksel teması, açık koruma politikalarının yokluğunu, mahrem alanlarda kameralı cihazları ve yaşa bağlı yanlış anlamaları riskler bağlamında ele alır. Dört öncül de bu başlıklara karşılık gelir.","source":{"questionPage":152,"answerPage":154,"pages":[125,126,127],"section":"Sporda Koruma II","evidence":"Soyunma odası, duş gibi mahrem alanlara telefon gibi kameralı cihazlarla girilmemesi"},"kind":"book"},{"id":"psikososyal-5-3","courseId":"psikososyal","chapter":5,"chapterTitle":"Sporda Koruma II","number":3,"stem":"Aşağıdaki davranış biçimlerinden hangisi branşa özgü riskler kapsamında yer almaktadır?","options":["Kaslı ve güçlü olmayı gerektiren bazı spor branşlarının erkeklikle özdeşleştirilerek sporun cinsiyetlendirilmesi","Özellikle doğada ve farklı ısı derecelerinde yapılan sporlarda, sporcuya gereksiz yere aşırı efor sarf edeceği antrenmanlar yaptırılması","Farklı kültürlerin çocuğa yaklaşım ve davranış konusunda antrenörün bilgi ve tecrübesinin eksik olması","Antrenörler ve sporcular arasında güç dengesizliği bulunması","Antrenörün kendi duygu, düşünce, alışkanlık, örf, adet gibi alt kültür kodlarını antrenörlük sürecinde ön plana çıkarması"],"answer":1,"explanation":"Branşa özgü riskler, sporun yapıldığı ortam ve o branşın kendine özgü yüklenme ve temas koşullarıyla ilişkilidir. Doğada farklı sıcaklıklarda gereksiz aşırı efor uygulatılması bu gruptadır.","source":{"questionPage":152,"answerPage":154,"pages":[131],"section":"Sporda Koruma II","evidence":"Her sporun kendine has bir doğası bulunmaktadır."},"kind":"book"},{"id":"psikososyal-5-6","courseId":"psikososyal","chapter":5,"chapterTitle":"Sporda Koruma II","number":6,"stem":"İhmal ve istismarın belirtileri ile ilgili aşağıdaki ifadelerden hangisi yanlıştır?","options":["İhmal ve istismarın belirtileri, çocuktan çocuğa benzerlik gösterir.","Her çocuk yaş, cinsiyet, ırk, sosyal statü veya kabiliyetine bakılmaksızın istismara uğrayabilir.","Cinsel istismarın en önemli ve öncelikli göstergelerinden biri, çocuğun bu konudaki beyanıdır.","İhmal ve istismarın etkileri her mağdur çocukta farklı biçimde ve derecede görülür.","İstismara uğrayan bireyler; utanç, korku ve suçluluk duygusu nedeniyle istismarı saklayabilir."],"answer":0,"explanation":"İhmal ve istismarın belirtileri her çocukta aynı biçim ve derecede görülmez. Bu nedenle çocuklar arasında benzerlik gösterdiğini genelleyen A seçeneği yanlıştır.","source":{"questionPage":152,"answerPage":154,"pages":[138],"section":"Sporda Koruma II","evidence":"Belirtiler çocuktan çocuğa farklılık gösterebilir."},"kind":"book"},{"id":"psikososyal-5-7","courseId":"psikososyal","chapter":5,"chapterTitle":"Sporda Koruma II","number":7,"stem":"Aşağıdaki davranış biçimlerinden hangisi sözel iletişim açısından doğru bir yaklaşımdır?","options":["Sporcunun kendisini samimi bir ortamda hissetmesini sağlamak amacıyla ona lakap takılarak seslenilebilir.","Fair-playi teşvik ederek bu doğrultudaki uygulamaları sözel olarak desteklemek ve vurgulamak gerekir.","Ünlü biri veya takım arkadaşlarından biriyle sporcuyu motive etmek veya takdir etmek amacıyla kıyaslama yapılabilir.","Alay edici bir dil kullanmak dikkatin yoğunlaşmasını sağlayacağından performansı artırmak adına zaman zaman tercih edilebilir.","Antrenman sürecinde ilk önce hatayı vurgulamak, sporcunun neyi yanlış yaptığını görmesi açısından daha eğiticidir."],"answer":1,"explanation":"Kitap, fair play davranışlarını sözle desteklemeyi olumlu iletişim örneği olarak verir. Lakap takmak, alay etmek veya başkalarıyla kıyaslamak önerilmez.","source":{"questionPage":153,"answerPage":154,"pages":[141],"section":"Sporda Koruma II","evidence":"Mutlaka fair-playi teşvik etmek ve bu doğrultudaki uygulamaları sözel olarak desteklemek ve vurgulamak gereklidir."},"kind":"book"},{"id":"psikososyal-6-2","courseId":"psikososyal","chapter":6,"chapterTitle":"Antrenörlük Meslek Etiği I","number":2,"stem":"‘------- belli bir eğitim ile kazanılan sistemli bilgi ve becerilere dayalı, insanlığa yararlı mal üretmek, hizmet vermek ve karşılığında para kazanmak için yapılan etkinlikler bütünüdür.’\n\nYukarıdaki cümlede boş bırakılan yeri aşağıdakilerden hangisi doğru şekilde tamamlar?","options":["Eğitim","Spor","Öğretim","Etik","Meslek"],"answer":4,"explanation":"Bu tanım mesleğe aittir. Eğitimle kazanılmış sistemli bilgi ve beceri, topluma yararlı hizmet ve maddi karşılık tanımın temel unsurlarıdır.","source":{"questionPage":172,"answerPage":174,"pages":[159],"section":"Antrenörlük Meslek Etiği I","evidence":"Meslek, belli bir eğitim ile kazanılan sistemli bilgi ve becerilere dayalı"},"kind":"book"},{"id":"psikososyal-6-3","courseId":"psikososyal","chapter":6,"chapterTitle":"Antrenörlük Meslek Etiği I","number":3,"stem":"I. Toplumda önemli bir işlevi yerine getirmesi, toplumun eğitim, sağlık, güvenlik gibi kaçınılmaz olan bir gereksinimi karşılaması\nII. Sistemli bilgi ve becerilerden oluşan belirli bir eğitimle kazanılması\nIII. Bireye yalnızca ekonomik kazanç sağlaması\nIV. Tüm mesleklerin ortak etik ilklere sahip olması\n\nYukarıdakilerden hangileri bir uğraşın meslek olabilmesi için taşıması gereken özelliklerdendir?","options":["Yalnız I","Yalnız II","I ve II","I ve III","II ve IV"],"answer":2,"explanation":"Toplumun önemli bir gereksinimini karşılama ve eğitimle kazanılmış sistemli bilgi-beceri mesleğin özellikleridir. Meslek yalnızca ekonomik kazanca indirgenmez; her mesleğin kendine özgü etik ilkeleri de vardır. Bu yüzden I ve II doğrudur.","source":{"questionPage":172,"answerPage":174,"pages":[160],"section":"Antrenörlük Meslek Etiği I","evidence":"Meslek sistemli bilgi ve becerilerden oluşan belirli bir eğitimle kazanılır."},"kind":"book"},{"id":"psikososyal-6-4","courseId":"psikososyal","chapter":6,"chapterTitle":"Antrenörlük Meslek Etiği I","number":4,"stem":"I. İyi bir branş bilgisine sahip olmalı\nII. Daima katı kurallara sahip olmalı\nIII. İyi bir genel kültür bilgisine sahip olmalı\nIV. Aynı antrenman tekniğini uygulamalı İdeal bir antrenörde olması gereken özellikler ile ilgili yukarıdaki ifadelerden hangileri doğrudur?","options":["Yalnız I","Yalnız IV","I ve III","II ve IV","I, II ve III"],"answer":2,"explanation":"Kitap ideal antrenörün branş bilgisi ile genel kültür bilgisini birlikte vurgular. Daima katı kurallar ve aynı antrenman tekniği bu listede ideal özellikler olarak verilmez; I ve III doğrudur.","source":{"questionPage":172,"answerPage":174,"pages":[160,161],"section":"Antrenörlük Meslek Etiği I","evidence":"İyi Bir Genel Kültür Bilgisine Sahip Olma"},"kind":"book"},{"id":"psikososyal-6-5","courseId":"psikososyal","chapter":6,"chapterTitle":"Antrenörlük Meslek Etiği I","number":5,"stem":"Bireyin kişilik gelişiminin bir parçası olarak duygularını kontrol edebilme yeteneği aşağıdaki gelişim alanlarının hangisi ile açıklanmaktadır?","options":["Zihinsel Gelişim","Fiziksel Gelişim","Sosyal Gelişim","Duygusal Gelişim","Devinişsel Gelişim"],"answer":3,"explanation":"Duygularını kontrol edebilme, kişilik gelişiminin duygusal gelişim alanıyla ilişkilidir. Kitap maç öncesinde, sırasında ve sonrasında sinir ve kaygının kontrolünü örnek verir.","source":{"questionPage":172,"answerPage":174,"pages":[167],"section":"Antrenörlük Meslek Etiği I","evidence":"kişinin duygularını kontrol edebilme yeteneğini gösterir"},"kind":"book"},{"id":"psikososyal-6-6","courseId":"psikososyal","chapter":6,"chapterTitle":"Antrenörlük Meslek Etiği I","number":6,"stem":"Aşağıdakilerden hangisi mesleki etik ilkelerin görevlerinden biri değildir?","options":["Hizmet içi rekabeti düzenlemek","Belirsiz durumlarda nasıl davranacağı konusunda meslek mensuplarına yol göstermek","Yöneticilerin çalışanlar üzerindeki yaptırımını artırmak","Meslek üyelerini doğru davranış sergilemesi konusunda motive etmek","Meslek ideallerini her zaman korumak"],"answer":2,"explanation":"Mesleki etik; doğru davranışa yol gösterme, meslek ideallerini koruma ve hizmet içi rekabeti düzenleme gibi işlevler taşır. Yöneticilerin çalışanlar üzerindeki yaptırımını artırmak bu görevlerden değildir.","source":{"questionPage":172,"answerPage":174,"pages":[163],"section":"Antrenörlük Meslek Etiği I","evidence":"Meslek üyelerini doğru davranış sergilemesi konusunda motive ederek daha az yanlış davranışın sergilenmesini sağlar."},"kind":"book"},{"id":"saglik-ek-001","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":1,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Omurga (Columna Vertebralis) Columna vertebralisi oluşturan her bir kemiğe vertebra (omur) adı verilir, toplam 33-34 vertebranın birleşmesi ile oluşur ve bulundukları bölgeye göre adlandırılır: 7 adet ________ (servikal vertebra), 12 adet vertebra thoracicae (thorakal vertebralar), 5 adet vertebra lumbales (lumbal vertebralar), 5 adet vertebra sacrales (sakral vertebralar), 4-5 vertebra coccygea (koksiks).”","options":["plantar fleksiyon","vertebra cervicales","Cavitas glenoidalis","corpus sterni","Transversus abdominis"],"answer":1,"explanation":"Doğru kavram: vertebra cervicales. Kitaptaki kaynak ifade: “Omurga (Columna Vertebralis) Columna vertebralisi oluşturan her bir kemiğe vertebra (omur) adı verilir, toplam 33-34 vertebranın birleşmesi ile oluşur ve bulundukları bölgeye göre adlandırılır: 7 adet vertebra cervicales (servikal vertebra), 12 adet vertebra thoracicae (thorakal vertebralar), 5 adet vertebra lumbales (lumbal vertebralar), 5 adet vertebra sacrales (sakral vertebralar), 4-5 vertebra coccygea (koksiks).”","source":{"pages":[3],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Omurga (Columna Vertebralis) Columna vertebralisi oluşturan her bir kemiğe vertebra (omur) adı verilir, toplam 33-34 vertebranın birleşmesi ile oluşur ve bulundukları bölgeye göre adlandırılır: 7 adet vertebra cervicales (servikal vertebra), 12 adet vertebra thoracicae (thorakal vertebralar), 5 adet vertebra lumbales (lumbal vertebralar), 5 adet vertebra sacrales (sakral vertebralar), 4-5 vertebra coccygea (koksiks).","format":"cloze","optionEvidence":[{"pages":[24],"evidence":"plantar fleksiyon"},{"pages":[3],"evidence":"vertebra cervicales"},{"pages":[12],"evidence":"Cavitas glenoidalis"},{"pages":[6],"evidence":"corpus sterni"},{"pages":[32],"evidence":"Transversus abdominis"}],"maskedText":"Omurga (Columna Vertebralis) Columna vertebralisi oluşturan her bir kemiğe vertebra (omur) adı verilir, toplam 33-34 vertebranın birleşmesi ile oluşur ve bulundukları bölgeye göre adlandırılır: 7 adet ________ (servikal vertebra), 12 adet vertebra thoracicae (thorakal vertebralar), 5 adet vertebra lumbales (lumbal vertebralar), 5 adet vertebra sacrales (sakral vertebralar), 4-5 vertebra coccygea (koksiks)."}},{"id":"saglik-ek-002","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":2,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bundan dolayı, ________ ve ekstansiyon hareketlilikleri kısıtlıdır fakat bunların rotasyonel hareketlilikleri fazladır.”","options":["Humerus","sinerjist","diyafragma","omurga","fleksiyon"],"answer":4,"explanation":"Doğru kavram: fleksiyon. Kitaptaki kaynak ifade: “Bundan dolayı, fleksiyon ve ekstansiyon hareketlilikleri kısıtlıdır fakat bunların rotasyonel hareketlilikleri fazladır.”","source":{"pages":[5],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bundan dolayı, fleksiyon ve ekstansiyon hareketlilikleri kısıtlıdır fakat bunların rotasyonel hareketlilikleri fazladır.","format":"cloze","optionEvidence":[{"pages":[12],"evidence":"Humerus"},{"pages":[26],"evidence":"sinerjist"},{"pages":[32],"evidence":"diyafragma"},{"pages":[5],"evidence":"omurga"},{"pages":[5],"evidence":"fleksiyon"}],"maskedText":"Bundan dolayı, ________ ve ekstansiyon hareketlilikleri kısıtlıdır fakat bunların rotasyonel hareketlilikleri fazladır."}},{"id":"saglik-ek-003","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":3,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________, corpus sterni, processus xiphoideus olmak üzere üç parçası vardır.”","options":["Vastus medialis","Erector spinae","Manibrium sterni","vertebra cervicales","vertebra coccygea"],"answer":2,"explanation":"Doğru kavram: Manibrium sterni. Kitaptaki kaynak ifade: “Manibrium sterni, corpus sterni, processus xiphoideus olmak üzere üç parçası vardır.”","source":{"pages":[6],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Manibrium sterni, corpus sterni, processus xiphoideus olmak üzere üç parçası vardır.","format":"cloze","optionEvidence":[{"pages":[22],"evidence":"Vastus medialis"},{"pages":[32],"evidence":"Erector spinae"},{"pages":[6],"evidence":"Manibrium sterni"},{"pages":[3],"evidence":"vertebra cervicales"},{"pages":[3],"evidence":"vertebra coccygea"}],"maskedText":"________, corpus sterni, processus xiphoideus olmak üzere üç parçası vardır."}},{"id":"saglik-ek-004","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":4,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________: Günlük hareketler sırasında gövdenin yer çekimi ile fleksiyona gitmesini engelleyerek gövdenin dik durmasını ve dengeyi sağlayan en kuvvetli gövde sırt ekstansör kasıdır.”","options":["Erector spinae","vertebra sacrales","Latissimus dorsi","Gluteus maximus","Serratus anterior"],"answer":0,"explanation":"Doğru kavram: Erector spinae. Kitaptaki kaynak ifade: “Erector spinae: Günlük hareketler sırasında gövdenin yer çekimi ile fleksiyona gitmesini engelleyerek gövdenin dik durmasını ve dengeyi sağlayan en kuvvetli gövde sırt ekstansör kasıdır.”","source":{"pages":[7],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Erector spinae: Günlük hareketler sırasında gövdenin yer çekimi ile fleksiyona gitmesini engelleyerek gövdenin dik durmasını ve dengeyi sağlayan en kuvvetli gövde sırt ekstansör kasıdır.","format":"cloze","optionEvidence":[{"pages":[7],"evidence":"Erector spinae"},{"pages":[3],"evidence":"vertebra sacrales"},{"pages":[11],"evidence":"Latissimus dorsi"},{"pages":[19],"evidence":"Gluteus maximus"},{"pages":[13],"evidence":"Serratus anterior"}],"maskedText":"________: Günlük hareketler sırasında gövdenin yer çekimi ile fleksiyona gitmesini engelleyerek gövdenin dik durmasını ve dengeyi sağlayan en kuvvetli gövde sırt ekstansör kasıdır."}},{"id":"saglik-ek-005","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":5,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Orta tabakadaki M. ________ ve en dış tabakada yer alan M. obliquus eksternus abdominis lifleri birbirleriyle çapraz şekilde (x) yerleşmiştir.”","options":["viseral plevra","vertebra sacrales","Vastus intermedius","obliquus internus abdominis","vertebra cervicales"],"answer":3,"explanation":"Doğru kavram: obliquus internus abdominis. Kitaptaki kaynak ifade: “Orta tabakadaki M. obliquus internus abdominis ve en dış tabakada yer alan M. obliquus eksternus abdominis lifleri birbirleriyle çapraz şekilde (x) yerleşmiştir.”","source":{"pages":[8],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Orta tabakadaki M. obliquus internus abdominis ve en dış tabakada yer alan M. obliquus eksternus abdominis lifleri birbirleriyle çapraz şekilde (x) yerleşmiştir.","format":"cloze","optionEvidence":[{"pages":[27],"evidence":"viseral plevra"},{"pages":[3],"evidence":"vertebra sacrales"},{"pages":[22],"evidence":"Vastus intermedius"},{"pages":[8],"evidence":"obliquus internus abdominis"},{"pages":[3],"evidence":"vertebra cervicales"}],"maskedText":"Orta tabakadaki M. ________ ve en dış tabakada yer alan M. obliquus eksternus abdominis lifleri birbirleriyle çapraz şekilde (x) yerleşmiştir."}},{"id":"saglik-ek-006","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":6,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Ayrıca, bu da eksternus kası gibi toraksı aşağı çekerek ________, doğum, miksiyon, defekasyon, kusma gibi karın içi basıncının artmasının gerektiği hâllere yardımcıdır.”","options":["ekstansiyon","ekspirasyon","pronasyon","diyafragma","Humerus"],"answer":1,"explanation":"Doğru kavram: ekspirasyon. Kitaptaki kaynak ifade: “Ayrıca, bu da eksternus kası gibi toraksı aşağı çekerek ekspirasyon, doğum, miksiyon, defekasyon, kusma gibi karın içi basıncının artmasının gerektiği hâllere yardımcıdır.”","source":{"pages":[9],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Ayrıca, bu da eksternus kası gibi toraksı aşağı çekerek ekspirasyon, doğum, miksiyon, defekasyon, kusma gibi karın içi basıncının artmasının gerektiği hâllere yardımcıdır.","format":"cloze","optionEvidence":[{"pages":[12],"evidence":"ekstansiyon"},{"pages":[9],"evidence":"ekspirasyon"},{"pages":[16],"evidence":"pronasyon"},{"pages":[32],"evidence":"diyafragma"},{"pages":[12],"evidence":"Humerus"}],"maskedText":"Ayrıca, bu da eksternus kası gibi toraksı aşağı çekerek ________, doğum, miksiyon, defekasyon, kusma gibi karın içi basıncının artmasının gerektiği hâllere yardımcıdır."}},{"id":"saglik-ek-007","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":7,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Cavitas glenoidalisi kemiğe bağlayan dar parçaya ________ (skapula boynu) denir.”","options":["Peroneus longus","Gluteus minimus","caput humeri","Vastus intermedius","collum scapulae"],"answer":4,"explanation":"Doğru kavram: collum scapulae. Kitaptaki kaynak ifade: “Cavitas glenoidalisi kemiğe bağlayan dar parçaya collum scapulae (skapula boynu) denir.”","source":{"pages":[10],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Cavitas glenoidalisi kemiğe bağlayan dar parçaya collum scapulae (skapula boynu) denir.","format":"cloze","optionEvidence":[{"pages":[23],"evidence":"Peroneus longus"},{"pages":[19],"evidence":"Gluteus minimus"},{"pages":[12],"evidence":"caput humeri"},{"pages":[22],"evidence":"Vastus intermedius"},{"pages":[10],"evidence":"collum scapulae"}],"maskedText":"Cavitas glenoidalisi kemiğe bağlayan dar parçaya ________ (skapula boynu) denir."}},{"id":"saglik-ek-008","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":8,"kind":"derived","stem":"Kitapta aşağıdaki açıklama hangi kavramla ilişkilendirilir?\n\n“İşlevi: Skapulaya elevasyon yaptırır, retraksiyona yardım eder ve aşağı doğru rotasyonunda (downward) rol oynar.”","options":["Triceps brachii","Vastus intermedius","Levator scapulae","Erector spinae","Serratus anterior"],"answer":2,"explanation":"Doğru kavram: Levator scapulae. Kitaptaki kaynak ifade: “Levator scapulae: İşlevi: Skapulaya elevasyon yaptırır, retraksiyona yardım eder ve aşağı doğru rotasyonunda (downward) rol oynar.”","source":{"pages":[11],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Levator scapulae: İşlevi: Skapulaya elevasyon yaptırır, retraksiyona yardım eder ve aşağı doğru rotasyonunda (downward) rol oynar.","format":"concept","optionEvidence":[{"pages":[14],"evidence":"Triceps brachii"},{"pages":[22],"evidence":"Vastus intermedius"},{"pages":[11],"evidence":"Levator scapulae"},{"pages":[32],"evidence":"Erector spinae"},{"pages":[13],"evidence":"Serratus anterior"}]}},{"id":"saglik-ek-009","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":9,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Lateral epikondil el bileğine ________ yaptıran kasların çoğunun başlangıç noktası iken medial epikondil el bileğine fleksiyon yaptıran kasların çoğunun başlangıç noktasıdır.”","options":["ekstansiyon","Patella","Fibula","Humerus","supinasyon"],"answer":0,"explanation":"Doğru kavram: ekstansiyon. Kitaptaki kaynak ifade: “Lateral epikondil el bileğine ekstansiyon yaptıran kasların çoğunun başlangıç noktası iken medial epikondil el bileğine fleksiyon yaptıran kasların çoğunun başlangıç noktasıdır.”","source":{"pages":[12],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Lateral epikondil el bileğine ekstansiyon yaptıran kasların çoğunun başlangıç noktası iken medial epikondil el bileğine fleksiyon yaptıran kasların çoğunun başlangıç noktasıdır.","format":"cloze","optionEvidence":[{"pages":[12],"evidence":"ekstansiyon"},{"pages":[21],"evidence":"Patella"},{"pages":[16],"evidence":"Fibula"},{"pages":[12],"evidence":"Humerus"},{"pages":[24],"evidence":"supinasyon"}],"maskedText":"Lateral epikondil el bileğine ________ yaptıran kasların çoğunun başlangıç noktası iken medial epikondil el bileğine fleksiyon yaptıran kasların çoğunun başlangıç noktasıdır."}},{"id":"saglik-ek-010","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":10,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Fakat asıl işlevi, kolu m. deltoideus ve m. ________ aracılığıyla yukarı kaldırdığımızda ve ağır yük taşıdığımızda humerus başının aşağı kaymasına engel olmaktır.”","options":["parietal plevra","Os coxae","plantar fleksiyon","serratus anterior","Vastus lateralis"],"answer":3,"explanation":"Doğru kavram: serratus anterior. Kitaptaki kaynak ifade: “Fakat asıl işlevi, kolu m. deltoideus ve m. serratus anterior aracılığıyla yukarı kaldırdığımızda ve ağır yük taşıdığımızda humerus başının aşağı kaymasına engel olmaktır.”","source":{"pages":[13],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Fakat asıl işlevi, kolu m. deltoideus ve m. serratus anterior aracılığıyla yukarı kaldırdığımızda ve ağır yük taşıdığımızda humerus başının aşağı kaymasına engel olmaktır.","format":"cloze","optionEvidence":[{"pages":[27],"evidence":"parietal plevra"},{"pages":[5],"evidence":"Os coxae"},{"pages":[24],"evidence":"plantar fleksiyon"},{"pages":[13],"evidence":"serratus anterior"},{"pages":[22],"evidence":"Vastus lateralis"}],"maskedText":"Fakat asıl işlevi, kolu m. deltoideus ve m. ________ aracılığıyla yukarı kaldırdığımızda ve ağır yük taşıdığımızda humerus başının aşağı kaymasına engel olmaktır."}},{"id":"saglik-ek-011","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":11,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Ön kolu fleksiyon durumuna getirirsek m. ________ kası uzar ve gerilir.”","options":["Quadriceps femoris","triceps brachii","Biceps femoris","vertebra sacrales","Rectus abdominis"],"answer":1,"explanation":"Doğru kavram: triceps brachii. Kitaptaki kaynak ifade: “Ön kolu fleksiyon durumuna getirirsek m. triceps brachii kası uzar ve gerilir.”","source":{"pages":[14],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Ön kolu fleksiyon durumuna getirirsek m. triceps brachii kası uzar ve gerilir.","format":"cloze","optionEvidence":[{"pages":[21],"evidence":"Quadriceps femoris"},{"pages":[14],"evidence":"triceps brachii"},{"pages":[20],"evidence":"Biceps femoris"},{"pages":[3],"evidence":"vertebra sacrales"},{"pages":[8],"evidence":"Rectus abdominis"}],"maskedText":"Ön kolu fleksiyon durumuna getirirsek m. ________ kası uzar ve gerilir."}},{"id":"saglik-ek-012","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":12,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bir sinerjist kas, ________ kasın başladığı kemiği hareketsiz hâle getirdiğinde sabitleyici veya fiksatör kas olarak adlandırılır.”","options":["Soleus","Sartorius","sistol","Sternum","agonist"],"answer":4,"explanation":"Doğru kavram: agonist. Kitaptaki kaynak ifade: “Bir sinerjist kas, agonist kasın başladığı kemiği hareketsiz hâle getirdiğinde sabitleyici veya fiksatör kas olarak adlandırılır.”","source":{"pages":[15],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bir sinerjist kas, agonist kasın başladığı kemiği hareketsiz hâle getirdiğinde sabitleyici veya fiksatör kas olarak adlandırılır.","format":"cloze","optionEvidence":[{"pages":[26],"evidence":"Soleus"},{"pages":[22],"evidence":"Sartorius"},{"pages":[29],"evidence":"sistol"},{"pages":[29],"evidence":"Sternum"},{"pages":[15],"evidence":"agonist"}],"maskedText":"Bir sinerjist kas, ________ kasın başladığı kemiği hareketsiz hâle getirdiğinde sabitleyici veya fiksatör kas olarak adlandırılır."}},{"id":"saglik-ek-013","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":13,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Pelvis Kavşağı Pelvis, ________ ile alt ekstremite kemiklerini birleştiren bölgeye denir.”","options":["Semitendinosus","Rhomboides","omurga","sistol","Tibia"],"answer":2,"explanation":"Doğru kavram: omurga. Kitaptaki kaynak ifade: “Pelvis Kavşağı Pelvis, omurga ile alt ekstremite kemiklerini birleştiren bölgeye denir.”","source":{"pages":[16],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Pelvis Kavşağı Pelvis, omurga ile alt ekstremite kemiklerini birleştiren bölgeye denir.","format":"cloze","optionEvidence":[{"pages":[20],"evidence":"Semitendinosus"},{"pages":[11],"evidence":"Rhomboides"},{"pages":[16],"evidence":"omurga"},{"pages":[29],"evidence":"sistol"},{"pages":[16],"evidence":"Tibia"}],"maskedText":"Pelvis Kavşağı Pelvis, ________ ile alt ekstremite kemiklerini birleştiren bölgeye denir."}},{"id":"saglik-ek-014","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":14,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Os isciumun alt kısmında, aşağıya doğru uzanan çıkıntıya ________ denir ve burası her iki kalça kemiğinde tam üstüne oturduğumuz çıkıntıdır.”","options":["tuber isciadicum","Quadriceps femoris","Biceps femoris","Vastus lateralis","Gluteus medius"],"answer":0,"explanation":"Doğru kavram: tuber isciadicum. Kitaptaki kaynak ifade: “Os isciumun alt kısmında, aşağıya doğru uzanan çıkıntıya tuber isciadicum denir ve burası her iki kalça kemiğinde tam üstüne oturduğumuz çıkıntıdır.”","source":{"pages":[17],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Os isciumun alt kısmında, aşağıya doğru uzanan çıkıntıya tuber isciadicum denir ve burası her iki kalça kemiğinde tam üstüne oturduğumuz çıkıntıdır.","format":"cloze","optionEvidence":[{"pages":[17],"evidence":"tuber isciadicum"},{"pages":[21],"evidence":"Quadriceps femoris"},{"pages":[20],"evidence":"Biceps femoris"},{"pages":[22],"evidence":"Vastus lateralis"},{"pages":[19],"evidence":"Gluteus medius"}],"maskedText":"Os isciumun alt kısmında, aşağıya doğru uzanan çıkıntıya ________ denir ve burası her iki kalça kemiğinde tam üstüne oturduğumuz çıkıntıdır."}},{"id":"saglik-ek-015","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":15,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Yuvarlak olan üst ucuna ________ başı (caput femoris) denir.”","options":["Semitendinosus","hemoglobin","Pelvis","femur","Fibula"],"answer":3,"explanation":"Doğru kavram: femur. Kitaptaki kaynak ifade: “Yuvarlak olan üst ucuna femur başı (caput femoris) denir.”","source":{"pages":[18],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Yuvarlak olan üst ucuna femur başı (caput femoris) denir.","format":"cloze","optionEvidence":[{"pages":[20],"evidence":"Semitendinosus"},{"pages":[28],"evidence":"hemoglobin"},{"pages":[4],"evidence":"Pelvis"},{"pages":[18],"evidence":"femur"},{"pages":[16],"evidence":"Fibula"}],"maskedText":"Yuvarlak olan üst ucuna ________ başı (caput femoris) denir."}},{"id":"saglik-ek-016","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":16,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu kasın altında ve femurun dış yan tarafında abdüktörler olarak tanımlanan m. ________ ve minimus kasları bulunur.”","options":["corpus sterni","gluteus medius","Vastus lateralis","tuber isciadicum","vertebra lumbales"],"answer":1,"explanation":"Doğru kavram: gluteus medius. Kitaptaki kaynak ifade: “Bu kasın altında ve femurun dış yan tarafında abdüktörler olarak tanımlanan m. gluteus medius ve minimus kasları bulunur.”","source":{"pages":[19],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bu kasın altında ve femurun dış yan tarafında abdüktörler olarak tanımlanan m. gluteus medius ve minimus kasları bulunur.","format":"cloze","optionEvidence":[{"pages":[6],"evidence":"corpus sterni"},{"pages":[19],"evidence":"gluteus medius"},{"pages":[22],"evidence":"Vastus lateralis"},{"pages":[17],"evidence":"tuber isciadicum"},{"pages":[3],"evidence":"vertebra lumbales"}],"maskedText":"Bu kasın altında ve femurun dış yan tarafında abdüktörler olarak tanımlanan m. ________ ve minimus kasları bulunur."}},{"id":"saglik-ek-017","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":17,"kind":"derived","stem":"Kitapta aşağıdaki açıklama hangi kavramla ilişkilendirilir?\n\n“İşlevi: Her iki baş da diz eklemine fleksiyon yaptırır.”","options":["Peroneus longus","Latissimus dorsi","parietal plevra","Vastus medialis","Biceps femoris"],"answer":4,"explanation":"Doğru kavram: Biceps femoris. Kitaptaki kaynak ifade: “Biceps femoris: İşlevi: Her iki baş da diz eklemine fleksiyon yaptırır.”","source":{"pages":[20],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Biceps femoris: İşlevi: Her iki baş da diz eklemine fleksiyon yaptırır.","format":"concept","optionEvidence":[{"pages":[23],"evidence":"Peroneus longus"},{"pages":[11],"evidence":"Latissimus dorsi"},{"pages":[27],"evidence":"parietal plevra"},{"pages":[22],"evidence":"Vastus medialis"},{"pages":[20],"evidence":"Biceps femoris"}]}},{"id":"saglik-ek-018","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":18,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Diz ekleminin önünde ve ________ kasının tendonu içerisinde yer alan patella, vücudun en büyük sesamoid kemiğidir.”","options":["Biceps femoris","caput fibulae","quadriceps femoris","Vastus lateralis","Gluteus maximus"],"answer":2,"explanation":"Doğru kavram: quadriceps femoris. Kitaptaki kaynak ifade: “Diz ekleminin önünde ve quadriceps femoris kasının tendonu içerisinde yer alan patella, vücudun en büyük sesamoid kemiğidir.”","source":{"pages":[21],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Diz ekleminin önünde ve quadriceps femoris kasının tendonu içerisinde yer alan patella, vücudun en büyük sesamoid kemiğidir.","format":"cloze","optionEvidence":[{"pages":[20],"evidence":"Biceps femoris"},{"pages":[21],"evidence":"caput fibulae"},{"pages":[21],"evidence":"quadriceps femoris"},{"pages":[22],"evidence":"Vastus lateralis"},{"pages":[19],"evidence":"Gluteus maximus"}],"maskedText":"Diz ekleminin önünde ve ________ kasının tendonu içerisinde yer alan patella, vücudun en büyük sesamoid kemiğidir."}},{"id":"saglik-ek-019","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":19,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Aktif olarak gerçekleşen bu korumaya, m. ________ ve posterior ve m. peroneus longus kasları katkıda bulunur.”","options":["tibialis anterior","processus xiphoideus","viseral plevra","dorsi fleksiyon","Quadratus lumborum"],"answer":0,"explanation":"Doğru kavram: tibialis anterior. Kitaptaki kaynak ifade: “Aktif olarak gerçekleşen bu korumaya, m. tibialis anterior ve posterior ve m. peroneus longus kasları katkıda bulunur.”","source":{"pages":[23],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Aktif olarak gerçekleşen bu korumaya, m. tibialis anterior ve posterior ve m. peroneus longus kasları katkıda bulunur.","format":"cloze","optionEvidence":[{"pages":[23],"evidence":"tibialis anterior"},{"pages":[6],"evidence":"processus xiphoideus"},{"pages":[27],"evidence":"viseral plevra"},{"pages":[24],"evidence":"dorsi fleksiyon"},{"pages":[9],"evidence":"Quadratus lumborum"}],"maskedText":"Aktif olarak gerçekleşen bu korumaya, m. ________ ve posterior ve m. peroneus longus kasları katkıda bulunur."}},{"id":"saglik-ek-020","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":20,"kind":"derived","stem":"Kitapta aşağıdaki açıklama hangi kavramla ilişkilendirilir?\n\n“İşlevi: Art. talocruralis ekleminde ayağa plantar fleksiyon, subtalar eklemde ise ayağa eversiyon hareketini yaptırır.”","options":["corpus sterni","collum scapulae","Cavitas glenoidalis","Peroneus longus","Tibialis anterior"],"answer":3,"explanation":"Doğru kavram: Peroneus longus. Kitaptaki kaynak ifade: “Peroneus longus: İşlevi: Art. talocruralis ekleminde ayağa plantar fleksiyon, subtalar eklemde ise ayağa eversiyon hareketini yaptırır.”","source":{"pages":[24],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Peroneus longus: İşlevi: Art. talocruralis ekleminde ayağa plantar fleksiyon, subtalar eklemde ise ayağa eversiyon hareketini yaptırır.","format":"concept","optionEvidence":[{"pages":[6],"evidence":"corpus sterni"},{"pages":[10],"evidence":"collum scapulae"},{"pages":[12],"evidence":"Cavitas glenoidalis"},{"pages":[24],"evidence":"Peroneus longus"},{"pages":[24],"evidence":"Tibialis anterior"}]}},{"id":"saglik-ek-021","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":21,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Soluk almaya, yani atmosferdeki havanın akciğerlere girmesine ________; soluk vermeye, yani havanın akciğerlerden çıkıp atmosfere karışmasına ise ekspirasyon denir.”","options":["Humerus","inspirasyon","Soleus","hemoglobin","Patella"],"answer":1,"explanation":"Doğru kavram: inspirasyon. Kitaptaki kaynak ifade: “Soluk almaya, yani atmosferdeki havanın akciğerlere girmesine inspirasyon; soluk vermeye, yani havanın akciğerlerden çıkıp atmosfere karışmasına ise ekspirasyon denir.”","source":{"pages":[27],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Soluk almaya, yani atmosferdeki havanın akciğerlere girmesine inspirasyon; soluk vermeye, yani havanın akciğerlerden çıkıp atmosfere karışmasına ise ekspirasyon denir.","format":"cloze","optionEvidence":[{"pages":[12],"evidence":"Humerus"},{"pages":[27],"evidence":"inspirasyon"},{"pages":[26],"evidence":"Soleus"},{"pages":[28],"evidence":"hemoglobin"},{"pages":[21],"evidence":"Patella"}],"maskedText":"Soluk almaya, yani atmosferdeki havanın akciğerlere girmesine ________; soluk vermeye, yani havanın akciğerlerden çıkıp atmosfere karışmasına ise ekspirasyon denir."}},{"id":"saglik-ek-022","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":22,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu yaprağın bir kısmı akciğerlerin dışını örter ve buna ________ (organsal yaprak) denir.”","options":["Transversus abdominis","collum scapulae","corpus sterni","vertebra sacrales","viseral plevra"],"answer":4,"explanation":"Doğru kavram: viseral plevra. Kitaptaki kaynak ifade: “Bu yaprağın bir kısmı akciğerlerin dışını örter ve buna viseral plevra (organsal yaprak) denir.”","source":{"pages":[27],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bu yaprağın bir kısmı akciğerlerin dışını örter ve buna viseral plevra (organsal yaprak) denir.","format":"cloze","optionEvidence":[{"pages":[32],"evidence":"Transversus abdominis"},{"pages":[10],"evidence":"collum scapulae"},{"pages":[6],"evidence":"corpus sterni"},{"pages":[3],"evidence":"vertebra sacrales"},{"pages":[27],"evidence":"viseral plevra"}],"maskedText":"Bu yaprağın bir kısmı akciğerlerin dışını örter ve buna ________ (organsal yaprak) denir."}},{"id":"saglik-ek-023","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":23,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu zar, hilusta kendi üzerinde dönerek göğüs boşluğunun duvarlarının iç yüzeyini örter ve bu da ________ (çevresel yaprak) olarak adlandırılır.”","options":["collum scapulae","Vastus intermedius","parietal plevra","Gluteus maximus","caput humeri"],"answer":2,"explanation":"Doğru kavram: parietal plevra. Kitaptaki kaynak ifade: “Bu zar, hilusta kendi üzerinde dönerek göğüs boşluğunun duvarlarının iç yüzeyini örter ve bu da parietal plevra (çevresel yaprak) olarak adlandırılır.”","source":{"pages":[27],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bu zar, hilusta kendi üzerinde dönerek göğüs boşluğunun duvarlarının iç yüzeyini örter ve bu da parietal plevra (çevresel yaprak) olarak adlandırılır.","format":"cloze","optionEvidence":[{"pages":[10],"evidence":"collum scapulae"},{"pages":[22],"evidence":"Vastus intermedius"},{"pages":[27],"evidence":"parietal plevra"},{"pages":[19],"evidence":"Gluteus maximus"},{"pages":[12],"evidence":"caput humeri"}],"maskedText":"Bu zar, hilusta kendi üzerinde dönerek göğüs boşluğunun duvarlarının iç yüzeyini örter ve bu da ________ (çevresel yaprak) olarak adlandırılır."}},{"id":"saglik-ek-024","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":24,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kandaki eritrosit sayısının veya ________ oranının düşmesine anemi (kansızlık) denir.”","options":["hemoglobin","fleksiyon","omurga","Sternum","Deltoideus"],"answer":0,"explanation":"Doğru kavram: hemoglobin. Kitaptaki kaynak ifade: “Kandaki eritrosit sayısının veya hemoglobin oranının düşmesine anemi (kansızlık) denir.”","source":{"pages":[28],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Kandaki eritrosit sayısının veya hemoglobin oranının düşmesine anemi (kansızlık) denir.","format":"cloze","optionEvidence":[{"pages":[28],"evidence":"hemoglobin"},{"pages":[22],"evidence":"fleksiyon"},{"pages":[5],"evidence":"omurga"},{"pages":[29],"evidence":"Sternum"},{"pages":[13],"evidence":"Deltoideus"}],"maskedText":"Kandaki eritrosit sayısının veya ________ oranının düşmesine anemi (kansızlık) denir."}},{"id":"saglik-ek-025","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":25,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kalp kasıldığı zaman kan vücuda yollanır ve bu işleme ________ denir.”","options":["fleksiyon","Brachialis","Semimembranosus","sistol","hemoglobin"],"answer":3,"explanation":"Doğru kavram: sistol. Kitaptaki kaynak ifade: “Kalp kasıldığı zaman kan vücuda yollanır ve bu işleme sistol denir.”","source":{"pages":[29],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Kalp kasıldığı zaman kan vücuda yollanır ve bu işleme sistol denir.","format":"cloze","optionEvidence":[{"pages":[22],"evidence":"fleksiyon"},{"pages":[31],"evidence":"Brachialis"},{"pages":[20],"evidence":"Semimembranosus"},{"pages":[29],"evidence":"sistol"},{"pages":[28],"evidence":"hemoglobin"}],"maskedText":"Kalp kasıldığı zaman kan vücuda yollanır ve bu işleme ________ denir."}},{"id":"saglik-ek-026","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":26,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kalp kası genişlediği zaman kalp boşlukları kan ile dolar ve buna da ________ denir.”","options":["Pelvis","diastol","omurga","Tibia","Femur"],"answer":1,"explanation":"Doğru kavram: diastol. Kitaptaki kaynak ifade: “Kalp kası genişlediği zaman kalp boşlukları kan ile dolar ve buna da diastol denir.”","source":{"pages":[29],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Kalp kası genişlediği zaman kalp boşlukları kan ile dolar ve buna da diastol denir.","format":"cloze","optionEvidence":[{"pages":[4],"evidence":"Pelvis"},{"pages":[29],"evidence":"diastol"},{"pages":[5],"evidence":"omurga"},{"pages":[16],"evidence":"Tibia"},{"pages":[20],"evidence":"Femur"}],"maskedText":"Kalp kası genişlediği zaman kalp boşlukları kan ile dolar ve buna da ________ denir."}},{"id":"saglik-ek-027","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":27,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu damarların herhangi birindeki tıkanıklık kalıcı ve kalp kasının zedelenmesine sebep olmuşsa buna ________ denir.”","options":["abduksiyon","adduksiyon","sinerjist","antagonist","enfarktüs"],"answer":4,"explanation":"Doğru kavram: enfarktüs. Kitaptaki kaynak ifade: “Bu damarların herhangi birindeki tıkanıklık kalıcı ve kalp kasının zedelenmesine sebep olmuşsa buna enfarktüs denir.”","source":{"pages":[30],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Bu damarların herhangi birindeki tıkanıklık kalıcı ve kalp kasının zedelenmesine sebep olmuşsa buna enfarktüs denir.","format":"cloze","optionEvidence":[{"pages":[19],"evidence":"abduksiyon"},{"pages":[11],"evidence":"adduksiyon"},{"pages":[26],"evidence":"sinerjist"},{"pages":[11],"evidence":"antagonist"},{"pages":[30],"evidence":"enfarktüs"}],"maskedText":"Bu damarların herhangi birindeki tıkanıklık kalıcı ve kalp kasının zedelenmesine sebep olmuşsa buna ________ denir."}},{"id":"saglik-ek-028","courseId":"saglik","chapter":1,"chapterTitle":"Spor Anatomisi ve Kinesiyoloji II","number":28,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ kası gövdeyi bulunduğu tarafa eğer (omurgaya lateral fleksiyon), ayrıca pelvise elevasyon yaptırır.”","options":["Vastus intermedius","Serratus anterior","Quadratus Lumborum","collum scapulae","Gluteus minimus"],"answer":2,"explanation":"Doğru kavram: Quadratus Lumborum. Kitaptaki kaynak ifade: “Quadratus Lumborum kası gövdeyi bulunduğu tarafa eğer (omurgaya lateral fleksiyon), ayrıca pelvise elevasyon yaptırır.”","source":{"pages":[32],"questionPage":null,"answerPage":null,"section":"Spor Anatomisi ve Kinesiyoloji II","evidence":"Quadratus Lumborum kası gövdeyi bulunduğu tarafa eğer (omurgaya lateral fleksiyon), ayrıca pelvise elevasyon yaptırır.","format":"cloze","optionEvidence":[{"pages":[22],"evidence":"Vastus intermedius"},{"pages":[13],"evidence":"Serratus anterior"},{"pages":[32],"evidence":"Quadratus Lumborum"},{"pages":[10],"evidence":"collum scapulae"},{"pages":[19],"evidence":"Gluteus minimus"}],"maskedText":"________ kası gövdeyi bulunduğu tarafa eğer (omurgaya lateral fleksiyon), ayrıca pelvise elevasyon yaptırır."}},{"id":"saglik-ek-029","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":29,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kasın tüm yüzeyini saran fibröz bağ dokusuna ise ________ denir ve bu bağ dokusu dış kısımlara doğru incelerek kas içi doku tabakası ile birleşir ve tendonu oluşturur.”","options":["epimisyum","miyozin","protein","sarkomer","yağ"],"answer":0,"explanation":"Doğru kavram: epimisyum. Kitaptaki kaynak ifade: “Kasın tüm yüzeyini saran fibröz bağ dokusuna ise epimisyum denir ve bu bağ dokusu dış kısımlara doğru incelerek kas içi doku tabakası ile birleşir ve tendonu oluşturur.”","source":{"pages":[39],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Kasın tüm yüzeyini saran fibröz bağ dokusuna ise epimisyum denir ve bu bağ dokusu dış kısımlara doğru incelerek kas içi doku tabakası ile birleşir ve tendonu oluşturur.","format":"cloze","optionEvidence":[{"pages":[39],"evidence":"epimisyum"},{"pages":[46],"evidence":"miyozin"},{"pages":[50],"evidence":"protein"},{"pages":[40],"evidence":"sarkomer"},{"pages":[50],"evidence":"yağ"}],"maskedText":"Kasın tüm yüzeyini saran fibröz bağ dokusuna ise ________ denir ve bu bağ dokusu dış kısımlara doğru incelerek kas içi doku tabakası ile birleşir ve tendonu oluşturur."}},{"id":"saglik-ek-030","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":30,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Lifler bir araya gelerek fasikül adı verilen kas lif demetlerini oluşturur ve fasikülleri çevreleyen bağ dokusuna ise ________ denir.”","options":["glikojen","sarkolemma","glikoz","perimisyum","karbonhidrat"],"answer":3,"explanation":"Doğru kavram: perimisyum. Kitaptaki kaynak ifade: “Lifler bir araya gelerek fasikül adı verilen kas lif demetlerini oluşturur ve fasikülleri çevreleyen bağ dokusuna ise perimisyum denir.”","source":{"pages":[39],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Lifler bir araya gelerek fasikül adı verilen kas lif demetlerini oluşturur ve fasikülleri çevreleyen bağ dokusuna ise perimisyum denir.","format":"cloze","optionEvidence":[{"pages":[50],"evidence":"glikojen"},{"pages":[40],"evidence":"sarkolemma"},{"pages":[49],"evidence":"glikoz"},{"pages":[39],"evidence":"perimisyum"},{"pages":[50],"evidence":"karbonhidrat"}],"maskedText":"Lifler bir araya gelerek fasikül adı verilen kas lif demetlerini oluşturur ve fasikülleri çevreleyen bağ dokusuna ise ________ denir."}},{"id":"saglik-ek-031","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":31,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Miyofilamentlerin (aktin ve ________) kendi boylarında bir değişiklik olmaksızın birbirlerinin üzerinden kayarak kas liflerinin boyunda kısalma veya uzamaya neden olmasına kayan filamentler teorisi denir.”","options":["tespit","miyozin","miyoglobin","protein","miyofibril"],"answer":1,"explanation":"Doğru kavram: miyozin. Kitaptaki kaynak ifade: “Miyofilamentlerin (aktin ve miyozin) kendi boylarında bir değişiklik olmaksızın birbirlerinin üzerinden kayarak kas liflerinin boyunda kısalma veya uzamaya neden olmasına kayan filamentler teorisi denir.”","source":{"pages":[40],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Miyofilamentlerin (aktin ve miyozin) kendi boylarında bir değişiklik olmaksızın birbirlerinin üzerinden kayarak kas liflerinin boyunda kısalma veya uzamaya neden olmasına kayan filamentler teorisi denir.","format":"cloze","optionEvidence":[{"pages":[44],"evidence":"tespit"},{"pages":[40],"evidence":"miyozin"},{"pages":[51],"evidence":"miyoglobin"},{"pages":[50],"evidence":"protein"},{"pages":[40],"evidence":"miyofibril"}],"maskedText":"Miyofilamentlerin (aktin ve ________) kendi boylarında bir değişiklik olmaksızın birbirlerinin üzerinden kayarak kas liflerinin boyunda kısalma veya uzamaya neden olmasına kayan filamentler teorisi denir."}},{"id":"saglik-ek-032","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":32,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kas lifini saran zara ________ denir ve bu ince elastik yapı hücrenin içeriğini, sarkoplazmayı sarar.”","options":["epimisyum","Soleus","glikoz","ATP","sarkolemma"],"answer":4,"explanation":"Doğru kavram: sarkolemma. Kitaptaki kaynak ifade: “Kas lifini saran zara sarkolemma denir ve bu ince elastik yapı hücrenin içeriğini, sarkoplazmayı sarar.”","source":{"pages":[40],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Kas lifini saran zara sarkolemma denir ve bu ince elastik yapı hücrenin içeriğini, sarkoplazmayı sarar.","format":"cloze","optionEvidence":[{"pages":[39],"evidence":"epimisyum"},{"pages":[42],"evidence":"Soleus"},{"pages":[49],"evidence":"glikoz"},{"pages":[49],"evidence":"ATP"},{"pages":[40],"evidence":"sarkolemma"}],"maskedText":"Kas lifini saran zara ________ denir ve bu ince elastik yapı hücrenin içeriğini, sarkoplazmayı sarar."}},{"id":"saglik-ek-033","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":33,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bir motor sinir ve bu sinirin uyardığı liflerin tamamına ________ denir.”","options":["Tip I","ST lifler","motor ünite","laktik asit","aktif ısınma"],"answer":2,"explanation":"Doğru kavram: motor ünite. Kitaptaki kaynak ifade: “Bir motor sinir ve bu sinirin uyardığı liflerin tamamına motor ünite denir.”","source":{"pages":[41],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Bir motor sinir ve bu sinirin uyardığı liflerin tamamına motor ünite denir.","format":"cloze","optionEvidence":[{"pages":[42],"evidence":"Tip I"},{"pages":[42],"evidence":"ST lifler"},{"pages":[41],"evidence":"motor ünite"},{"pages":[50],"evidence":"laktik asit"},{"pages":[46],"evidence":"aktif ısınma"}],"maskedText":"Bir motor sinir ve bu sinirin uyardığı liflerin tamamına ________ denir."}},{"id":"saglik-ek-034","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":34,"kind":"derived","stem":"Kitapta aşağıdaki açıklama hangi kavramla ilişkilendirilir?\n\n“Bir kas lifi ya da motor ünite, uyaranın şiddetinden bağımsız olarak eşik düzeyde ya da onun üzerinde bir uyarı geldiğinde kasılır.”","options":["Hep ya da Hiç Kanunu","egzersiz sonrası fazla oksijen tüketimi","kayan filamentler teorisi","Tip II","FT lifler"],"answer":0,"explanation":"Doğru kavram: Hep ya da Hiç Kanunu. Kitaptaki kaynak ifade: “Hep ya da Hiç Kanunu Bir kas lifi ya da motor ünite, uyaranın şiddetinden bağımsız olarak eşik düzeyde ya da onun üzerinde bir uyarı geldiğinde kasılır.”","source":{"pages":[41],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Hep ya da Hiç Kanunu Bir kas lifi ya da motor ünite, uyaranın şiddetinden bağımsız olarak eşik düzeyde ya da onun üzerinde bir uyarı geldiğinde kasılır.","format":"concept","optionEvidence":[{"pages":[41],"evidence":"Hep ya da Hiç Kanunu"},{"pages":[48],"evidence":"egzersiz sonrası fazla oksijen tüketimi"},{"pages":[40],"evidence":"kayan filamentler teorisi"},{"pages":[53],"evidence":"Tip II"},{"pages":[42],"evidence":"FT lifler"}]}},{"id":"saglik-ek-035","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":35,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Yavaş Kasılan Kas Lifleri (ST) Bu tip lifler ________ sentezi için gerekli olan enerjiyi genel olarak aerobik enerji sistemi yoluyla sağlar.”","options":["miyozin","sarkomer","glikoz","ATP","endomisyum"],"answer":3,"explanation":"Doğru kavram: ATP. Kitaptaki kaynak ifade: “Yavaş Kasılan Kas Lifleri (ST) Bu tip lifler ATP sentezi için gerekli olan enerjiyi genel olarak aerobik enerji sistemi yoluyla sağlar.”","source":{"pages":[42],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Yavaş Kasılan Kas Lifleri (ST) Bu tip lifler ATP sentezi için gerekli olan enerjiyi genel olarak aerobik enerji sistemi yoluyla sağlar.","format":"cloze","optionEvidence":[{"pages":[46],"evidence":"miyozin"},{"pages":[40],"evidence":"sarkomer"},{"pages":[49],"evidence":"glikoz"},{"pages":[42],"evidence":"ATP"},{"pages":[39],"evidence":"endomisyum"}],"maskedText":"Yavaş Kasılan Kas Lifleri (ST) Bu tip lifler ________ sentezi için gerekli olan enerjiyi genel olarak aerobik enerji sistemi yoluyla sağlar."}},{"id":"saglik-ek-036","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":36,"kind":"derived","stem":"Kas hücresinin kasılabilir en küçük ünitesine ne ad verilir?","options":["Sarkolemma","Sarkoplazma","Sarkomer","Miyoglobin","Motor ünite"],"answer":2,"explanation":"Sarkomer, kas hücresinin kasılabilir en küçük ünitesidir. Kas lifini saran zar sarkolemma, hücre içindeki sıvı kısım ise sarkoplazmadır.","source":{"pages":[40],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Sarkomer, hücrenin kasılabilir en küçük ünitesidir.","format":"authored","optionEvidence":[{"pages":[40],"evidence":"Sarkolemma"},{"pages":[40],"evidence":"Sarkoplazma"},{"pages":[39],"evidence":"Sarkomer"},{"pages":[42],"evidence":"Miyoglobin"},{"pages":[41],"evidence":"Motor ünite"}]}},{"id":"saglik-ek-037","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":37,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kısaca her iki tip egzersiz hem Tip I hem de ________ kasları çalıştırır ve yapılan egzersiz tipine göre kas lif tiplerinin oranlarında değil ama kapasitelerinde artış görülür.”","options":["motor ünite","ST lifler","pasif ısınma","laktik asit","Tip II"],"answer":4,"explanation":"Doğru kavram: Tip II. Kitaptaki kaynak ifade: “Kısaca her iki tip egzersiz hem Tip I hem de Tip II kasları çalıştırır ve yapılan egzersiz tipine göre kas lif tiplerinin oranlarında değil ama kapasitelerinde artış görülür.”","source":{"pages":[44],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Kısaca her iki tip egzersiz hem Tip I hem de Tip II kasları çalıştırır ve yapılan egzersiz tipine göre kas lif tiplerinin oranlarında değil ama kapasitelerinde artış görülür.","format":"cloze","optionEvidence":[{"pages":[41],"evidence":"motor ünite"},{"pages":[42],"evidence":"ST lifler"},{"pages":[46],"evidence":"pasif ısınma"},{"pages":[50],"evidence":"laktik asit"},{"pages":[44],"evidence":"Tip II"}],"maskedText":"Kısaca her iki tip egzersiz hem Tip I hem de ________ kasları çalıştırır ve yapılan egzersiz tipine göre kas lif tiplerinin oranlarında değil ama kapasitelerinde artış görülür."}},{"id":"saglik-ek-038","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":38,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu teknikler ________ ve pasif ısınma olarak adlandırılmaktadır.”","options":["laktik asit","oksijen borcu","aktif ısınma","ST lifler","FT lifler"],"answer":2,"explanation":"Doğru kavram: aktif ısınma. Kitaptaki kaynak ifade: “Bu teknikler aktif ısınma ve pasif ısınma olarak adlandırılmaktadır.”","source":{"pages":[45],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Bu teknikler aktif ısınma ve pasif ısınma olarak adlandırılmaktadır.","format":"cloze","optionEvidence":[{"pages":[50],"evidence":"laktik asit"},{"pages":[52],"evidence":"oksijen borcu"},{"pages":[45],"evidence":"aktif ısınma"},{"pages":[42],"evidence":"ST lifler"},{"pages":[42],"evidence":"FT lifler"}],"maskedText":"Bu teknikler ________ ve pasif ısınma olarak adlandırılmaktadır."}},{"id":"saglik-ek-039","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":39,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________, sporcunun çeşitli egzersiz hareketleri ile optimal performans için organizmasının hazırlanma sürecidir.”","options":["Aktif ısınma","FT lifler","Tip I","motor ünite","pasif ısınma"],"answer":0,"explanation":"Doğru kavram: Aktif ısınma. Kitaptaki kaynak ifade: “Aktif ısınma, sporcunun çeşitli egzersiz hareketleri ile optimal performans için organizmasının hazırlanma sürecidir.”","source":{"pages":[45],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Aktif ısınma, sporcunun çeşitli egzersiz hareketleri ile optimal performans için organizmasının hazırlanma sürecidir.","format":"cloze","optionEvidence":[{"pages":[45],"evidence":"Aktif ısınma"},{"pages":[42],"evidence":"FT lifler"},{"pages":[42],"evidence":"Tip I"},{"pages":[41],"evidence":"motor ünite"},{"pages":[46],"evidence":"pasif ısınma"}],"maskedText":"________, sporcunun çeşitli egzersiz hareketleri ile optimal performans için organizmasının hazırlanma sürecidir."}},{"id":"saglik-ek-040","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":40,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Ayrıca ________ ile kısa süreli eforlarda, izometrik kuvvette bir etkisi yokken dinamik kuvvette ise etkisi vardır.”","options":["FT lifler","Tip II","ST lifler","pasif ısınma","Tip I"],"answer":3,"explanation":"Doğru kavram: pasif ısınma. Kitaptaki kaynak ifade: “Ayrıca pasif ısınma ile kısa süreli eforlarda, izometrik kuvvette bir etkisi yokken dinamik kuvvette ise etkisi vardır.”","source":{"pages":[46],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Ayrıca pasif ısınma ile kısa süreli eforlarda, izometrik kuvvette bir etkisi yokken dinamik kuvvette ise etkisi vardır.","format":"cloze","optionEvidence":[{"pages":[42],"evidence":"FT lifler"},{"pages":[53],"evidence":"Tip II"},{"pages":[42],"evidence":"ST lifler"},{"pages":[46],"evidence":"pasif ısınma"},{"pages":[42],"evidence":"Tip I"}],"maskedText":"Ayrıca ________ ile kısa süreli eforlarda, izometrik kuvvette bir etkisi yokken dinamik kuvvette ise etkisi vardır."}},{"id":"saglik-ek-041","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":41,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Herhangi bir egzersiz sonrası organizmanın normal duruma dönme süreci ________ olarak adlandırılmaktadır.”","options":["ATP","toparlanma","miyoglobin","sarkolemma","troponin"],"answer":1,"explanation":"Doğru kavram: toparlanma. Kitaptaki kaynak ifade: “Herhangi bir egzersiz sonrası organizmanın normal duruma dönme süreci toparlanma olarak adlandırılmaktadır.”","source":{"pages":[47],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Herhangi bir egzersiz sonrası organizmanın normal duruma dönme süreci toparlanma olarak adlandırılmaktadır.","format":"cloze","optionEvidence":[{"pages":[49],"evidence":"ATP"},{"pages":[47],"evidence":"toparlanma"},{"pages":[51],"evidence":"miyoglobin"},{"pages":[40],"evidence":"sarkolemma"},{"pages":[41],"evidence":"troponin"}],"maskedText":"Herhangi bir egzersiz sonrası organizmanın normal duruma dönme süreci ________ olarak adlandırılmaktadır."}},{"id":"saglik-ek-042","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":42,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“İstirahat sırasında aynı süre için harcanması gereken oksijen miktarının üzerinde olan, toparlanma sırasında harcanan oksijen miktarına “oksijen borçlanması”, “toparlanma sırasındaki O 2 tüketimi” veya “________ (ESFOT)” denir.”","options":["Hep ya da Hiç Kanunu","kayan filamentler teorisi","Tip II","laktik asit","egzersiz sonrası fazla oksijen tüketimi"],"answer":4,"explanation":"Doğru kavram: egzersiz sonrası fazla oksijen tüketimi. Kitaptaki kaynak ifade: “İstirahat sırasında aynı süre için harcanması gereken oksijen miktarının üzerinde olan, toparlanma sırasında harcanan oksijen miktarına “oksijen borçlanması”, “toparlanma sırasındaki O 2 tüketimi” veya “egzersiz sonrası fazla oksijen tüketimi (ESFOT)” denir.”","source":{"pages":[48],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"İstirahat sırasında aynı süre için harcanması gereken oksijen miktarının üzerinde olan, toparlanma sırasında harcanan oksijen miktarına “oksijen borçlanması”, “toparlanma sırasındaki O 2 tüketimi” veya “egzersiz sonrası fazla oksijen tüketimi (ESFOT)” denir.","format":"cloze","optionEvidence":[{"pages":[41],"evidence":"Hep ya da Hiç Kanunu"},{"pages":[40],"evidence":"kayan filamentler teorisi"},{"pages":[53],"evidence":"Tip II"},{"pages":[50],"evidence":"laktik asit"},{"pages":[48],"evidence":"egzersiz sonrası fazla oksijen tüketimi"}],"maskedText":"İstirahat sırasında aynı süre için harcanması gereken oksijen miktarının üzerinde olan, toparlanma sırasında harcanan oksijen miktarına “oksijen borçlanması”, “toparlanma sırasındaki O 2 tüketimi” veya “________ (ESFOT)” denir."}},{"id":"saglik-ek-043","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":43,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kas Glikojeninin Yenilenmesi Karbonhidratlar kanda ________, karaciğer ve kasta ise glikojen hâlinde depo edilmektedir.”","options":["miyozin","ATP","glikoz","troponin","miyofibril"],"answer":2,"explanation":"Doğru kavram: glikoz. Kitaptaki kaynak ifade: “Kas Glikojeninin Yenilenmesi Karbonhidratlar kanda glikoz, karaciğer ve kasta ise glikojen hâlinde depo edilmektedir.”","source":{"pages":[49],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Kas Glikojeninin Yenilenmesi Karbonhidratlar kanda glikoz, karaciğer ve kasta ise glikojen hâlinde depo edilmektedir.","format":"cloze","optionEvidence":[{"pages":[46],"evidence":"miyozin"},{"pages":[49],"evidence":"ATP"},{"pages":[49],"evidence":"glikoz"},{"pages":[41],"evidence":"troponin"},{"pages":[40],"evidence":"miyofibril"}],"maskedText":"Kas Glikojeninin Yenilenmesi Karbonhidratlar kanda ________, karaciğer ve kasta ise glikojen hâlinde depo edilmektedir."}},{"id":"saglik-ek-044","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":44,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________, anaerobik metabolizma sonucunda ortaya çıkar ve sebebi de glikozun oksijensiz ortamda parçalanmasıdır.”","options":["Laktik asit","Tip I","Tip II","oksijen borcu","aktif ısınma"],"answer":0,"explanation":"Doğru kavram: Laktik asit. Kitaptaki kaynak ifade: “Laktik asit, anaerobik metabolizma sonucunda ortaya çıkar ve sebebi de glikozun oksijensiz ortamda parçalanmasıdır.”","source":{"pages":[50],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Laktik asit, anaerobik metabolizma sonucunda ortaya çıkar ve sebebi de glikozun oksijensiz ortamda parçalanmasıdır.","format":"cloze","optionEvidence":[{"pages":[50],"evidence":"Laktik asit"},{"pages":[42],"evidence":"Tip I"},{"pages":[53],"evidence":"Tip II"},{"pages":[52],"evidence":"oksijen borcu"},{"pages":[46],"evidence":"aktif ısınma"}],"maskedText":"________, anaerobik metabolizma sonucunda ortaya çıkar ve sebebi de glikozun oksijensiz ortamda parçalanmasıdır."}},{"id":"saglik-ek-045","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":45,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Uzun süreli ve yüksek şiddetli egzersizlerin ardından kas ________ depolarının tamamen yenilenmesi için saatler veya günler gerekmektedir.”","options":["miyofibril","epimisyum","ATP","glikojen","miyozin"],"answer":3,"explanation":"Doğru kavram: glikojen. Kitaptaki kaynak ifade: “Uzun süreli ve yüksek şiddetli egzersizlerin ardından kas glikojen depolarının tamamen yenilenmesi için saatler veya günler gerekmektedir.”","source":{"pages":[50],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Uzun süreli ve yüksek şiddetli egzersizlerin ardından kas glikojen depolarının tamamen yenilenmesi için saatler veya günler gerekmektedir.","format":"cloze","optionEvidence":[{"pages":[40],"evidence":"miyofibril"},{"pages":[39],"evidence":"epimisyum"},{"pages":[49],"evidence":"ATP"},{"pages":[50],"evidence":"glikojen"},{"pages":[46],"evidence":"miyozin"}],"maskedText":"Uzun süreli ve yüksek şiddetli egzersizlerin ardından kas ________ depolarının tamamen yenilenmesi için saatler veya günler gerekmektedir."}},{"id":"saglik-ek-046","courseId":"saglik","chapter":2,"chapterTitle":"Spor Fizyolojisi II","number":46,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ ve laktik asitin uzaklaştırılması ilişkisini açıklayın.”","options":["motor ünite","Oksijen borcu","FT lifler","pasif ısınma","ST lifler"],"answer":1,"explanation":"Doğru kavram: Oksijen borcu. Kitaptaki kaynak ifade: “Oksijen borcu ve laktik asitin uzaklaştırılması ilişkisini açıklayın.”","source":{"pages":[52],"questionPage":null,"answerPage":null,"section":"Spor Fizyolojisi II","evidence":"Oksijen borcu ve laktik asitin uzaklaştırılması ilişkisini açıklayın.","format":"cloze","optionEvidence":[{"pages":[41],"evidence":"motor ünite"},{"pages":[52],"evidence":"Oksijen borcu"},{"pages":[42],"evidence":"FT lifler"},{"pages":[46],"evidence":"pasif ısınma"},{"pages":[42],"evidence":"ST lifler"}],"maskedText":"________ ve laktik asitin uzaklaştırılması ilişkisini açıklayın."}},{"id":"saglik-ek-047","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":47,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ Enerjisi: Vücudun işlevlerinin yerine getirilmesi için; fiziksel aktivite olmaksızın, kalp kasının, solunum ve dolaşım sisteminin, enzim ve endokrin sistemin, sindirim sisteminin çalışması için gereken enerji olarak tanımlanabilir.”","options":["laktik asit","glisemik indeks","kramp","toparlanma","Bazal Metabolizma"],"answer":4,"explanation":"Doğru kavram: Bazal Metabolizma. Kitaptaki kaynak ifade: “Bazal Metabolizma Enerjisi: Vücudun işlevlerinin yerine getirilmesi için; fiziksel aktivite olmaksızın, kalp kasının, solunum ve dolaşım sisteminin, enzim ve endokrin sistemin, sindirim sisteminin çalışması için gereken enerji olarak tanımlanabilir.”","source":{"pages":[61],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Bazal Metabolizma Enerjisi: Vücudun işlevlerinin yerine getirilmesi için; fiziksel aktivite olmaksızın, kalp kasının, solunum ve dolaşım sisteminin, enzim ve endokrin sistemin, sindirim sisteminin çalışması için gereken enerji olarak tanımlanabilir.","format":"cloze","optionEvidence":[{"pages":[71],"evidence":"laktik asit"},{"pages":[67],"evidence":"glisemik indeks"},{"pages":[68],"evidence":"kramp"},{"pages":[69],"evidence":"toparlanma"},{"pages":[61],"evidence":"Bazal Metabolizma"}],"maskedText":"________ Enerjisi: Vücudun işlevlerinin yerine getirilmesi için; fiziksel aktivite olmaksızın, kalp kasının, solunum ve dolaşım sisteminin, enzim ve endokrin sistemin, sindirim sisteminin çalışması için gereken enerji olarak tanımlanabilir."}},{"id":"saglik-ek-048","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":48,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ enerjisini hesaplamamız çok önemlidir.”","options":["glisemik indeks","laktik asit","Bazal metabolizma","fruktoz","toparlanma"],"answer":2,"explanation":"Doğru kavram: Bazal metabolizma. Kitaptaki kaynak ifade: “Bazal metabolizma enerjisini hesaplamamız çok önemlidir.”","source":{"pages":[61],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Bazal metabolizma enerjisini hesaplamamız çok önemlidir.","format":"cloze","optionEvidence":[{"pages":[67],"evidence":"glisemik indeks"},{"pages":[71],"evidence":"laktik asit"},{"pages":[61],"evidence":"Bazal metabolizma"},{"pages":[64],"evidence":"fruktoz"},{"pages":[69],"evidence":"toparlanma"}],"maskedText":"________ enerjisini hesaplamamız çok önemlidir."}},{"id":"saglik-ek-049","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":49,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu besin ögeleri ________, protein ve yağdır ve bunlar makro besin ögeleri olarak adlandırılır.”","options":["karbonhidrat","fruktoz","toparlanma","kalsiyum","kafein"],"answer":0,"explanation":"Doğru kavram: karbonhidrat. Kitaptaki kaynak ifade: “Bu besin ögeleri karbonhidrat, protein ve yağdır ve bunlar makro besin ögeleri olarak adlandırılır.”","source":{"pages":[62],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Bu besin ögeleri karbonhidrat, protein ve yağdır ve bunlar makro besin ögeleri olarak adlandırılır.","format":"cloze","optionEvidence":[{"pages":[62],"evidence":"karbonhidrat"},{"pages":[64],"evidence":"fruktoz"},{"pages":[69],"evidence":"toparlanma"},{"pages":[72],"evidence":"kalsiyum"},{"pages":[73],"evidence":"kafein"}],"maskedText":"Bu besin ögeleri ________, protein ve yağdır ve bunlar makro besin ögeleri olarak adlandırılır."}},{"id":"saglik-ek-050","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":50,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Mikro besin ögeleri ise ________ ve minerallerdir.”","options":["toparlanma","glikojen","kramp","vitamin","fruktoz"],"answer":3,"explanation":"Doğru kavram: vitamin. Kitaptaki kaynak ifade: “Mikro besin ögeleri ise vitamin ve minerallerdir.”","source":{"pages":[62],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Mikro besin ögeleri ise vitamin ve minerallerdir.","format":"cloze","optionEvidence":[{"pages":[69],"evidence":"toparlanma"},{"pages":[70],"evidence":"glikojen"},{"pages":[68],"evidence":"kramp"},{"pages":[62],"evidence":"vitamin"},{"pages":[64],"evidence":"fruktoz"}],"maskedText":"Mikro besin ögeleri ise ________ ve minerallerdir."}},{"id":"saglik-ek-051","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":51,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Karbonhidratların kana karışma hızını kontrol edebilir vee antrenman yüklemelerinden sonra hızlıca yerine konmasını sağlayabiliriz. 50 g karbonhidratın kana karışma hızına ________ denir.”","options":["bazal metabolizma","glisemik indeks","laktik asit","kramp","sodyum"],"answer":1,"explanation":"Doğru kavram: glisemik indeks. Kitaptaki kaynak ifade: “Karbonhidratların kana karışma hızını kontrol edebilir vee antrenman yüklemelerinden sonra hızlıca yerine konmasını sağlayabiliriz. 50 g karbonhidratın kana karışma hızına glisemik indeks denir.”","source":{"pages":[64],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Karbonhidratların kana karışma hızını kontrol edebilir vee antrenman yüklemelerinden sonra hızlıca yerine konmasını sağlayabiliriz. 50 g karbonhidratın kana karışma hızına glisemik indeks denir.","format":"cloze","optionEvidence":[{"pages":[62],"evidence":"bazal metabolizma"},{"pages":[64],"evidence":"glisemik indeks"},{"pages":[71],"evidence":"laktik asit"},{"pages":[68],"evidence":"kramp"},{"pages":[72],"evidence":"sodyum"}],"maskedText":"Karbonhidratların kana karışma hızını kontrol edebilir vee antrenman yüklemelerinden sonra hızlıca yerine konmasını sağlayabiliriz. 50 g karbonhidratın kana karışma hızına ________ denir."}},{"id":"saglik-ek-052","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":52,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ şeker hastalarının az salınan ya da çok salınan insülin hormonunun kontrolü için kullanılmaktadır.”","options":["laktik asit","bazal metabolizma","karbonhidrat","yağ","Glisemik indeks"],"answer":4,"explanation":"Doğru kavram: Glisemik indeks. Kitaptaki kaynak ifade: “Glisemik indeks şeker hastalarının az salınan ya da çok salınan insülin hormonunun kontrolü için kullanılmaktadır.”","source":{"pages":[64],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Glisemik indeks şeker hastalarının az salınan ya da çok salınan insülin hormonunun kontrolü için kullanılmaktadır.","format":"cloze","optionEvidence":[{"pages":[71],"evidence":"laktik asit"},{"pages":[62],"evidence":"bazal metabolizma"},{"pages":[73],"evidence":"karbonhidrat"},{"pages":[68],"evidence":"yağ"},{"pages":[64],"evidence":"Glisemik indeks"}],"maskedText":"________ şeker hastalarının az salınan ya da çok salınan insülin hormonunun kontrolü için kullanılmaktadır."}},{"id":"saglik-ek-053","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":53,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Yani ________ yönünden zengin beslenmek değil, antrene olmuş kasın tekrardan kendi işlevini ve daha iyi olma hâlini gerçekleştirmesi sonucu kas gelişimi oluşur.”","options":["glikojen","aminoasit","protein","yağ","vitamin"],"answer":2,"explanation":"Doğru kavram: protein. Kitaptaki kaynak ifade: “Yani protein yönünden zengin beslenmek değil, antrene olmuş kasın tekrardan kendi işlevini ve daha iyi olma hâlini gerçekleştirmesi sonucu kas gelişimi oluşur.”","source":{"pages":[66],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Yani protein yönünden zengin beslenmek değil, antrene olmuş kasın tekrardan kendi işlevini ve daha iyi olma hâlini gerçekleştirmesi sonucu kas gelişimi oluşur.","format":"cloze","optionEvidence":[{"pages":[70],"evidence":"glikojen"},{"pages":[66],"evidence":"aminoasit"},{"pages":[66],"evidence":"protein"},{"pages":[68],"evidence":"yağ"},{"pages":[62],"evidence":"vitamin"}],"maskedText":"Yani ________ yönünden zengin beslenmek değil, antrene olmuş kasın tekrardan kendi işlevini ve daha iyi olma hâlini gerçekleştirmesi sonucu kas gelişimi oluşur."}},{"id":"saglik-ek-054","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":54,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Gereksiz 8 ________, vücut tarafından yapılamaz, bu yüzden dışarıdan alınmalıdır.”","options":["amino asit","kalsiyum","fruktoz","protein","glikojen"],"answer":0,"explanation":"Doğru kavram: amino asit. Kitaptaki kaynak ifade: “Gereksiz 8 amino asit, vücut tarafından yapılamaz, bu yüzden dışarıdan alınmalıdır.”","source":{"pages":[66],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Gereksiz 8 amino asit, vücut tarafından yapılamaz, bu yüzden dışarıdan alınmalıdır.","format":"cloze","optionEvidence":[{"pages":[66],"evidence":"amino asit"},{"pages":[72],"evidence":"kalsiyum"},{"pages":[64],"evidence":"fruktoz"},{"pages":[68],"evidence":"protein"},{"pages":[70],"evidence":"glikojen"}],"maskedText":"Gereksiz 8 ________, vücut tarafından yapılamaz, bu yüzden dışarıdan alınmalıdır."}},{"id":"saglik-ek-055","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":55,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Ayrıca sindirim sistemi çiğneme ve yutma, yemek borusuna yiyeceklerin ulaşması; sindirim, alınan gıdaların küçük emilebilir moleküllere kadar enzimler aracılığı ile parçalanması, mide, ince bağırsakların çalışması; emilim, emilebilir hale gelmiş moleküllerin (karbonhidrat, yağ, protein, ________ ve vitaminlerin) kan ve lenf sıvısına geçişi ve ince bağırsakların Glisemik indeks ne demektir?”","options":["kalsiyum","aminoasit","toparlanma","mineral","kramp"],"answer":3,"explanation":"Doğru kavram: mineral. Kitaptaki kaynak ifade: “Ayrıca sindirim sistemi çiğneme ve yutma, yemek borusuna yiyeceklerin ulaşması; sindirim, alınan gıdaların küçük emilebilir moleküllere kadar enzimler aracılığı ile parçalanması, mide, ince bağırsakların çalışması; emilim, emilebilir hale gelmiş moleküllerin (karbonhidrat, yağ, protein, mineral ve vitaminlerin) kan ve lenf sıvısına geçişi ve ince bağırsakların Glisemik indeks ne demektir?”","source":{"pages":[67],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Ayrıca sindirim sistemi çiğneme ve yutma, yemek borusuna yiyeceklerin ulaşması; sindirim, alınan gıdaların küçük emilebilir moleküllere kadar enzimler aracılığı ile parçalanması, mide, ince bağırsakların çalışması; emilim, emilebilir hale gelmiş moleküllerin (karbonhidrat, yağ, protein, mineral ve vitaminlerin) kan ve lenf sıvısına geçişi ve ince bağırsakların Glisemik indeks ne demektir?","format":"cloze","optionEvidence":[{"pages":[72],"evidence":"kalsiyum"},{"pages":[66],"evidence":"aminoasit"},{"pages":[69],"evidence":"toparlanma"},{"pages":[67],"evidence":"mineral"},{"pages":[68],"evidence":"kramp"}],"maskedText":"Ayrıca sindirim sistemi çiğneme ve yutma, yemek borusuna yiyeceklerin ulaşması; sindirim, alınan gıdaların küçük emilebilir moleküllere kadar enzimler aracılığı ile parçalanması, mide, ince bağırsakların çalışması; emilim, emilebilir hale gelmiş moleküllerin (karbonhidrat, yağ, protein, ________ ve vitaminlerin) kan ve lenf sıvısına geçişi ve ince bağırsakların Glisemik indeks ne demektir?"}},{"id":"saglik-ek-056","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":56,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Egzersiz sırasında alınacak sıvı %4-8 ________ (glikoz, s ükroz, maltodekstrin), sodyum (0.5-0.7g/L) içermelidir.”","options":["mineral","karbonhidrat","toparlanma","kalsiyum","ATP"],"answer":1,"explanation":"Doğru kavram: karbonhidrat. Kitaptaki kaynak ifade: “Egzersiz sırasında alınacak sıvı %4-8 karbonhidrat (glikoz, s ükroz, maltodekstrin), sodyum (0.5-0.7g/L) içermelidir.”","source":{"pages":[69],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Egzersiz sırasında alınacak sıvı %4-8 karbonhidrat (glikoz, s ükroz, maltodekstrin), sodyum (0.5-0.7g/L) içermelidir.","format":"cloze","optionEvidence":[{"pages":[67],"evidence":"mineral"},{"pages":[69],"evidence":"karbonhidrat"},{"pages":[69],"evidence":"toparlanma"},{"pages":[72],"evidence":"kalsiyum"},{"pages":[64],"evidence":"ATP"}],"maskedText":"Egzersiz sırasında alınacak sıvı %4-8 ________ (glikoz, s ükroz, maltodekstrin), sodyum (0.5-0.7g/L) içermelidir."}},{"id":"saglik-ek-057","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":57,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Antrenman ve müsabaka sonrası ________ için ilk 30 dk içinde yüksek glisemik indeksli/basit karbonhidratlı, sonraki 2 saat içinde düşük ve orta glisemik indeksli/bile şik karbonhidratlarlı beslenmek önemlidir.”","options":["kramp","vitamin","protein","aminoasit","toparlanma"],"answer":4,"explanation":"Doğru kavram: toparlanma. Kitaptaki kaynak ifade: “Antrenman ve müsabaka sonrası toparlanma için ilk 30 dk içinde yüksek glisemik indeksli/basit karbonhidratlı, sonraki 2 saat içinde düşük ve orta glisemik indeksli/bile şik karbonhidratlarlı beslenmek önemlidir.”","source":{"pages":[70],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Antrenman ve müsabaka sonrası toparlanma için ilk 30 dk içinde yüksek glisemik indeksli/basit karbonhidratlı, sonraki 2 saat içinde düşük ve orta glisemik indeksli/bile şik karbonhidratlarlı beslenmek önemlidir.","format":"cloze","optionEvidence":[{"pages":[68],"evidence":"kramp"},{"pages":[62],"evidence":"vitamin"},{"pages":[68],"evidence":"protein"},{"pages":[66],"evidence":"aminoasit"},{"pages":[70],"evidence":"toparlanma"}],"maskedText":"Antrenman ve müsabaka sonrası ________ için ilk 30 dk içinde yüksek glisemik indeksli/basit karbonhidratlı, sonraki 2 saat içinde düşük ve orta glisemik indeksli/bile şik karbonhidratlarlı beslenmek önemlidir."}},{"id":"saglik-ek-058","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":58,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Terleme ile sodyum ve ________ kayıpları çok yüksektir.”","options":["ATP","yağ","potasyum","karbonhidrat","mineral"],"answer":2,"explanation":"Doğru kavram: potasyum. Kitaptaki kaynak ifade: “Terleme ile sodyum ve potasyum kayıpları çok yüksektir.”","source":{"pages":[70],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Terleme ile sodyum ve potasyum kayıpları çok yüksektir.","format":"cloze","optionEvidence":[{"pages":[64],"evidence":"ATP"},{"pages":[68],"evidence":"yağ"},{"pages":[70],"evidence":"potasyum"},{"pages":[73],"evidence":"karbonhidrat"},{"pages":[67],"evidence":"mineral"}],"maskedText":"Terleme ile sodyum ve ________ kayıpları çok yüksektir."}},{"id":"saglik-ek-059","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":59,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Dehidratasyon vücutta akut ve kronik olarak kendini gösterir. *Akut dehidratasyon: Kısa süreli su kaybına bağlı bulantı, kusma, ________, bitkinlik hâlidir ve su kaybının yerine konması ile giderilebilir. *Kronik dehidratasyon: Dokulardaki su açığının yerine konulamaması ile oluşur.”","options":["kramp","protein","karbonhidrat","vitamin","kalsiyum"],"answer":0,"explanation":"Doğru kavram: kramp. Kitaptaki kaynak ifade: “Dehidratasyon vücutta akut ve kronik olarak kendini gösterir. *Akut dehidratasyon: Kısa süreli su kaybına bağlı bulantı, kusma, kramp, bitkinlik hâlidir ve su kaybının yerine konması ile giderilebilir. *Kronik dehidratasyon: Dokulardaki su açığının yerine konulamaması ile oluşur.”","source":{"pages":[71],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Dehidratasyon vücutta akut ve kronik olarak kendini gösterir. *Akut dehidratasyon: Kısa süreli su kaybına bağlı bulantı, kusma, kramp, bitkinlik hâlidir ve su kaybının yerine konması ile giderilebilir. *Kronik dehidratasyon: Dokulardaki su açığının yerine konulamaması ile oluşur.","format":"cloze","optionEvidence":[{"pages":[71],"evidence":"kramp"},{"pages":[68],"evidence":"protein"},{"pages":[73],"evidence":"karbonhidrat"},{"pages":[62],"evidence":"vitamin"},{"pages":[72],"evidence":"kalsiyum"}],"maskedText":"Dehidratasyon vücutta akut ve kronik olarak kendini gösterir. *Akut dehidratasyon: Kısa süreli su kaybına bağlı bulantı, kusma, ________, bitkinlik hâlidir ve su kaybının yerine konması ile giderilebilir. *Kronik dehidratasyon: Dokulardaki su açığının yerine konulamaması ile oluşur."}},{"id":"saglik-ek-060","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":60,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Glikoz yerine ________ verildiğinde ise miktarı yüksek geldiğinde (%12 ve üzerinde) mide-bağırsak bozuklukları, kusma, ishal görülebilmekte ve performans bozulmaktadır.”","options":["yağ","kalsiyum","aminoasit","fruktoz","ATP"],"answer":3,"explanation":"Doğru kavram: fruktoz. Kitaptaki kaynak ifade: “Glikoz yerine fruktoz verildiğinde ise miktarı yüksek geldiğinde (%12 ve üzerinde) mide-bağırsak bozuklukları, kusma, ishal görülebilmekte ve performans bozulmaktadır.”","source":{"pages":[72],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Glikoz yerine fruktoz verildiğinde ise miktarı yüksek geldiğinde (%12 ve üzerinde) mide-bağırsak bozuklukları, kusma, ishal görülebilmekte ve performans bozulmaktadır.","format":"cloze","optionEvidence":[{"pages":[68],"evidence":"yağ"},{"pages":[72],"evidence":"kalsiyum"},{"pages":[66],"evidence":"aminoasit"},{"pages":[72],"evidence":"fruktoz"},{"pages":[64],"evidence":"ATP"}],"maskedText":"Glikoz yerine ________ verildiğinde ise miktarı yüksek geldiğinde (%12 ve üzerinde) mide-bağırsak bozuklukları, kusma, ishal görülebilmekte ve performans bozulmaktadır."}},{"id":"saglik-ek-061","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":61,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________-potasyum dengesini iyi korumak gereklidir.”","options":["kramp","Sodyum","kalsiyum","fruktoz","yağ"],"answer":1,"explanation":"Doğru kavram: Sodyum. Kitaptaki kaynak ifade: “Sodyum-potasyum dengesini iyi korumak gereklidir.”","source":{"pages":[72],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Sodyum-potasyum dengesini iyi korumak gereklidir.","format":"cloze","optionEvidence":[{"pages":[68],"evidence":"kramp"},{"pages":[72],"evidence":"Sodyum"},{"pages":[72],"evidence":"kalsiyum"},{"pages":[64],"evidence":"fruktoz"},{"pages":[68],"evidence":"yağ"}],"maskedText":"________-potasyum dengesini iyi korumak gereklidir."}},{"id":"saglik-ek-062","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":62,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Sporcu içeceklerinde elektrolit olarak genellikle Na (sodyum), Ca (________) ve Mg (magnezyum) bulunmaktadır.”","options":["glikojen","kramp","aminoasit","protein","kalsiyum"],"answer":4,"explanation":"Doğru kavram: kalsiyum. Kitaptaki kaynak ifade: “Sporcu içeceklerinde elektrolit olarak genellikle Na (sodyum), Ca (kalsiyum) ve Mg (magnezyum) bulunmaktadır.”","source":{"pages":[72],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Sporcu içeceklerinde elektrolit olarak genellikle Na (sodyum), Ca (kalsiyum) ve Mg (magnezyum) bulunmaktadır.","format":"cloze","optionEvidence":[{"pages":[70],"evidence":"glikojen"},{"pages":[68],"evidence":"kramp"},{"pages":[66],"evidence":"aminoasit"},{"pages":[68],"evidence":"protein"},{"pages":[72],"evidence":"kalsiyum"}],"maskedText":"Sporcu içeceklerinde elektrolit olarak genellikle Na (sodyum), Ca (________) ve Mg (magnezyum) bulunmaktadır."}},{"id":"saglik-ek-063","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":63,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Erkeklerdeki ________ oranı, kadınlara göre daha düşüktür.”","options":["toparlanma","mineral","yağ","glikojen","glikoz"],"answer":2,"explanation":"Doğru kavram: yağ. Kitaptaki kaynak ifade: “Erkeklerdeki yağ oranı, kadınlara göre daha düşüktür.”","source":{"pages":[73],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Erkeklerdeki yağ oranı, kadınlara göre daha düşüktür.","format":"cloze","optionEvidence":[{"pages":[69],"evidence":"toparlanma"},{"pages":[67],"evidence":"mineral"},{"pages":[73],"evidence":"yağ"},{"pages":[70],"evidence":"glikojen"},{"pages":[68],"evidence":"glikoz"}],"maskedText":"Erkeklerdeki ________ oranı, kadınlara göre daha düşüktür."}},{"id":"saglik-ek-064","courseId":"saglik","chapter":3,"chapterTitle":"Sporda Beslenme II","number":64,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Karbonhidrat miktarı az olanların ise ________ miktarı daha çoktur.”","options":["kafein","vitamin","fruktoz","protein","glikojen"],"answer":0,"explanation":"Doğru kavram: kafein. Kitaptaki kaynak ifade: “Karbonhidrat miktarı az olanların ise kafein miktarı daha çoktur.”","source":{"pages":[73],"questionPage":null,"answerPage":null,"section":"Sporda Beslenme II","evidence":"Karbonhidrat miktarı az olanların ise kafein miktarı daha çoktur.","format":"cloze","optionEvidence":[{"pages":[73],"evidence":"kafein"},{"pages":[62],"evidence":"vitamin"},{"pages":[64],"evidence":"fruktoz"},{"pages":[68],"evidence":"protein"},{"pages":[70],"evidence":"glikojen"}],"maskedText":"Karbonhidrat miktarı az olanların ise ________ miktarı daha çoktur."}},{"id":"saglik-ek-065","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":65,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________, enerjinin tekrarlayan dışa vurumu ile ilişkilidir ve genellikle aerobik sporlarda ve belirli bir tekniğin sıklıkla tekrarlandığı spor dallarında görülmektedir.”","options":["kan şekeri düşmesi","sıcak çarpması","Tibialis posterior","Aşırı kullanım yaralanmaları","ilk yardım"],"answer":3,"explanation":"Doğru kavram: Aşırı kullanım yaralanmaları. Kitaptaki kaynak ifade: “Aşırı kullanım yaralanmaları, enerjinin tekrarlayan dışa vurumu ile ilişkilidir ve genellikle aerobik sporlarda ve belirli bir tekniğin sıklıkla tekrarlandığı spor dallarında görülmektedir.”","source":{"pages":[83],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Aşırı kullanım yaralanmaları, enerjinin tekrarlayan dışa vurumu ile ilişkilidir ve genellikle aerobik sporlarda ve belirli bir tekniğin sıklıkla tekrarlandığı spor dallarında görülmektedir.","format":"cloze","optionEvidence":[{"pages":[106],"evidence":"kan şekeri düşmesi"},{"pages":[107],"evidence":"sıcak çarpması"},{"pages":[97],"evidence":"Tibialis posterior"},{"pages":[83],"evidence":"Aşırı kullanım yaralanmaları"},{"pages":[101],"evidence":"ilk yardım"}],"maskedText":"________, enerjinin tekrarlayan dışa vurumu ile ilişkilidir ve genellikle aerobik sporlarda ve belirli bir tekniğin sıklıkla tekrarlandığı spor dallarında görülmektedir."}},{"id":"saglik-ek-066","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":66,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kemiğin dış bir darbeye maruz kalması, örneğin ________ üzerine tekme almak, doğrudan olarak ifade edilirken yerde sabit olan ayağın üzerine dönme kuvvetinin verilmesiyle oluşan kırıklar ise dolaylı olarak tanımlanmaktadır.”","options":["hematom","tibia","Sartorius","Femur","pronasyon"],"answer":1,"explanation":"Doğru kavram: tibia. Kitaptaki kaynak ifade: “Kemiğin dış bir darbeye maruz kalması, örneğin tibia üzerine tekme almak, doğrudan olarak ifade edilirken yerde sabit olan ayağın üzerine dönme kuvvetinin verilmesiyle oluşan kırıklar ise dolaylı olarak tanımlanmaktadır.”","source":{"pages":[85],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Kemiğin dış bir darbeye maruz kalması, örneğin tibia üzerine tekme almak, doğrudan olarak ifade edilirken yerde sabit olan ayağın üzerine dönme kuvvetinin verilmesiyle oluşan kırıklar ise dolaylı olarak tanımlanmaktadır.","format":"cloze","optionEvidence":[{"pages":[107],"evidence":"hematom"},{"pages":[85],"evidence":"tibia"},{"pages":[96],"evidence":"Sartorius"},{"pages":[102],"evidence":"Femur"},{"pages":[94],"evidence":"pronasyon"}],"maskedText":"Kemiğin dış bir darbeye maruz kalması, örneğin ________ üzerine tekme almak, doğrudan olarak ifade edilirken yerde sabit olan ayağın üzerine dönme kuvvetinin verilmesiyle oluşan kırıklar ise dolaylı olarak tanımlanmaktadır."}},{"id":"saglik-ek-067","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":67,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Çocukların kısa süreli, yoğun aktiviteler sırasında ________-fosfat + ATP sisteminin kullanımına verdikleri yanıtlar da yetişkinlerden farksızdır.”","options":["fleksiyon","Tibia","tespit","mineral","kreatin"],"answer":4,"explanation":"Doğru kavram: kreatin. Kitaptaki kaynak ifade: “Çocukların kısa süreli, yoğun aktiviteler sırasında kreatin-fosfat + ATP sisteminin kullanımına verdikleri yanıtlar da yetişkinlerden farksızdır.”","source":{"pages":[87],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Çocukların kısa süreli, yoğun aktiviteler sırasında kreatin-fosfat + ATP sisteminin kullanımına verdikleri yanıtlar da yetişkinlerden farksızdır.","format":"cloze","optionEvidence":[{"pages":[94],"evidence":"fleksiyon"},{"pages":[102],"evidence":"Tibia"},{"pages":[102],"evidence":"tespit"},{"pages":[101],"evidence":"mineral"},{"pages":[87],"evidence":"kreatin"}],"maskedText":"Çocukların kısa süreli, yoğun aktiviteler sırasında ________-fosfat + ATP sisteminin kullanımına verdikleri yanıtlar da yetişkinlerden farksızdır."}},{"id":"saglik-ek-068","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":68,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu durumda diz kapağı alt ucu ile ________ arasında bağlantı kuran patellar tendon bölgesinde hareket ile hassasiyet hissedilir.”","options":["mineral","yağ","tibia","burkulma","kontüzyon"],"answer":2,"explanation":"Doğru kavram: tibia. Kitaptaki kaynak ifade: “Bu durumda diz kapağı alt ucu ile tibia arasında bağlantı kuran patellar tendon bölgesinde hareket ile hassasiyet hissedilir.”","source":{"pages":[88],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Bu durumda diz kapağı alt ucu ile tibia arasında bağlantı kuran patellar tendon bölgesinde hareket ile hassasiyet hissedilir.","format":"cloze","optionEvidence":[{"pages":[101],"evidence":"mineral"},{"pages":[87],"evidence":"yağ"},{"pages":[88],"evidence":"tibia"},{"pages":[95],"evidence":"burkulma"},{"pages":[90],"evidence":"kontüzyon"}],"maskedText":"Bu durumda diz kapağı alt ucu ile ________ arasında bağlantı kuran patellar tendon bölgesinde hareket ile hassasiyet hissedilir."}},{"id":"saglik-ek-069","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":69,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Spor, boyun bölgesi ve ________ yaralanmalarının en büyük dördüncü, omurilik yaralanmalarının ise en büyük ikinci sebebidir.”","options":["omurga","yağ","burkulma","fleksiyon","hematom"],"answer":0,"explanation":"Doğru kavram: omurga. Kitaptaki kaynak ifade: “Spor, boyun bölgesi ve omurga yaralanmalarının en büyük dördüncü, omurilik yaralanmalarının ise en büyük ikinci sebebidir.”","source":{"pages":[91],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Spor, boyun bölgesi ve omurga yaralanmalarının en büyük dördüncü, omurilik yaralanmalarının ise en büyük ikinci sebebidir.","format":"cloze","optionEvidence":[{"pages":[91],"evidence":"omurga"},{"pages":[87],"evidence":"yağ"},{"pages":[95],"evidence":"burkulma"},{"pages":[94],"evidence":"fleksiyon"},{"pages":[107],"evidence":"hematom"}],"maskedText":"Spor, boyun bölgesi ve ________ yaralanmalarının en büyük dördüncü, omurilik yaralanmalarının ise en büyük ikinci sebebidir."}},{"id":"saglik-ek-070","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":70,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ bölgesinde görülen ağrı en belirgin uyarandır.”","options":["pronasyon","kontüzyon","hematom","Kırık","omurga"],"answer":3,"explanation":"Doğru kavram: Kırık. Kitaptaki kaynak ifade: “Kırık bölgesinde görülen ağrı en belirgin uyarandır.”","source":{"pages":[92],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Kırık bölgesinde görülen ağrı en belirgin uyarandır.","format":"cloze","optionEvidence":[{"pages":[94],"evidence":"pronasyon"},{"pages":[90],"evidence":"kontüzyon"},{"pages":[107],"evidence":"hematom"},{"pages":[92],"evidence":"Kırık"},{"pages":[108],"evidence":"omurga"}],"maskedText":"________ bölgesinde görülen ağrı en belirgin uyarandır."}},{"id":"saglik-ek-071","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":71,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Alt ekstremitede sık görülen spor yaralanmaları; ________, kasık, kalça, uyluk, diz, bacak, ayak bileği ve ayak yaralanmaları olarak ele alınmaktadır.”","options":["toparlanma","pelvis","glikojen","Femur","yağ"],"answer":1,"explanation":"Doğru kavram: pelvis. Kitaptaki kaynak ifade: “Alt ekstremitede sık görülen spor yaralanmaları; pelvis, kasık, kalça, uyluk, diz, bacak, ayak bileği ve ayak yaralanmaları olarak ele alınmaktadır.”","source":{"pages":[93],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Alt ekstremitede sık görülen spor yaralanmaları; pelvis, kasık, kalça, uyluk, diz, bacak, ayak bileği ve ayak yaralanmaları olarak ele alınmaktadır.","format":"cloze","optionEvidence":[{"pages":[100],"evidence":"toparlanma"},{"pages":[93],"evidence":"pelvis"},{"pages":[87],"evidence":"glikojen"},{"pages":[102],"evidence":"Femur"},{"pages":[87],"evidence":"yağ"}],"maskedText":"Alt ekstremitede sık görülen spor yaralanmaları; ________, kasık, kalça, uyluk, diz, bacak, ayak bileği ve ayak yaralanmaları olarak ele alınmaktadır."}},{"id":"saglik-ek-072","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":72,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu bölgede sık görülen ________; klavikula kırıkları, akromiyoklavikular eklem yaralanması, ön omuz çıkığıdır.”","options":["Tibialis posterior","sıcak çarpması","üçgen bandaj","Tip I","akut yaralanmalar"],"answer":4,"explanation":"Doğru kavram: akut yaralanmalar. Kitaptaki kaynak ifade: “Bu bölgede sık görülen akut yaralanmalar; klavikula kırıkları, akromiyoklavikular eklem yaralanması, ön omuz çıkığıdır.”","source":{"pages":[94],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Bu bölgede sık görülen akut yaralanmalar; klavikula kırıkları, akromiyoklavikular eklem yaralanması, ön omuz çıkığıdır.","format":"cloze","optionEvidence":[{"pages":[97],"evidence":"Tibialis posterior"},{"pages":[107],"evidence":"sıcak çarpması"},{"pages":[103],"evidence":"üçgen bandaj"},{"pages":[83],"evidence":"Tip I"},{"pages":[94],"evidence":"akut yaralanmalar"}],"maskedText":"Bu bölgede sık görülen ________; klavikula kırıkları, akromiyoklavikular eklem yaralanması, ön omuz çıkığıdır."}},{"id":"saglik-ek-073","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":73,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Spor yaralanmaları bu bölgede genellikle ________ veya kas gerilmesi, bazen de kırık, çıkık, tendon ve ligament yaralanması şeklinde oluşmaktadır.”","options":["glikojen","Femur","burkulma","glikoz","toparlanma"],"answer":2,"explanation":"Doğru kavram: burkulma. Kitaptaki kaynak ifade: “Spor yaralanmaları bu bölgede genellikle burkulma veya kas gerilmesi, bazen de kırık, çıkık, tendon ve ligament yaralanması şeklinde oluşmaktadır.”","source":{"pages":[95],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Spor yaralanmaları bu bölgede genellikle burkulma veya kas gerilmesi, bazen de kırık, çıkık, tendon ve ligament yaralanması şeklinde oluşmaktadır.","format":"cloze","optionEvidence":[{"pages":[87],"evidence":"glikojen"},{"pages":[102],"evidence":"Femur"},{"pages":[95],"evidence":"burkulma"},{"pages":[106],"evidence":"glikoz"},{"pages":[100],"evidence":"toparlanma"}],"maskedText":"Spor yaralanmaları bu bölgede genellikle ________ veya kas gerilmesi, bazen de kırık, çıkık, tendon ve ligament yaralanması şeklinde oluşmaktadır."}},{"id":"saglik-ek-074","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":74,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bunların dışında kalça bölgesinde yaralanma olduğunda grasilis, ________, gluteal vb. kaslarda da yırtık oluşabilmektedir.”","options":["sartorius","Patella","mineral","yağ","kontüzyon"],"answer":0,"explanation":"Doğru kavram: sartorius. Kitaptaki kaynak ifade: “Bunların dışında kalça bölgesinde yaralanma olduğunda grasilis, sartorius, gluteal vb. kaslarda da yırtık oluşabilmektedir.”","source":{"pages":[96],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Bunların dışında kalça bölgesinde yaralanma olduğunda grasilis, sartorius, gluteal vb. kaslarda da yırtık oluşabilmektedir.","format":"cloze","optionEvidence":[{"pages":[96],"evidence":"sartorius"},{"pages":[97],"evidence":"Patella"},{"pages":[101],"evidence":"mineral"},{"pages":[87],"evidence":"yağ"},{"pages":[90],"evidence":"kontüzyon"}],"maskedText":"Bunların dışında kalça bölgesinde yaralanma olduğunda grasilis, ________, gluteal vb. kaslarda da yırtık oluşabilmektedir."}},{"id":"saglik-ek-075","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":75,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ çıkıkları; güçlü bir quadriseps kasılmasına eşlik eden tibia dış rotasyonu veya dize alınan direkt darbe sonucunda görülmektedir.”","options":["kontüzyon","kreatin","pronasyon","Patella","glikojen"],"answer":3,"explanation":"Doğru kavram: Patella. Kitaptaki kaynak ifade: “Patella çıkıkları; güçlü bir quadriseps kasılmasına eşlik eden tibia dış rotasyonu veya dize alınan direkt darbe sonucunda görülmektedir.”","source":{"pages":[97],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Patella çıkıkları; güçlü bir quadriseps kasılmasına eşlik eden tibia dış rotasyonu veya dize alınan direkt darbe sonucunda görülmektedir.","format":"cloze","optionEvidence":[{"pages":[90],"evidence":"kontüzyon"},{"pages":[87],"evidence":"kreatin"},{"pages":[94],"evidence":"pronasyon"},{"pages":[97],"evidence":"Patella"},{"pages":[87],"evidence":"glikojen"}],"maskedText":"________ çıkıkları; güçlü bir quadriseps kasılmasına eşlik eden tibia dış rotasyonu veya dize alınan direkt darbe sonucunda görülmektedir."}},{"id":"saglik-ek-076","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":76,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Özellikle de aşırı ________ ve/veya kavus ayak deformitesi navikular kemikte stres kırığı oluşumunun sebepleridir.”","options":["mineral","pronasyon","Patella","glikoz","glikojen"],"answer":1,"explanation":"Doğru kavram: pronasyon. Kitaptaki kaynak ifade: “Özellikle de aşırı pronasyon ve/veya kavus ayak deformitesi navikular kemikte stres kırığı oluşumunun sebepleridir.”","source":{"pages":[98],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Özellikle de aşırı pronasyon ve/veya kavus ayak deformitesi navikular kemikte stres kırığı oluşumunun sebepleridir.","format":"cloze","optionEvidence":[{"pages":[101],"evidence":"mineral"},{"pages":[98],"evidence":"pronasyon"},{"pages":[97],"evidence":"Patella"},{"pages":[106],"evidence":"glikoz"},{"pages":[87],"evidence":"glikojen"}],"maskedText":"Özellikle de aşırı ________ ve/veya kavus ayak deformitesi navikular kemikte stres kırığı oluşumunun sebepleridir."}},{"id":"saglik-ek-077","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":77,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Çünkü ________ kırık bölgenin aşağı yukarı hareketlerini engellerken şerit de kırık bölgenin öne hareketini engelleyecektir.”","options":["ilk yardım","akut yaralanmalar","Tibialis posterior","Tip I","üçgen bandaj"],"answer":4,"explanation":"Doğru kavram: üçgen bandaj. Kitaptaki kaynak ifade: “Çünkü üçgen bandaj kırık bölgenin aşağı yukarı hareketlerini engellerken şerit de kırık bölgenin öne hareketini engelleyecektir.”","source":{"pages":[102],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Çünkü üçgen bandaj kırık bölgenin aşağı yukarı hareketlerini engellerken şerit de kırık bölgenin öne hareketini engelleyecektir.","format":"cloze","optionEvidence":[{"pages":[101],"evidence":"ilk yardım"},{"pages":[97],"evidence":"akut yaralanmalar"},{"pages":[97],"evidence":"Tibialis posterior"},{"pages":[83],"evidence":"Tip I"},{"pages":[102],"evidence":"üçgen bandaj"}],"maskedText":"Çünkü ________ kırık bölgenin aşağı yukarı hareketlerini engellerken şerit de kırık bölgenin öne hareketini engelleyecektir."}},{"id":"saglik-ek-078","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":78,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Femur (Uyluk) Kemiği Kırıklarında ________ Diğer kırıklardan istisnai olarak femur kırıklarında kırık kemik, sağlam kemiğin yanına getirebilmek için hareket ettirilir.”","options":["Pelvis","hematom","Tespit","burkulma","kreatin"],"answer":2,"explanation":"Doğru kavram: Tespit. Kitaptaki kaynak ifade: “Femur (Uyluk) Kemiği Kırıklarında Tespit Diğer kırıklardan istisnai olarak femur kırıklarında kırık kemik, sağlam kemiğin yanına getirebilmek için hareket ettirilir.”","source":{"pages":[103],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Femur (Uyluk) Kemiği Kırıklarında Tespit Diğer kırıklardan istisnai olarak femur kırıklarında kırık kemik, sağlam kemiğin yanına getirebilmek için hareket ettirilir.","format":"cloze","optionEvidence":[{"pages":[92],"evidence":"Pelvis"},{"pages":[107],"evidence":"hematom"},{"pages":[103],"evidence":"Tespit"},{"pages":[95],"evidence":"burkulma"},{"pages":[87],"evidence":"kreatin"}],"maskedText":"Femur (Uyluk) Kemiği Kırıklarında ________ Diğer kırıklardan istisnai olarak femur kırıklarında kırık kemik, sağlam kemiğin yanına getirebilmek için hareket ettirilir."}},{"id":"saglik-ek-079","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":79,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Tibia (Kaval) Kırıklarında Tespit ________ kırığı tespitindeki gibi yaralı bacağın sağlam olanla aynı hizaya getirilmesi gerekir.”","options":["Femur","çıkık","toparlanma","hematom","glikojen"],"answer":0,"explanation":"Doğru kavram: Femur. Kitaptaki kaynak ifade: “Tibia (Kaval) Kırıklarında Tespit Femur kırığı tespitindeki gibi yaralı bacağın sağlam olanla aynı hizaya getirilmesi gerekir.”","source":{"pages":[104],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Tibia (Kaval) Kırıklarında Tespit Femur kırığı tespitindeki gibi yaralı bacağın sağlam olanla aynı hizaya getirilmesi gerekir.","format":"cloze","optionEvidence":[{"pages":[104],"evidence":"Femur"},{"pages":[95],"evidence":"çıkık"},{"pages":[100],"evidence":"toparlanma"},{"pages":[107],"evidence":"hematom"},{"pages":[87],"evidence":"glikojen"}],"maskedText":"Tibia (Kaval) Kırıklarında Tespit ________ kırığı tespitindeki gibi yaralı bacağın sağlam olanla aynı hizaya getirilmesi gerekir."}},{"id":"saglik-ek-080","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":80,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Kan Şekeri Düşmesi Vücutta ________ eksikliği olarak tanımlanır.”","options":["Patella","Tibia","kırık","glikoz","çıkık"],"answer":3,"explanation":"Doğru kavram: glikoz. Kitaptaki kaynak ifade: “Kan Şekeri Düşmesi Vücutta glikoz eksikliği olarak tanımlanır.”","source":{"pages":[106],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Kan Şekeri Düşmesi Vücutta glikoz eksikliği olarak tanımlanır.","format":"cloze","optionEvidence":[{"pages":[97],"evidence":"Patella"},{"pages":[102],"evidence":"Tibia"},{"pages":[101],"evidence":"kırık"},{"pages":[106],"evidence":"glikoz"},{"pages":[95],"evidence":"çıkık"}],"maskedText":"Kan Şekeri Düşmesi Vücutta ________ eksikliği olarak tanımlanır."}},{"id":"saglik-ek-081","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":81,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ konusunda da en iyi ilk yardım, önlem almaktır.”","options":["Tip I","Sıcak çarpması","Tibialis posterior","üçgen bandaj","akut yaralanmalar"],"answer":1,"explanation":"Doğru kavram: Sıcak çarpması. Kitaptaki kaynak ifade: “Sıcak çarpması konusunda da en iyi ilk yardım, önlem almaktır.”","source":{"pages":[107],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Sıcak çarpması konusunda da en iyi ilk yardım, önlem almaktır.","format":"cloze","optionEvidence":[{"pages":[83],"evidence":"Tip I"},{"pages":[107],"evidence":"Sıcak çarpması"},{"pages":[97],"evidence":"Tibialis posterior"},{"pages":[103],"evidence":"üçgen bandaj"},{"pages":[97],"evidence":"akut yaralanmalar"}],"maskedText":"________ konusunda da en iyi ilk yardım, önlem almaktır."}},{"id":"saglik-ek-082","courseId":"saglik","chapter":4,"chapterTitle":"Sporcu Sağlığı ve İlk Yardım II","number":82,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Antrenör olarak kendi spor branşınızda ________ yapmanızı gerektiren hangi durumlarla karşılaştığınızı açıklayın.”","options":["üçgen bandaj","akut yaralanmalar","Tip I","Tibialis posterior","ilk yardım"],"answer":4,"explanation":"Doğru kavram: ilk yardım. Kitaptaki kaynak ifade: “Antrenör olarak kendi spor branşınızda ilk yardım yapmanızı gerektiren hangi durumlarla karşılaştığınızı açıklayın.”","source":{"pages":[108],"questionPage":null,"answerPage":null,"section":"Sporcu Sağlığı ve İlk Yardım II","evidence":"Antrenör olarak kendi spor branşınızda ilk yardım yapmanızı gerektiren hangi durumlarla karşılaştığınızı açıklayın.","format":"cloze","optionEvidence":[{"pages":[103],"evidence":"üçgen bandaj"},{"pages":[97],"evidence":"akut yaralanmalar"},{"pages":[83],"evidence":"Tip I"},{"pages":[97],"evidence":"Tibialis posterior"},{"pages":[108],"evidence":"ilk yardım"}],"maskedText":"Antrenör olarak kendi spor branşınızda ________ yapmanızı gerektiren hangi durumlarla karşılaştığınızı açıklayın."}},{"id":"saglik-ek-083","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":83,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ hem sporcunun sağlığına hem de sporun bütünlüğüne yönelik, olumsuz etkileri olması gerekçeleriyle yasaklanmıştır.”","options":["tespit","WADA","Doping","B örneği","Uluslararası Standartlar"],"answer":2,"explanation":"Doğru kavram: Doping. Kitaptaki kaynak ifade: “Doping hem sporcunun sağlığına hem de sporun bütünlüğüne yönelik, olumsuz etkileri olması gerekçeleriyle yasaklanmıştır.”","source":{"pages":[117],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"Doping hem sporcunun sağlığına hem de sporun bütünlüğüne yönelik, olumsuz etkileri olması gerekçeleriyle yasaklanmıştır.","format":"cloze","optionEvidence":[{"pages":[122],"evidence":"tespit"},{"pages":[125],"evidence":"WADA"},{"pages":[117],"evidence":"Doping"},{"pages":[125],"evidence":"B örneği"},{"pages":[119],"evidence":"Uluslararası Standartlar"}],"maskedText":"________ hem sporcunun sağlığına hem de sporun bütünlüğüne yönelik, olumsuz etkileri olması gerekçeleriyle yasaklanmıştır."}},{"id":"saglik-ek-084","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":84,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Ancak Dünya Dopingle Mücadele Ajansının (________) tanımlamasına göre Dünya Dopingle Mücadele Kuralları’nın 2. maddesindeki bir veya birden fazla dopingle mücadele kuralının ihlal edilmesi doping olarak kabul edilir.”","options":["WADA","tespit","kan örneği","A örneği","B örneği"],"answer":0,"explanation":"Doğru kavram: WADA. Kitaptaki kaynak ifade: “Ancak Dünya Dopingle Mücadele Ajansının (WADA) tanımlamasına göre Dünya Dopingle Mücadele Kuralları’nın 2. maddesindeki bir veya birden fazla dopingle mücadele kuralının ihlal edilmesi doping olarak kabul edilir.”","source":{"pages":[117],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"Ancak Dünya Dopingle Mücadele Ajansının (WADA) tanımlamasına göre Dünya Dopingle Mücadele Kuralları’nın 2. maddesindeki bir veya birden fazla dopingle mücadele kuralının ihlal edilmesi doping olarak kabul edilir.","format":"cloze","optionEvidence":[{"pages":[117],"evidence":"WADA"},{"pages":[122],"evidence":"tespit"},{"pages":[125],"evidence":"kan örneği"},{"pages":[124],"evidence":"A örneği"},{"pages":[125],"evidence":"B örneği"}],"maskedText":"Ancak Dünya Dopingle Mücadele Ajansının (________) tanımlamasına göre Dünya Dopingle Mücadele Kuralları’nın 2. maddesindeki bir veya birden fazla dopingle mücadele kuralının ihlal edilmesi doping olarak kabul edilir."}},{"id":"saglik-ek-085","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":85,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Bu, ________ veya eşlikçisinin idrarın çıkış yerini doğrudan gözlemleyebilmesi için gerekli bir işlemdir. 6.”","options":["A örneği","Tedavi Amaçlı Kullanım İstisnası","Yasaklılar Listesi","doping kontrol görevlisi","Ulusal Dopingle Mücadele Kuruluşları"],"answer":3,"explanation":"Doğru kavram: doping kontrol görevlisi. Kitaptaki kaynak ifade: “Bu, doping kontrol görevlisi veya eşlikçisinin idrarın çıkış yerini doğrudan gözlemleyebilmesi için gerekli bir işlemdir. 6.”","source":{"pages":[124],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"Bu, doping kontrol görevlisi veya eşlikçisinin idrarın çıkış yerini doğrudan gözlemleyebilmesi için gerekli bir işlemdir. 6.","format":"cloze","optionEvidence":[{"pages":[124],"evidence":"A örneği"},{"pages":[127],"evidence":"Tedavi Amaçlı Kullanım İstisnası"},{"pages":[119],"evidence":"Yasaklılar Listesi"},{"pages":[124],"evidence":"doping kontrol görevlisi"},{"pages":[117],"evidence":"Ulusal Dopingle Mücadele Kuruluşları"}],"maskedText":"Bu, ________ veya eşlikçisinin idrarın çıkış yerini doğrudan gözlemleyebilmesi için gerekli bir işlemdir. 6."}},{"id":"saglik-ek-086","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":86,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________ ise ileride gerekli görülmesi durumunda aykırı analitik bulgunun teyidi için güvenli bir şekilde saklanır.”","options":["kan örneği","B örneği","Uluslararası Standartlar","Yasaklılar Listesi","A örneği"],"answer":1,"explanation":"Doğru kavram: B örneği. Kitaptaki kaynak ifade: “B örneği ise ileride gerekli görülmesi durumunda aykırı analitik bulgunun teyidi için güvenli bir şekilde saklanır.”","source":{"pages":[124],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"B örneği ise ileride gerekli görülmesi durumunda aykırı analitik bulgunun teyidi için güvenli bir şekilde saklanır.","format":"cloze","optionEvidence":[{"pages":[125],"evidence":"kan örneği"},{"pages":[124],"evidence":"B örneği"},{"pages":[119],"evidence":"Uluslararası Standartlar"},{"pages":[119],"evidence":"Yasaklılar Listesi"},{"pages":[124],"evidence":"A örneği"}],"maskedText":"________ ise ileride gerekli görülmesi durumunda aykırı analitik bulgunun teyidi için güvenli bir şekilde saklanır."}},{"id":"saglik-ek-087","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":87,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Laboratuvarda öncelikle ________ analiz edilir ve B örneği gerekli görüldüğü takdirde analiz edilmek üzere güvenli bir ortamda saklanır.”","options":["Yasaklılar Listesi","Uluslararası Standartlar","kan örneği","WADA","A örneği"],"answer":4,"explanation":"Doğru kavram: A örneği. Kitaptaki kaynak ifade: “Laboratuvarda öncelikle A örneği analiz edilir ve B örneği gerekli görüldüğü takdirde analiz edilmek üzere güvenli bir ortamda saklanır.”","source":{"pages":[125],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"Laboratuvarda öncelikle A örneği analiz edilir ve B örneği gerekli görüldüğü takdirde analiz edilmek üzere güvenli bir ortamda saklanır.","format":"cloze","optionEvidence":[{"pages":[119],"evidence":"Yasaklılar Listesi"},{"pages":[119],"evidence":"Uluslararası Standartlar"},{"pages":[125],"evidence":"kan örneği"},{"pages":[125],"evidence":"WADA"},{"pages":[125],"evidence":"A örneği"}],"maskedText":"Laboratuvarda öncelikle ________ analiz edilir ve B örneği gerekli görüldüğü takdirde analiz edilmek üzere güvenli bir ortamda saklanır."}},{"id":"saglik-ek-088","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":88,"kind":"derived","stem":"Kitapta aşağıdaki açıklama hangi kavramla ilişkilendirilir?\n\n“Alım İşlemi Bildirim, kimlik tespiti yapılması, sporcuya eşlik edilmesi ve işlemin anlatılması gibi, idrar örnek alımı için geçerli koşulların aynısı kan örnek alımı için de geçerlidir.”","options":["A örneği","Uluslararası Standartlar","kan örneği","Yasaklılar Listesi","B örneği"],"answer":2,"explanation":"Doğru kavram: kan örneği. Kitaptaki kaynak ifade: “Kan Örneği Alım İşlemi Bildirim, kimlik tespiti yapılması, sporcuya eşlik edilmesi ve işlemin anlatılması gibi, idrar örnek alımı için geçerli koşulların aynısı kan örnek alımı için de geçerlidir.”","source":{"pages":[125],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"Kan Örneği Alım İşlemi Bildirim, kimlik tespiti yapılması, sporcuya eşlik edilmesi ve işlemin anlatılması gibi, idrar örnek alımı için geçerli koşulların aynısı kan örnek alımı için de geçerlidir.","format":"concept","optionEvidence":[{"pages":[124],"evidence":"A örneği"},{"pages":[119],"evidence":"Uluslararası Standartlar"},{"pages":[125],"evidence":"kan örneği"},{"pages":[119],"evidence":"Yasaklılar Listesi"},{"pages":[125],"evidence":"B örneği"}]}},{"id":"saglik-ek-089","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":89,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“Uluslararası ve ulusal düzeydeki sporcuların aynı zamanda kurallarla ilgili önemli bir noktayı anlamaları gerekir: acil veya istisnai durumlar dışında, ________ (TAKİ) onayı almak için geriye dönük değil önceden başvuruda bulunmak gerekir.”","options":["Tedavi Amaçlı Kullanım İstisnası","Dünya Dopingle Mücadele Ajansı","Ulusal Dopingle Mücadele Kuruluşları","doping kontrol görevlisi","Uluslararası Standartlar"],"answer":0,"explanation":"Doğru kavram: Tedavi Amaçlı Kullanım İstisnası. Kitaptaki kaynak ifade: “Uluslararası ve ulusal düzeydeki sporcuların aynı zamanda kurallarla ilgili önemli bir noktayı anlamaları gerekir: acil veya istisnai durumlar dışında, Tedavi Amaçlı Kullanım İstisnası (TAKİ) onayı almak için geriye dönük değil önceden başvuruda bulunmak gerekir.”","source":{"pages":[127],"questionPage":null,"answerPage":null,"section":"Dopingle Mücadele II","evidence":"Uluslararası ve ulusal düzeydeki sporcuların aynı zamanda kurallarla ilgili önemli bir noktayı anlamaları gerekir: acil veya istisnai durumlar dışında, Tedavi Amaçlı Kullanım İstisnası (TAKİ) onayı almak için geriye dönük değil önceden başvuruda bulunmak gerekir.","format":"cloze","optionEvidence":[{"pages":[127],"evidence":"Tedavi Amaçlı Kullanım İstisnası"},{"pages":[118],"evidence":"Dünya Dopingle Mücadele Ajansı"},{"pages":[117],"evidence":"Ulusal Dopingle Mücadele Kuruluşları"},{"pages":[124],"evidence":"doping kontrol görevlisi"},{"pages":[119],"evidence":"Uluslararası Standartlar"}],"maskedText":"Uluslararası ve ulusal düzeydeki sporcuların aynı zamanda kurallarla ilgili önemli bir noktayı anlamaları gerekir: acil veya istisnai durumlar dışında, ________ (TAKİ) onayı almak için geriye dönük değil önceden başvuruda bulunmak gerekir."}},{"id":"saglik-ek-090","courseId":"saglik","chapter":5,"chapterTitle":"Dopingle Mücadele II","number":90,"kind":"derived","stem":"Kitaptaki aşağıdaki bilgiyi doğru tamamlayan kavram hangisidir?\n\n“________’nde bulunan madde ve yöntemlerin sporcular tarafından kullanımı kesinlikle yasaktır.”","options":["A örneği","Uluslararası Standartlar","B örneği","Yasaklılar Listesi","kan örneği"],"answer":3,"explanation":"Doğru kavram: Yasaklılar Listesi. Kitaptaki kaynak ifade: