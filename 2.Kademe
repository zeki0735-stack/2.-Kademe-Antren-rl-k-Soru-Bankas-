@font-face{font-family:Atelier;src:local("Avenir Next"),local("Avenir"),local("Segoe UI");font-display:swap}
:root{--ink:#203638;--muted:#667575;--paper:#f5f4ed;--white:#fffefa;--line:#dedfd4;--green:#163b3e;--orange:#eeab71;--teal:#287766;--red:#b13d51;--radius:20px;--shadow:0 12px 38px #19343608;font-family:Atelier,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none}
*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}button,a{-webkit-tap-highlight-color:transparent}button{color:inherit}button:disabled{cursor:not-allowed;opacity:.48}a{color:inherit}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #aa652b;outline-offset:4px}svg{display:inline-block;width:22px;height:22px;flex:none;vertical-align:middle}h1,h2,h3,p{margin:0}h1{font-size:36px;letter-spacing:-1.2px;line-height:1.2;font-weight:650}h2{font-size:21px;letter-spacing:-.4px;font-weight:650}h3{font-size:17px;font-weight:650}p{line-height:1.65}.muted{color:var(--muted)}.small{font-size:13px}.eyebrow{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:750}.skip{position:fixed;top:-80px;left:20px;background:var(--ink);color:white;z-index:100;padding:14px;border-radius:8px}.skip:focus{top:8px}
.app-shell{display:grid;grid-template-columns:238px minmax(0,1fr);min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;padding:34px 20px 24px 26px;border-right:1px solid var(--line);display:flex;flex-direction:column;background:#f1f1e8;z-index:10}.brand{display:flex;align-items:center;gap:12px;text-decoration:none}.brand-mark{display:flex;align-items:center;justify-content:center;font:700 37px Georgia,serif;letter-spacing:-3px;background:var(--green);color:#faf7eb;width:48px;height:48px;border-radius:15px;padding-right:3px;flex:none}.brand-mark span{color:var(--orange);font:700 23px Georgia,serif;align-self:flex-start;margin-top:7px}.brand-name{font-size:20px;font-weight:800;letter-spacing:-.8px}.brand-name small{display:block;font-size:10px;font-weight:600;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase;margin-top:3px}.nav-caption{margin:48px 12px 14px;color:#81908c;font-size:10px;font-weight:750;letter-spacing:1.7px}.nav{display:flex;flex-direction:column;gap:7px}.nav a{display:flex;align-items:center;gap:13px;padding:14px 15px;text-decoration:none;border-radius:10px;font-size:14px;color:#65736f;font-weight:550;min-height:48px}.nav a:hover{background:#e8eade}.nav a.active{background:#e0e5d5;color:#203c34}.nav a.active svg{stroke-width:2}.nav-count{font-size:11px;margin-left:auto;min-width:23px;padding:3px;border-radius:5px;text-align:center;background:#ffffff90;color:var(--green)}.sidebar-foot{margin-top:auto;padding-top:40px}.side-note{font-size:13px;line-height:1.65;color:#6d7973;padding:16px 8px 26px;border-bottom:1px solid var(--line)}.profile{display:flex;gap:10px;align-items:center;padding:23px 5px 0;font-size:12px}.profile-icon{background:#e5e7dc;display:grid;place-items:center;width:37px;height:37px;border-radius:50%}.profile small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.dot{display:inline-block;width:6px;height:6px;border-radius:100%;background:#4d8f70;margin-right:5px}.content{min-width:0;padding:29px clamp(24px,3.7vw,64px) 56px;max-width:1650px;width:100%;margin:0 auto}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:42px;font-size:12px;color:#6c7b75;gap:14px}.breadcrumb{display:flex;align-items:center;gap:10px}.breadcrumb svg{width:15px;height:15px}.today{display:flex;gap:9px;align-items:center}.today svg{width:16px;height:16px}.mobile-brand{display:none}.intro{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:27px}.intro p{font-size:14px;color:var(--muted);margin-top:10px}.intro .eyebrow{color:var(--teal);margin-bottom:9px}.pill{display:inline-flex;gap:7px;align-items:center;font-size:11px;background:#e8ecdf;color:#4d6b55;border-radius:50px;padding:8px 12px;white-space:nowrap}.pill svg{width:14px;height:14px}.hero{background:var(--green);color:#fcf9eb;position:relative;overflow:hidden;border-radius:22px;padding:31px 34px;min-height:223px;display:flex;align-items:center}.hero-copy{position:relative;z-index:1;max-width:73%}.hero .eyebrow{color:#b2c6b4;margin-bottom:12px}.hero h2{font-family:Georgia,serif;font-weight:400;font-size:32px;letter-spacing:-.5px;line-height:1.2;margin-bottom:11px}.hero p{font-size:13px;line-height:1.65;color:#bccdc3;max-width:470px;margin-bottom:22px}.hero-art{position:absolute;right:-10px;top:-30px;width:250px;height:350px;transform:rotate(25deg);border:1px solid #a3bda32b;border-radius:135px}.hero-art:before,.hero-art:after{content:"";position:absolute;inset:18px;border:1px solid #a3bda32b;border-radius:125px}.hero-art:after{inset:38px}.hero-number{position:absolute;right:44px;top:41px;font-size:128px;line-height:1;font-weight:200;letter-spacing:-9px;color:#d6e5c51c}.hero .btn{background:var(--orange);color:#283d33;border:none;font-size:13px;padding:12px 17px}.hero .btn:hover{background:#f4bc8b}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid var(--line);border-radius:9px;padding:12px 17px;min-height:45px;background:var(--white);font-size:13px;font-weight:650;text-decoration:none;line-height:1.35}.btn svg{width:17px;height:17px}.btn:hover{background:#e9ede3}.btn.primary{background:var(--green);color:white;border-color:var(--green)}.btn.primary:hover{background:#245156}.btn.ghost{background:transparent}.btn.danger{color:var(--red);border-color:#e6c8ce}.btn.wide{width:100%}.text-btn{border:0;background:none;padding:7px 0;color:#496f60;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:650}.text-btn svg{width:15px;height:15px}.text-btn:hover{text-decoration:underline}.icon-btn{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);background:var(--white);border-radius:9px}.icon-btn.on{color:#996719;background:#fff0d3;border-color:#debc79}.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0 30px}.stat{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:19px 20px;box-shadow:var(--shadow)}.stat-top{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--muted);gap:9px}.stat-top svg{width:17px;height:17px;color:#708d7d}.stat-number{display:block;font-size:29px;line-height:1.2;font-weight:650;letter-spacing:-1px;margin-top:10px}.stat-sub{font-size:10px;color:#879087;margin-top:6px;line-height:1.4}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:22px}.panel{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:24px;min-width:0;box-shadow:var(--shadow)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:21px}.panel-head h2{font-size:18px}.panel-head p{font-size:12px;color:var(--muted);margin-top:6px}.course-list{display:flex;flex-direction:column;gap:12px}.course-row{display:flex;gap:12px;align-items:center;padding-bottom:13px;border-bottom:1px solid #e8e8df}.course-row:last-child{border:none;padding-bottom:0}.course-icon{width:41px;height:43px;border-radius:11px;display:grid;place-items:center;flex:none;background:var(--tint);color:var(--accent)}.course-icon svg{width:21px;height:21px}.course-info{flex:1;min-width:0}.course-info h3{font-size:12px;line-height:1.45;margin-bottom:5px}.course-info p{font-size:10px;color:var(--muted)}.course-row>.icon-btn{width:31px;height:31px;background:transparent;border:none;color:#67806e}.course-row>.icon-btn:hover{background:#ecefe5}.mini-track{height:4px;background:#eceee7;margin-top:8px;border-radius:10px;overflow:hidden}.mini-track span{height:100%;display:block;background:var(--accent);border-radius:10px}.course-percent{font-size:12px;color:var(--muted);margin-left:5px}.chart-empty{min-height:202px;display:flex;align-items:center;justify-content:center;text-align:center;flex-direction:column;border-radius:12px;background:repeating-linear-gradient(to top,transparent,transparent 45px,#eaece5 46px,#eaece5 47px)}.chart-empty svg{width:36px;height:36px;color:#a1b19f;margin-bottom:13px}.chart-empty h3{font-size:14px}.chart-empty p{font-size:12px;margin-top:8px;max-width:250px;color:var(--muted)}.line-chart{width:100%;height:auto;display:block;aspect-ratio:2/1.08}.chart-legend{display:flex;gap:14px;justify-content:flex-end;font-size:10px;color:var(--muted);margin-top:10px}.legend-dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:var(--teal);margin-right:4px}.activity{margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}.activity-top{display:flex;justify-content:space-between;font-size:11px;color:var(--muted)}.activity-days{display:grid;grid-template-columns:repeat(14,1fr);gap:5px;margin-top:12px}.activity-day{height:17px;border-radius:4px;background:#edf0e5}.activity-day.used{background:#61947d}.activity-day.current{outline:1px solid #8ba28b;outline-offset:2px}.bottom-note{display:flex;align-items:center;gap:8px;justify-content:center;font-size:11px;color:#7b8a7e;margin-top:28px;line-height:1.6;text-align:center}.bottom-note svg{width:15px;height:15px}
.resume{border:1px solid #d6b78d;background:#fff0dd;border-radius:13px;padding:17px 21px;display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:20px}.resume strong{font-size:14px}.resume p{font-size:12px;color:#806d51;margin-top:4px}.source-note{border-left:3px solid #a1b48a;padding:12px 16px;background:#edf0e4;border-radius:0 10px 10px 0;font-size:12px;line-height:1.65;color:#546b55;margin-top:22px}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:22px}.test-card{padding:25px;border:1px solid var(--line);border-radius:17px;background:var(--white);display:flex;flex-direction:column;gap:16px}.test-card h2{font-size:18px;line-height:1.45}.test-card p{font-size:13px;color:var(--muted);flex:1}.test-card .course-icon{width:46px;height:46px}.test-card .btn{align-self:start}.test-card .test-card-top{display:flex;align-items:center;justify-content:space-between}.test-card.mixed{background:var(--green);color:white;grid-column:1/-1;flex-direction:row;align-items:center;justify-content:space-between;padding:27px 31px}.test-card.mixed p{color:#bbcec4;max-width:550px;margin-top:8px}.test-card.mixed .btn{background:var(--orange);border-color:var(--orange);color:var(--ink);align-self:center}.test-details{display:flex;gap:14px;color:var(--muted);font-size:11px}.test-details svg{width:14px;height:14px;margin-right:4px}.section-text{font-size:14px;color:var(--muted);line-height:1.8}
.quiz-top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:22px}.quiz-label{font-size:12px;font-weight:600;color:var(--muted)}.quiz-timer{font-variant-numeric:tabular-nums;font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px}.quiz-timer svg{width:16px;height:16px}.quiz-progress{height:5px;background:#e2e5d9;border-radius:10px;margin-bottom:26px;overflow:hidden}.quiz-progress span{display:block;background:#76a588;height:100%;transition:width .2s}.quiz-layout{display:grid;grid-template-columns:minmax(0,1fr) 205px;gap:22px;align-items:start}.question-card{background:var(--white);border:1px solid var(--line);border-radius:20px;padding:30px}.question-meta{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:25px}.question-course{font-size:11px;font-weight:650;display:flex;align-items:center;gap:8px;color:var(--accent);line-height:1.5}.question-course svg{width:17px;height:17px}.question-number{font-size:12px;color:#7b8a7b}.question-stem{font-size:20px;line-height:1.65;font-weight:550;white-space:pre-line;margin-bottom:27px;letter-spacing:-.15px}.options{display:flex;flex-direction:column;gap:10px}.option{border:1px solid #dbdfd4;border-radius:11px;padding:15px 17px;display:flex;gap:14px;align-items:center;text-align:left;background:transparent;width:100%;font-size:14px;line-height:1.6;min-height:59px}.option .letter{flex:none;display:grid;place-items:center;border:1px solid #d7ded1;background:#f3f4ed;border-radius:7px;width:30px;height:30px;font-weight:600;font-size:12px}.option .option-text{flex:1;white-space:pre-line}.option:not(:disabled):hover{background:#eff3e8;border-color:#9eafa0}.option:disabled{opacity:1;cursor:default}.option.correct{background:#ecf5ed;border-color:#85ae91;color:#255e42}.option.correct .letter{color:white;background:#367a57;border-color:#367a57}.option.wrong{background:#fcf0f2;border-color:#d49aa5;color:#913d4d}.option.wrong .letter{color:white;background:#b34e62;border-color:#b34e62}.option .status-icon{width:19px;height:19px}.quiz-aside{position:sticky;top:25px}.question-map{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.question-map button{border:1px solid #d8ded2;border-radius:7px;aspect-ratio:1;background:var(--white);padding:0;font-size:11px;min-width:28px}.question-map button.current{outline:2px solid #536c5c;outline-offset:1px}.question-map button.right{background:#e0eee1;border-color:#afc8ad;color:#326b3d}.question-map button.wrong{background:#f8e3e8;border-color:#dcb2bd;color:#99425b}.quiz-aside h3{font-size:13px;margin-bottom:15px}.quiz-aside .panel{padding:18px;border-radius:15px}.map-legend{font-size:10px;color:var(--muted);line-height:1.7;margin-top:15px}.map-legend span{display:block}.map-legend i{width:7px;height:7px;display:inline-block;border-radius:2px;margin-right:6px}.feedback{margin-top:24px;border-radius:12px;background:#eef4e9;border:1px solid #bfd1b9;padding:22px;outline:none}.feedback.error{background:#fff4e9;border-color:#e9c2a2}.feedback h3{font-size:16px;display:flex;align-items:center;gap:9px;line-height:1.5}.feedback h3 svg{width:21px;height:21px}.feedback p{font-size:14px;line-height:1.8;margin-top:12px}.feedback .correct-answer{font-size:13px;font-weight:650;color:#3f6549;margin-top:10px}.source-link{border:0;background:#ffffff85;padding:11px 13px;border-radius:8px;font-size:11px;display:flex;align-items:center;gap:8px;line-height:1.5;text-align:left;margin-top:18px;color:#56694c}.source-link svg{width:17px;height:17px}.quiz-controls{display:flex;justify-content:space-between;gap:14px;margin-top:24px;align-items:center}.quiz-tip{font-size:11px;color:#82907e;line-height:1.8;margin-top:16px;text-align:center}
.empty{padding:53px 25px;text-align:center;display:flex;flex-direction:column;align-items:center;background:var(--white);border:1px dashed #cbd3c4;border-radius:18px}.empty>svg{width:42px;height:42px;color:#81a38a;margin-bottom:18px}.empty h2{font-size:22px}.empty p{max-width:470px;font-size:14px;color:var(--muted);margin-top:12px;margin-bottom:22px}.filterbar{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin:22px 0}.tabs{display:flex;background:#e7ebdf;padding:4px;border-radius:9px;gap:4px}.tabs button{border:0;background:transparent;padding:9px 14px;border-radius:6px;font-size:12px}.tabs button.selected{background:var(--white);box-shadow:0 1px 5px #00000009}.filterbar select{max-width:100%;border:1px solid var(--line);border-radius:8px;background:var(--white);padding:11px 28px 11px 11px;font-size:12px;color:var(--ink)}.review-list{display:flex;flex-direction:column;gap:12px}.review-item{padding:20px 22px;border:1px solid var(--line);background:var(--white);border-radius:13px;display:flex;gap:16px;align-items:start}.review-item .review-body{flex:1;min-width:0}.review-item h3{font-size:14px;line-height:1.7;white-space:pre-line;margin:7px 0}.review-item p{font-size:11px;color:var(--muted);line-height:1.6}.review-item .actions{margin-top:10px}.history-list{display:flex;flex-direction:column;gap:13px}.history-card{display:flex;align-items:center;gap:20px;padding:22px;background:var(--white);border:1px solid var(--line);border-radius:15px}.history-score{font-size:24px;font-weight:600;background:#edf0e5;color:#427251;border-radius:13px;min-width:63px;height:63px;display:grid;place-items:center}.history-card h3{font-size:15px;margin-bottom:7px}.history-card p{font-size:12px;color:var(--muted)}.history-card>.history-info{flex:1}.history-breakdown{font-size:12px;color:var(--muted);text-align:right;line-height:1.9}.history-breakdown b{color:var(--teal)}.history-breakdown em{color:var(--red);font-style:normal}.result-hero{text-align:center;padding:33px;background:var(--green);border-radius:21px;color:#fffcee}.result-hero .eyebrow{color:#b6cabb;margin-bottom:20px}.score-ring{width:145px;height:145px;border-radius:50%;background:conic-gradient(var(--orange) calc(var(--score)*1%),#ffffff22 0);display:grid;place-items:center;margin:0 auto 23px}.score-ring>div{border-radius:100%;background:var(--green);width:122px;height:122px;display:flex;flex-direction:column;align-items:center;justify-content:center}.score-ring strong{font-size:44px;font-weight:550;letter-spacing:-2px}.score-ring span{font-size:11px;color:#b6cabb}.result-hero h1{font-size:27px}.result-hero p{font-size:13px;color:#bfd1c7;margin-top:12px}.result-stats{display:flex;justify-content:center;gap:36px;margin-top:24px;padding-top:20px;border-top:1px solid #ffffff20;font-size:11px;color:#bccfc4}.result-stats b{display:block;font-size:23px;color:#fff9ed;margin-bottom:5px}.result-actions{display:flex;justify-content:center;gap:12px;margin:24px 0 30px;flex-wrap:wrap}
.source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:24px 0}.source-card{border:1px solid var(--line);border-radius:15px;padding:24px;background:var(--white);min-width:0}.source-card h3{font-size:17px;line-height:1.5;margin:16px 0 10px}.source-card p{font-size:12px;color:var(--muted);line-height:1.8}.source-card .btn{margin-top:17px}.source-card .small{font-size:10px;margin-top:10px;overflow-wrap:anywhere}.source-card .coverage{margin-top:10px;font-size:11px;color:#54734e}.sources-intro{padding:22px 25px;border:1px solid #d6dfcb;background:#ebf0e2;border-radius:15px;line-height:1.8;font-size:13px}.sources-intro b{display:block;margin-bottom:7px;font-size:14px}.exclusions{margin-top:23px;border:1px solid var(--line);border-radius:12px;background:var(--white)}.exclusions summary{padding:19px 22px;cursor:pointer;font-size:14px;font-weight:600}.exclusions ul{padding:0 25px 20px 42px;font-size:12px;line-height:1.8;color:var(--muted);margin:0}.exclusions li+li{margin-top:13px}.backup-panel{margin-top:22px;display:flex;justify-content:space-between;gap:20px;align-items:center;padding:25px;background:var(--white);border:1px solid var(--line);border-radius:15px}.backup-panel p{font-size:12px;color:var(--muted);margin-top:8px;max-width:500px}.backup-panel h2{font-size:18px}.warning-banner{padding:15px 18px;margin:0 0 20px;border:1px solid #d9ad89;border-radius:10px;background:#fff0de;font-size:12px;line-height:1.7;color:#805630}.warning-banner .actions{margin-top:8px}.storage-state{font-size:11px;color:#4b7b59}
dialog{border:1px solid #d2d8cd;padding:30px;border-radius:20px;background:var(--white);color:var(--ink);max-width:600px;width:calc(100% - 32px);max-height:85dvh;overflow:auto;box-shadow:0 25px 100px #142f3a40}dialog::backdrop{background:#133c4255;backdrop-filter:blur(3px)}.dialog-head{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-bottom:17px}.dialog-head h2{font-size:22px;line-height:1.4}.dialog-head .icon-btn{flex:none}dialog p{font-size:13px;color:var(--muted);margin-bottom:15px}dialog .actions{margin-top:23px}dialog blockquote{margin:18px 0;padding:16px 20px;border-left:3px solid #93ac7f;background:#f0f3e7;font-size:13px;line-height:1.9;color:#52684b}dialog .source-pages{font-size:12px;line-height:2;background:#f0f1e8;border-radius:8px;padding:15px;margin:15px 0}.help-list{font-size:13px;line-height:1.9;padding-left:20px}.help-list li{margin-top:9px}#toast{position:fixed;bottom:27px;left:50%;transform:translate(-50%,15px);background:#1a3b37;color:white;padding:13px 21px;border-radius:10px;box-shadow:0 10px 40px #0d342430;z-index:50;font-size:13px;max-width:min(560px,calc(100vw - 32px));line-height:1.6;opacity:0;pointer-events:none;transition:.2s}#toast.show{opacity:1;transform:translate(-50%,0)}.loading{display:flex;flex-direction:column;align-items:center;gap:20px;padding:120px 25px;color:var(--muted)}.loading p{font-size:14px}
@media(min-width:1500px){.content{padding-left:65px;padding-right:65px}.hero{min-height:250px}.hero h2{font-size:37px}}
@media(max-width:1200px){.app-shell{grid-template-columns:204px minmax(0,1fr)}.sidebar{padding:30px 14px}.content{padding:25px 27px 50px}.stats-grid{gap:10px}.stat{padding:16px 15px}.dashboard-grid{gap:16px}.panel{padding:20px}.quiz-layout{grid-template-columns:minmax(0,1fr) 180px}.quiz-aside .panel{padding:13px}.question-card{padding:25px}.hero h2{font-size:29px}.hero-copy{max-width:81%}.hero-number{right:30px}}
@media(max-width:980px){.app-shell{display:block}.sidebar{position:fixed;inset:auto 0 0;height:auto;padding:0;background:#fbfcf4f5;backdrop-filter:blur(15px);border:0;border-top:1px solid #d6dece;z-index:20}.sidebar>.brand,.nav-caption,.sidebar-foot{display:none}.nav{display:grid;grid-template-columns:repeat(5,1fr);gap:0;padding:6px 12px calc(6px + env(safe-area-inset-bottom))}.nav a{min-height:57px;border-radius:9px;padding:7px 3px;display:flex;flex-direction:column;gap:5px;font-size:9px;position:relative}.nav a svg{width:21px;height:21px}.nav a.active{background:#e4ebdc}.nav-count{position:absolute;top:1px;left:calc(50% + 6px);font-size:8px;padding:1px 3px;min-width:15px;background:#eecba8}.content{padding:24px 30px 110px}.topbar{margin-bottom:30px}.mobile-brand{display:flex;align-items:center;gap:9px;font-size:17px;font-weight:750;color:var(--ink)}.mobile-brand .brand-mark{height:32px;width:32px;border-radius:10px;font-size:27px}.mobile-brand .brand-mark span{font-size:15px;margin-top:4px}.breadcrumb{display:none}.sidebar .long-label{display:none}.hero-copy{max-width:75%}.quiz-layout{grid-template-columns:minmax(0,1fr) 180px}#toast{bottom:90px}.topbar .icon-btn{width:34px;height:34px}.quiz-aside{top:20px}.backup-panel{align-items:flex-start;flex-direction:column}}
@media(min-width:981px){.short-label{display:none}}
@media(max-width:700px){.content{padding:19px 19px 105px}.topbar{margin-bottom:29px}.today{font-size:10px}.today svg{display:none}.today .btn{padding:6px;min-height:31px}.intro{gap:12px;align-items:start;margin-bottom:23px}.intro h1{font-size:30px;letter-spacing:-1px}.intro p{font-size:12px;line-height:1.7;max-width:300px}.intro .eyebrow{font-size:9px}.intro>.pill{display:none}.hero{min-height:234px;padding:26px 24px}.hero h2{font-size:29px;max-width:260px}.hero p{font-size:12px;max-width:260px}.hero-copy{max-width:88%}.hero-art{right:-140px}.hero-number{right:8px;top:68px;font-size:100px}.stats-grid{grid-template-columns:repeat(2,1fr);margin:14px 0 24px;gap:11px}.stat{padding:16px 17px}.stat-number{font-size:27px}.stat-sub{font-size:10px}.dashboard-grid{grid-template-columns:1fr;gap:18px}.dashboard-grid>.panel{padding:22px}.course-info h3{font-size:13px}.course-info p{font-size:11px}.course-list{gap:15px}.course-row{padding-bottom:15px}.panel-head h2{font-size:19px}.chart-empty{min-height:190px}.bottom-note{font-size:10px;align-items:start;margin-top:24px}.choice-grid{grid-template-columns:1fr;gap:13px}.test-card{padding:23px;gap:15px}.test-card.mixed{align-items:flex-start;flex-direction:column;padding:25px}.test-card.mixed .btn{align-self:flex-start}.test-card h2{font-size:18px}.quiz-layout{display:flex;flex-direction:column;gap:17px}.quiz-layout>.question-card{width:100%}.quiz-aside{position:static;width:100%}.quiz-aside .panel{padding:20px}.question-map{grid-template-columns:repeat(10,1fr);gap:6px}.question-map button{min-width:20px;font-size:10px}.map-legend{display:flex;gap:13px;flex-wrap:wrap;margin-top:13px}.question-card{padding:23px 19px;border-radius:15px}.question-meta{margin-bottom:19px}.question-stem{font-size:18px;line-height:1.7;margin-bottom:22px}.option{padding:13px 11px;gap:10px;font-size:13px;line-height:1.7}.option .letter{width:26px;height:29px}.quiz-top{gap:8px;margin-bottom:20px}.quiz-label{font-size:11px}.quiz-top .btn{font-size:11px;padding:9px 11px;min-height:38px}.quiz-top .btn svg{width:14px;height:14px}.feedback{padding:18px 16px}.feedback p{font-size:13px}.source-link{font-size:10px;padding:11px}.quiz-controls .btn{padding:11px 13px;font-size:12px}.quiz-tip{font-size:10px}.resume{padding:16px;flex-direction:column;align-items:start;gap:13px}.resume .btn{font-size:12px}.filterbar select{width:100%;max-width:none}.review-item{padding:18px 16px;gap:10px}.review-item>.course-icon{display:none}.history-card{padding:18px 16px;gap:13px;flex-wrap:wrap}.history-score{min-width:53px;height:53px;font-size:22px}.history-card h3{font-size:13px}.history-card p{font-size:10px}.history-breakdown{margin-left:66px;text-align:left;font-size:11px;flex:1}.history-card>.btn{font-size:11px;padding:8px 12px;min-height:36px}.source-grid{grid-template-columns:1fr;gap:14px}.source-card{padding:23px}.sources-intro{padding:19px;font-size:12px}.backup-panel{padding:22px}.result-hero{padding:27px 18px}.result-hero h1{font-size:24px}.result-stats{gap:23px}.result-stats b{font-size:22px}.result-actions{gap:9px}.result-actions .btn{font-size:11px}.source-note{font-size:11px}.tabs{max-width:100%;flex-wrap:wrap}.tabs button{font-size:11px;padding:8px 12px}dialog{padding:23px 20px}dialog .dialog-head h2{font-size:19px}.result-hero p{font-size:12px}.source-pages .btn{margin:5px 0}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;scroll-behavior:auto!important}}
@media print{.sidebar,.topbar,.btn,.icon-btn,.actions,#toast{display:none!important}.app-shell{display:block}.content{padding:0}.panel,.question-card{box-shadow:none;break-inside:avoid}body{background:white}.hero{background:#e3e9dd;color:#132b25}.hero p,.hero .eyebrow{color:#415845}}

const CACHE = "kademe2-v2-600-release-20261021-" + new URL(self.registration.scope).pathname;
const ASSETS = ["./", "./index.html", "./style.css", "./app.js", "./core.js", "./bank.js", "./icon.svg", "./icon-192.png", "./icon-512.png", "./manifest.webmanifest"];
const URLS = new Set(ASSETS.map(p => new URL(p, self.registration.scope).href));
self.addEventListener("install", event => {
  event.waitUntil(caches.open(CACHE).then(cache => cache.addAll(ASSETS)).then(() => self.skipWaiting()));
});
self.addEventListener("activate", event => {
  event.waitUntil(caches.keys().then(keys => Promise.all(keys.filter(k => k.startsWith("kademe2-") && k.endsWith(new URL(self.registration.scope).pathname) && k !== CACHE).map(k => caches.delete(k)))).then(() => self.clients.claim()));
});
self.addEventListener("fetch", event => {
  if (event.request.method !== "GET" || !URLS.has(event.request.url.split("#")[0])) return;
  if (event.request.mode === "navigate") {
    event.respondWith(fetch(event.request).catch(() => caches.match(new URL("./index.html", self.registration.scope).href)));
    return;
  }
  event.respondWith(caches.match(event.request).then(cached => cached || fetch(event.request)));
});
